---
interface Props {
  title: string;
  prompt: string;
  tag?: string;
}

const { title, prompt, tag } = Astro.props;
---

<div class="bg-white border border-slate-200 rounded-xl overflow-hidden mb-6 shadow-sm">
  <div class="flex items-center justify-between px-4 py-3 border-b border-slate-200 bg-slate-50">
    <div class="flex items-center gap-3 min-w-0">
      {tag && <span class="label shrink-0">{tag}</span>}
      <span class="text-slate-700 text-xs font-medium truncate">{title}</span>
    </div>
    <button
      class="copy-btn shrink-0 ml-4 text-slate-400 hover:text-emerald-600 font-mono text-xs transition-colors px-2 py-1 border border-slate-200 rounded hover:border-emerald-300 cursor-pointer bg-white"
      data-prompt={prompt}
    >
      copiar
    </button>
  </div>
  <pre class="p-4 text-slate-600 text-xs leading-relaxed whitespace-pre-wrap font-mono overflow-auto bg-slate-50">{prompt}</pre>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.prompt ?? '';
      await navigator.clipboard.writeText(text);
      const original = btn.textContent;
      btn.textContent = 'copiado ✓';
      btn.classList.add('text-emerald-600');
      setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove('text-emerald-600');
      }, 1500);
    });
  });
</script>
