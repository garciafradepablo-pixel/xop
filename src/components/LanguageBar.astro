---
// Visual-only language indicator. ES active, EN upcoming.
interface Props {
  subtle?: boolean; // smaller/footer variant
}
const { subtle = false } = Astro.props;
---

{subtle ? (
  <div class="flex items-center gap-2.5 flex-wrap">
    <span class="font-mono text-xs font-bold text-emerald-600">ES</span>
    <span class="font-mono text-xs text-slate-400 opacity-50">EN <span class="text-[10px]">próximamente</span></span>
  </div>
) : (
  <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-[11px] text-slate-400">
    <span class="font-medium text-slate-500">ES</span>
    <span class="text-slate-300" aria-hidden="true">·</span>
    <span>EN próximamente</span>
    <span class="hidden sm:inline text-slate-300" aria-hidden="true">·</span>
    <span class="hidden sm:inline">Traducción con sentido, no literal</span>
    <span class="hidden md:inline text-slate-300" aria-hidden="true">·</span>
    <span class="hidden md:inline">Monkey, Moonkey, Keys y Operator Path no se traducen</span>
  </div>
)}
