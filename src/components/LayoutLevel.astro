---
import '../styles/global.css';
import Header from './Header.astro';
import LanguageBar from './LanguageBar.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Escuela modular para aprender a operar IA, automatizaciones y sistemas creativos.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — MOONKEY XN SCHOOL</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen antialiased bg-[#f8fafc] text-slate-900">
    <Header />
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="lg:grid lg:grid-cols-[280px_minmax(0,1fr)] lg:gap-10 xl:gap-12 lg:items-start">
        <!-- Sidebar: desktop sticky -->
        <aside class="hidden lg:block">
          <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto">
            <slot name="sidebar" />
          </div>
        </aside>
        <!-- Main content -->
        <main class="min-w-0">
          <slot />
        </main>
      </div>
    </div>
    <footer class="border-t border-slate-200 bg-white mt-20 py-12">
      <div class="max-w-3xl mx-auto px-6">
        <div class="text-center mb-8">
          <p class="font-mono text-xs tracking-widest text-slate-400 mb-2">MOONKEY XN SCHOOL — MMXXVI</p>
          <p class="text-xs text-slate-400 leading-relaxed">Aprende, desbloquea Keys y convierte IA en sistemas reales de trabajo.</p>
        </div>
        <nav class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-xs font-mono mb-8">
          <a href="/manifiesto" class="text-slate-400 hover:text-emerald-600 transition-colors">Manifiesto</a>
          <a href="/info" class="text-slate-400 hover:text-emerald-600 transition-colors">Info</a>
          <a href="/monkeys" class="text-slate-400 hover:text-emerald-600 transition-colors">Monkeys</a>
          <a href="/planes" class="text-slate-400 hover:text-emerald-600 transition-colors">Planes</a>
          <a href="/soporte" class="text-slate-400 hover:text-emerald-600 transition-colors">Soporte</a>
          <a href="/prueba-operador" class="text-slate-400 hover:text-emerald-600 transition-colors">Test de Operador</a>
          <a href="/glosario" class="text-slate-400 hover:text-emerald-600 transition-colors">Glosario</a>
        </nav>
        <div class="border-t border-slate-100 mb-6"></div>
        <div class="text-center mb-6">
          <p class="font-mono text-[10px] tracking-widest text-slate-300 uppercase mb-2">Ecosistema impulsor</p>
          <p class="text-xs text-slate-400 font-mono">
            <span class="text-slate-500">01 Agency</span>
            <span class="text-slate-300 mx-2">·</span>
            <span class="text-slate-500">XNLab</span>
            <span class="text-slate-300 mx-2">·</span>
            <span class="text-slate-500">Connect</span>
          </p>
        </div>
        <div class="flex justify-center">
          <LanguageBar subtle={true} />
        </div>
      </div>
    </footer>
  </body>
</html>
