---
import '../styles/global.css';
import Header from './Header.astro';
import LanguageBar from './LanguageBar.astro';
import { resolveLocale, localizedPath } from '../i18n/utils';
import { LOCALES } from '../i18n/config';
import { chromeT } from '../i18n/chrome.i18n';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Escuela modular para aprender a operar IA, automatizaciones y sistemas creativos.' } = Astro.props;

const pathname = Astro.url.pathname;
// Use Astro.currentLocale (correct under fallbackType:'rewrite') — pathname-only
// detection returns 'es' for every rewritten /en/... page, which left the footer
// links un-prefixed AND mislabelled <html lang>. resolveLocale fixes both.
const locale = resolveLocale(Astro.currentLocale, pathname);
const c = chromeT(locale);
const alternates = LOCALES.map((l) => ({ code: l, href: localizedPath(pathname, l) }));
const esHref = localizedPath(pathname, 'es');
const canonical = new URL(localizedPath(pathname, locale), Astro.site);
const htmlLang = locale === 'ch' ? 'de-CH' : locale;
---

<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title} — MOONKEY LAB</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.code === 'ch' ? 'de-CH' : a.code} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={esHref} />
  </head>
  <body class="min-h-screen antialiased bg-[#f8fafc] text-slate-900">
    <a href="#main-content" class="skip-link">{locale === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <Header />
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="lg:grid lg:grid-cols-[280px_minmax(0,1fr)] lg:gap-10 xl:gap-12">
        <!-- Sidebar: desktop sticky -->
        <aside class="hidden lg:block">
          <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto">
            <slot name="sidebar" />
          </div>
        </aside>
        <!-- Main content -->
        <main id="main-content" class="min-w-0">
          <slot />
        </main>
      </div>
    </div>
    <footer class="border-t border-slate-200 bg-white mt-20 py-12">
      <div class="max-w-3xl mx-auto px-6">
        <div class="text-center mb-8">
          <p class="font-mono text-xs tracking-widest text-slate-400 mb-2">MOONKEY LAB — MMXXVI</p>
          <p class="text-xs text-slate-400 leading-relaxed">{c.tagline}</p>
        </div>
        <nav class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-xs font-mono mb-8">
          <a href={localizedPath('/manifiesto', locale)} class="text-slate-400 hover:text-emerald-600 transition-colors">{c.manifesto}</a>
          <a href={localizedPath('/info', locale)} class="text-slate-400 hover:text-emerald-600 transition-colors">{c.info}</a>
          <a href={localizedPath('/monkeys', locale)} class="text-slate-400 hover:text-emerald-600 transition-colors">Monkeys</a>
          <a href={localizedPath('/planes', locale)} class="text-slate-400 hover:text-emerald-600 transition-colors">{c.plans}</a>
          <a href={localizedPath('/soporte', locale)} class="text-slate-400 hover:text-emerald-600 transition-colors">{c.support}</a>
          <a href={localizedPath('/prueba-operador', locale)} class="text-slate-400 hover:text-emerald-600 transition-colors">{c.opTest}</a>
          <a href={localizedPath('/glosario', locale)} class="text-slate-400 hover:text-emerald-600 transition-colors">{c.glossary}</a>
          <a href={localizedPath('/cuenta', locale)} class="text-slate-400 hover:text-emerald-600 transition-colors">{c.account}</a>
          <a href={localizedPath('/privacidad', locale)} class="text-slate-400 hover:text-emerald-600 transition-colors">{c.privacy}</a>
        </nav>
        <div class="border-t border-slate-100 mb-6"></div>
        <div class="text-center mb-6">
          <p class="text-xs text-slate-400 font-mono">{c.builtOn}</p>
        </div>
        <div class="flex justify-center">
          <LanguageBar subtle={true} />
        </div>
      </div>
    </footer>
  </body>
</html>
