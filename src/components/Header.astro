---
const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/modulos', label: 'N1' },
  { href: '/advanced', label: 'N2' },
  { href: '/migrador', label: 'N3' },
  { href: '/prompts', label: 'Arsenal' },
  { href: '/monkeys', label: 'Monkeys' },
  { href: '/planes', label: 'Planes' },
];
const currentPath = Astro.url.pathname;
const isRuta = currentPath === '/ruta-7-dias' || currentPath === '/ruta-7-dias/';

const isActive = (href: string) =>
  currentPath === href ||
  (href !== '/' && currentPath.startsWith(href)) ||
  (href === '/modulos' && isRuta);
---
<header class="border-b border-slate-200 bg-white/95 backdrop-blur sticky top-0 z-50">
  <nav aria-label="Navegación principal" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between gap-4">
    <a href="/" class="text-emerald-600 font-mono text-xs tracking-[0.2em] uppercase font-bold shrink-0">
      MOONKEY XN
    </a>
    <ul class="flex flex-wrap gap-x-5 gap-y-1.5 text-xs font-mono">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class={`transition-colors ${
              isActive(link.href)
                ? 'text-slate-900 font-medium'
                : 'text-slate-400 hover:text-slate-700'
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
