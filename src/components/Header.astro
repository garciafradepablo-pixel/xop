---
import MoonkeyLogo from './MoonkeyLogo.astro';

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/modulos', label: 'N1' },
  { href: '/advanced', label: 'N2' },
  { href: '/migrador', label: 'N3' },
  { href: '/prompts', label: 'Arsenal' },
  { href: '/monkeys', label: 'Monkeys' },
  { href: '/planes', label: 'Planes' },
];
const currentPath = Astro.url.pathname;
const isRuta = currentPath === '/ruta-7-dias' || currentPath === '/ruta-7-dias/';

const isActive = (href: string) =>
  currentPath === href ||
  (href !== '/' && currentPath.startsWith(href)) ||
  (href === '/modulos' && isRuta);
---
<header class="border-b border-slate-200 bg-white/95 backdrop-blur sticky top-0 z-50">
  <nav aria-label="Navegación principal" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex items-center gap-3">
    <a href="/" class="shrink-0 flex items-center gap-3">
      <MoonkeyLogo variant="horizontal" size="sm" />
      <span class="w-px h-6 bg-slate-200 shrink-0"></span>
      <div class="flex flex-col leading-none gap-[3px]">
        <span class="font-mono font-bold tracking-[0.12em] uppercase text-[11px] text-slate-900">XNLAB</span>
        <span class="font-mono tracking-widest uppercase text-[9px] text-slate-400">STUDIO</span>
      </div>
    </a>
    <div class="flex-1 min-w-0 overflow-x-auto">
      <div class="flex items-center justify-end gap-3 min-w-max ml-auto">
        <ul class="flex items-center gap-x-4 text-xs font-mono">
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class={`transition-colors ${
                  isActive(link.href)
                    ? 'text-slate-900 font-medium'
                    : 'text-slate-400 hover:text-slate-700'
                }`}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <a
          href="/cuenta"
          aria-current={currentPath === '/cuenta' || currentPath === '/cuenta/' ? 'page' : undefined}
          class={`shrink-0 font-mono text-xs px-2.5 py-1 rounded-lg border transition-colors ${
            currentPath === '/cuenta' || currentPath === '/cuenta/'
              ? 'text-emerald-700 bg-emerald-50 border-emerald-300 font-medium'
              : 'text-slate-500 border-slate-200 hover:border-emerald-300 hover:text-emerald-600'
          }`}
        >
          Cuenta
        </a>
      </div>
    </div>
  </nav>
</header>
