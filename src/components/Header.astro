---
const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/ruta-7-dias', label: 'Ruta 7 días' },
  { href: '/prompts', label: 'Prompts' },
  { href: '/glosario', label: 'Glosario' },
  { href: '/onboarding', label: 'Onboarding' },
  { href: '/prueba-operador', label: 'Prueba' },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-[#141414] bg-[#080808]/95 backdrop-blur sticky top-0 z-50">
  <nav class="max-w-3xl mx-auto px-6 py-4 flex items-center justify-between gap-6 flex-wrap">
    <a href="/" class="text-[#86efac] font-mono text-xs tracking-[0.2em] uppercase font-semibold shrink-0">
      XN OPERATOR
    </a>
    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-xs font-mono">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class={`transition-colors ${
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'text-[#e5e5e5]'
                : 'text-[#525252] hover:text-[#a3a3a3]'
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
