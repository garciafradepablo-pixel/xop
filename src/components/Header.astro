---
const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/ruta-7-dias', label: 'Módulos' },
  { href: '/prompts', label: 'Prompts' },
  { href: '/glosario', label: 'Glosario' },
  { href: '/onboarding', label: 'Onboarding' },
  { href: '/prueba-operador', label: 'Prueba' },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-slate-200 bg-white/95 backdrop-blur sticky top-0 z-50">
  <nav class="max-w-3xl mx-auto px-6 py-4 flex items-center justify-between gap-6 flex-wrap">
    <a href="/" class="text-emerald-600 font-mono text-xs tracking-[0.2em] uppercase font-bold shrink-0">
      XN OPERATOR
    </a>
    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-xs font-mono">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class={`transition-colors ${
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'text-slate-900 font-medium'
                : 'text-slate-400 hover:text-slate-700'
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
