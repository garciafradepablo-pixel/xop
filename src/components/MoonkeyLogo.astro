---
interface Props {
  variant?: 'horizontal' | 'icon' | 'stacked';
  size?: 'sm' | 'md' | 'lg';
  dark?: boolean;
  class?: string;
}

const { variant = 'horizontal', size = 'md', dark = false, class: cls = '' } = Astro.props;

const uid = `mk-${Math.random().toString(36).slice(2, 8)}`;

const accent  = dark ? '#34d399' : '#10b981';
const primary = dark ? '#f1f5f9' : '#0f172a';
const muted   = dark ? '#64748b' : '#94a3b8';

const iconH = { sm: 28, md: 36, lg: 50 }[size];
const iconW = Math.round(iconH * 20 / 30);

const titleCls = { sm: 'text-[11px]', md: 'text-sm', lg: 'text-base' }[size];
---

{variant === 'icon' && (
  <svg
    width={iconW}
    height={iconH}
    viewBox="0 0 20 30"
    xmlns="http://www.w3.org/2000/svg"
    aria-label="MOONKEY LAB"
    class={cls}
  >
    <defs>
      <mask id={uid}>
        <rect width="20" height="20" fill="white" />
        <circle cx="13" cy="6.5" r="6.5" fill="black" />
      </mask>
    </defs>
    <circle cx="9.5" cy="8.5" r="7.5" fill={accent} mask={`url(#${uid})`} />
    <rect x="8.5" y="16" width="2.2" height="11" rx="1.1" fill={accent} />
    <rect x="10.7" y="20" width="4" height="1.8" rx="0.7" fill={accent} />
    <rect x="10.7" y="24" width="3" height="1.8" rx="0.7" fill={accent} />
  </svg>
)}

{variant === 'horizontal' && (
  <div class={`flex items-center gap-2.5 ${cls}`}>
    <svg
      width={iconW}
      height={iconH}
      viewBox="0 0 20 30"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      class="shrink-0"
    >
      <defs>
        <mask id={uid}>
          <rect width="20" height="20" fill="white" />
          <circle cx="13" cy="6.5" r="6.5" fill="black" />
        </mask>
      </defs>
      <circle cx="9.5" cy="8.5" r="7.5" fill={accent} mask={`url(#${uid})`} />
      <rect x="8.5" y="16" width="2.2" height="11" rx="1.1" fill={accent} />
      <rect x="10.7" y="20" width="4" height="1.8" rx="0.7" fill={accent} />
      <rect x="10.7" y="24" width="3" height="1.8" rx="0.7" fill={accent} />
    </svg>
    <div class="flex flex-col leading-none gap-0.5">
      <span class={`font-mono font-bold tracking-[0.12em] uppercase ${titleCls}`} style={`color:${primary}`}>MOONKEY</span>
      <span class="font-mono tracking-widest uppercase text-[9px]" style={`color:${accent}`}>LAB</span>
    </div>
  </div>
)}

{variant === 'stacked' && (
  <div class={`flex flex-col items-center gap-2 ${cls}`}>
    <svg
      width={iconH}
      height={Math.round(iconH * 30/20)}
      viewBox="0 0 20 30"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <defs>
        <mask id={uid}>
          <rect width="20" height="20" fill="white" />
          <circle cx="13" cy="6.5" r="6.5" fill="black" />
        </mask>
      </defs>
      <circle cx="9.5" cy="8.5" r="7.5" fill={accent} mask={`url(#${uid})`} />
      <rect x="8.5" y="16" width="2.2" height="11" rx="1.1" fill={accent} />
      <rect x="10.7" y="20" width="4" height="1.8" rx="0.7" fill={accent} />
      <rect x="10.7" y="24" width="3" height="1.8" rx="0.7" fill={accent} />
    </svg>
    <div class="text-center leading-none">
      <span class={`font-mono font-bold tracking-[0.12em] uppercase block ${titleCls}`} style={`color:${primary}`}>MOONKEY</span>
      <span class="font-mono tracking-widest uppercase block text-[9px] mt-0.5" style={`color:${accent}`}>LAB · MMXXVI</span>
    </div>
  </div>
)}
