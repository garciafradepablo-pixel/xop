---
interface Props {
  objetivo: string;
  resultado: string;
  comoSaberBien: string;
  errorComun?: string;
  antesDeEmpezar?: string;
}

const { objetivo, resultado, comoSaberBien, errorComun, antesDeEmpezar } = Astro.props;
---

<details class="group border border-slate-200 rounded-xl overflow-hidden mt-5">
  <summary class="list-none [&::-webkit-details-marker]:hidden flex items-center justify-between px-5 py-4 cursor-pointer bg-slate-50 hover:bg-slate-100 transition-colors">
    <span class="font-medium text-slate-700 text-sm">Ver ejercicio paso a paso</span>
    <span class="text-slate-400 text-xs group-open:rotate-180 transition-transform duration-200">▼</span>
  </summary>

  <div class="bg-white border-t border-slate-100 px-5 pb-6 pt-5 space-y-5">

    <div>
      <p class="text-xs font-mono text-green-600 uppercase tracking-widest mb-1.5">Objetivo</p>
      <p class="text-sm text-slate-600 leading-relaxed">{objetivo}</p>
    </div>

    {antesDeEmpezar && (
      <div class="bg-amber-50 border border-amber-100 rounded-lg px-4 py-3">
        <p class="text-xs font-mono text-amber-600 uppercase tracking-widest mb-1">Antes de empezar</p>
        <p class="text-sm text-amber-900 leading-relaxed">{antesDeEmpezar}</p>
      </div>
    )}

    <div>
      <p class="text-xs font-mono text-green-600 uppercase tracking-widest mb-3">Pasos</p>
      <slot />
    </div>

    <div class="bg-green-50 border border-green-100 rounded-lg px-4 py-3">
      <p class="text-xs font-mono text-green-700 uppercase tracking-widest mb-1">Resultado esperado</p>
      <p class="text-sm text-green-900 leading-relaxed">{resultado}</p>
    </div>

    {errorComun && (
      <div class="bg-red-50 border border-red-100 rounded-lg px-4 py-3">
        <p class="text-xs font-mono text-red-500 uppercase tracking-widest mb-1">Error común</p>
        <p class="text-sm text-red-800 leading-relaxed">{errorComun}</p>
      </div>
    )}

    <div>
      <p class="text-xs font-mono text-slate-400 uppercase tracking-widest mb-1">Cómo saber que está bien</p>
      <p class="text-sm text-slate-600 leading-relaxed">{comoSaberBien}</p>
    </div>

  </div>
</details>
