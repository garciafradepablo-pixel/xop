---
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  objetivo: string;
  resultado: string;
  comoSaberBien?: string;
  errorComun?: string;
  antesDeEmpezar?: string;
  locale?: Locale;
}

const { objetivo, resultado, comoSaberBien, errorComun, antesDeEmpezar, locale = 'es' } = Astro.props;
const t = useTranslations(locale);
---

<details class="group border border-slate-200 rounded-xl overflow-hidden mt-5">
  <summary class="list-none [&::-webkit-details-marker]:hidden flex items-center justify-between px-5 py-4 cursor-pointer bg-slate-50 hover:bg-slate-100 transition-colors">
    <span class="font-medium text-slate-700 text-sm">{t('exer.toggle')}</span>
    <span class="text-slate-400 text-xs group-open:rotate-180 transition-transform duration-200">▼</span>
  </summary>

  <div class="bg-white border-t border-slate-100 px-5 pb-6 pt-5 space-y-5">

    <div>
      <p class="text-xs font-mono text-green-600 uppercase tracking-widest mb-1.5">{t('exer.objective')}</p>
      <p class="text-sm text-slate-600 leading-relaxed" set:html={objetivo}></p>
    </div>

    {antesDeEmpezar && (
      <div class="bg-amber-50 border border-amber-100 rounded-lg px-4 py-3">
        <p class="text-xs font-mono text-amber-600 uppercase tracking-widest mb-1">{t('exer.before')}</p>
        <p class="text-sm text-amber-900 leading-relaxed" set:html={antesDeEmpezar}></p>
      </div>
    )}

    <div>
      <p class="text-xs font-mono text-green-600 uppercase tracking-widest mb-3">{t('exer.steps')}</p>
      <slot />
    </div>

    <div class="bg-green-50 border border-green-100 rounded-lg px-4 py-3">
      <p class="text-xs font-mono text-green-700 uppercase tracking-widest mb-1">{t('exer.result')}</p>
      <p class="text-sm text-green-900 leading-relaxed" set:html={resultado}></p>
    </div>

    {errorComun && (
      <div class="bg-red-50 border border-red-100 rounded-lg px-4 py-3">
        <p class="text-xs font-mono text-red-500 uppercase tracking-widest mb-1">{t('exer.error')}</p>
        <p class="text-sm text-red-800 leading-relaxed" set:html={errorComun}></p>
      </div>
    )}

    {comoSaberBien && (
      <div>
        <p class="text-xs font-mono text-slate-400 uppercase tracking-widest mb-1">{t('exer.howgood')}</p>
        <p class="text-sm text-slate-600 leading-relaxed" set:html={comoSaberBien}></p>
      </div>
    )}

  </div>
</details>
