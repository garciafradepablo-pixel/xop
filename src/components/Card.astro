---
interface Props {
  title: string;
  description: string;
  href?: string;
  tag?: string;
}

const { title, description, href, tag } = Astro.props;
---

{href ? (
  <a href={href} class="block p-5 bg-[#0f0f0f] border border-[#1f1f1f] rounded-lg hover:border-[#2d2d2d] hover:bg-[#111111] transition-all group">
    {tag && <span class="label mb-3 block">{tag}</span>}
    <h3 class="text-[#e5e5e5] font-medium mb-2 group-hover:text-white transition-colors text-sm">{title}</h3>
    <p class="text-[#525252] text-xs leading-relaxed">{description}</p>
    <span class="text-[#86efac] font-mono text-xs mt-4 block opacity-0 group-hover:opacity-100 transition-opacity">→</span>
  </a>
) : (
  <div class="p-5 bg-[#0f0f0f] border border-[#1f1f1f] rounded-lg">
    {tag && <span class="label mb-3 block">{tag}</span>}
    <h3 class="text-[#e5e5e5] font-medium mb-2 text-sm">{title}</h3>
    <p class="text-[#525252] text-xs leading-relaxed">{description}</p>
  </div>
)}
