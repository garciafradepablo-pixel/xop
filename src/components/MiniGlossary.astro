---
// Curated subset of the canonical glossary (single source of truth in
// src/data/glosario.ts) so the inline list can never drift from the full page.
import { miniTerminos as terms } from '../data/glosario';
---

<section class="my-10">
  <div class="flex items-baseline gap-3 mb-3">
    <h2 class="font-semibold text-slate-900 text-base">Glosario rápido</h2>
    <span class="text-xs text-slate-400 font-mono">{terms.length} términos</span>
  </div>
  <p class="text-sm text-slate-500 mb-4">Consulta los que no conozcas. No hace falta memorizar ninguno ahora.</p>

  <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm divide-y divide-slate-100">
    {terms.map(t => (
      <details class="group">
        <summary class="list-none [&::-webkit-details-marker]:hidden flex items-center justify-between px-5 py-3.5 cursor-pointer hover:bg-slate-50 transition-colors">
          <span class="font-mono text-sm font-medium text-slate-800">{t.term}</span>
          <span class="text-slate-300 text-xs group-open:rotate-180 transition-transform duration-200">▼</span>
        </summary>
        <div class="px-5 pb-4 pt-1">
          <p class="text-sm text-slate-500 leading-relaxed">{t.def}</p>
        </div>
      </details>
    ))}
  </div>
</section>
