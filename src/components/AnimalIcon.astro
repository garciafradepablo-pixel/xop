---
// Emblem-style animal icons for the evolution ladder (Monkey → Elephant).
// Filled silhouettes in `color`; facial features are engraved using `bg`
// (the badge's own background) so they read as cut-outs at small sizes.
interface Props {
  name: 'monkey' | 'gorilla' | 'eagle' | 'lion' | 'elephant' | 'panda';
  color: string;
  bg: string;
  size?: number;
  class?: string;
}
const { name, color, bg, size = 22, class: cls = '' } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class={cls} aria-hidden="true">

  {name === 'monkey' && (
    <g>
      <circle cx="5.2" cy="9.4" r="3.2" fill={color} />
      <circle cx="18.8" cy="9.4" r="3.2" fill={color} />
      <circle cx="5.2" cy="9.4" r="1.4" fill={bg} />
      <circle cx="18.8" cy="9.4" r="1.4" fill={bg} />
      <ellipse cx="12" cy="11.6" rx="7" ry="7.6" fill={color} />
      <ellipse cx="12" cy="13.9" rx="4.3" ry="4" fill={bg} opacity="0.45" />
      <circle cx="9.5" cy="10.1" r="1.05" fill={bg} />
      <circle cx="14.5" cy="10.1" r="1.05" fill={bg} />
      <circle cx="10.85" cy="13.7" r="0.62" fill={color} />
      <circle cx="13.15" cy="13.7" r="0.62" fill={color} />
    </g>
  )}

  {name === 'gorilla' && (
    <g>
      <path d="M12 3c4.7 0 7.8 2.8 7.8 6.7 0 1.4-.4 2.5-.7 3.7-.4 3.3-3.3 5.9-7.1 5.9s-6.7-2.6-7.1-5.9c-.3-1.2-.7-2.3-.7-3.7C4.2 5.8 7.3 3 12 3z" fill={color} />
      <path d="M6.5 9.1c1.6-1.1 3.4-1.6 5.5-1.6s3.9.5 5.5 1.6" stroke={bg} stroke-width="1.5" fill="none" stroke-linecap="round" />
      <circle cx="9.2" cy="11" r="1.1" fill={bg} />
      <circle cx="14.8" cy="11" r="1.1" fill={bg} />
      <path d="M9.2 14.6c.8.9 1.7 1.3 2.8 1.3s2-.4 2.8-1.3" stroke={bg} stroke-width="1.4" fill="none" stroke-linecap="round" />
      <circle cx="10.6" cy="14" r="0.6" fill={bg} />
      <circle cx="13.4" cy="14" r="0.6" fill={bg} />
    </g>
  )}

  {name === 'eagle' && (
    <g>
      <circle cx="12" cy="6" r="1.8" fill={color} />
      <path d="M12 7.4l1.7 1.5h-3.4z" fill={color} />
      <path d="M11.2 9.4C8.2 6.3 4.6 5 1.2 5.6c2.3 1 3.8 2.2 4.4 3.8-1.9-1-3.8-1-5.5.1 2.2.5 3.9 1.3 5 2.6-1.6-.5-3.1-.2-4.3.9 2.9.6 5.6 1 7.8 2.3.8.47 1.4 1 1.6.4z" fill={color} />
      <path d="M12.8 9.4C15.8 6.3 19.4 5 22.8 5.6c-2.3 1-3.8 2.2-4.4 3.8 1.9-1 3.8-1 5.5.1-2.2.5-3.9 1.3-5 2.6 1.6-.5 3.1-.2 4.3.9-2.9.6-5.6 1-7.8 2.3-.8.47-1.4 1-1.6.4z" fill={color} />
      <path d="M10.5 9.3h3v5.6l.95 3.5c.13.47-.22.9-.7.9h-2.5c-.48 0-.83-.43-.7-.9l.95-3.5z" fill={color} />
    </g>
  )}

  {name === 'lion' && (
    <g>
      <path d="M12 2.4c1 0 1.6.95 2.55 1.05.9.1 1.85-.6 2.6-.1.75.5.6 1.6 1.25 2.2.65.6 1.75.45 2.2 1.25.45.8-.25 1.7 0 2.6.25.9 1.25 1.35 1.15 2.3-.1.95-1.15 1.25-1.5 2.1-.35.85.25 1.8-.35 2.55-.6.75-1.65.45-2.45.9-.8.45-1 1.5-1.95 1.7-.95.2-1.6-.65-2.55-.65s-1.6.85-2.55.65c-.95-.2-1.15-1.25-1.95-1.7-.8-.45-1.85-.15-2.45-.9-.6-.75 0-1.7-.35-2.55-.35-.85-1.4-1.15-1.5-2.1-.1-.95.9-1.4 1.15-2.3.25-.9-.45-1.8 0-2.6.45-.8 1.55-.65 2.2-1.25.65-.6.5-1.7 1.25-2.2.75-.5 1.7.2 2.6.1C10.4 3.35 11 2.4 12 2.4z" fill={color} />
      <circle cx="12" cy="12.2" r="4.7" fill={bg} />
      <circle cx="10.2" cy="11.4" r="0.95" fill={color} />
      <circle cx="13.8" cy="11.4" r="0.95" fill={color} />
      <path d="M10.85 13.2h2.3l-1.15 1.15z" fill={color} />
      <path d="M12 14.35v1.05" stroke={color} stroke-width="0.85" stroke-linecap="round" />
      <path d="M12 15.4c-.55 0-1.05-.28-1.35-.75M12 15.4c.55 0 1.05-.28 1.35-.75" stroke={color} stroke-width="0.85" fill="none" stroke-linecap="round" />
    </g>
  )}

  {name === 'elephant' && (
    <g>
      <ellipse cx="5.5" cy="9.8" rx="3.7" ry="4.3" fill={color} />
      <ellipse cx="18.5" cy="9.8" rx="3.7" ry="4.3" fill={color} />
      <path d="M7.4 8c0-2.4 2-3.9 4.6-3.9s4.6 1.5 4.6 3.9c0 1.9-.85 3.2-2.1 4.05v.05c-.95.55-1.5 1.45-1.5 2.55v3.05c0 1.05-.85 1.9-1.9 1.9-.55 0-1.05-.24-1.4-.62v-4.33c0-1.1-.55-2-1.5-2.55v-.05C8.25 11.2 7.4 9.9 7.4 8z" fill={color} />
      <circle cx="9.9" cy="8.5" r="0.78" fill={bg} />
      <circle cx="14.1" cy="8.5" r="0.78" fill={bg} />
      <path d="M11.5 15.8c0 1.4 0 2.3 0 3 0 .85.55 1.5 1.35 1.5.78 0 1.35-.65 1.35-1.5 0-.5-.32-.85-.78-.85" stroke={color} stroke-width="1.5" fill="none" stroke-linecap="round" />
      <path d="M9.5 13.6c-.4.75-.5 1.55-.3 2.4M14.5 13.6c.12.5.16 1 .12 1.5" stroke={color} stroke-width="0.95" stroke-linecap="round" fill="none" />
    </g>
  )}

  {name === 'panda' && (
    <g>
      <circle cx="6" cy="7" r="3" fill={color} />
      <circle cx="18" cy="7" r="3" fill={color} />
      <circle cx="12" cy="13" r="7.6" fill={color} />
      <ellipse cx="8.9" cy="11.8" rx="2.2" ry="2.9" fill={bg} transform="rotate(20 8.9 11.8)" />
      <ellipse cx="15.1" cy="11.8" rx="2.2" ry="2.9" fill={bg} transform="rotate(-20 15.1 11.8)" />
      <circle cx="9.2" cy="12.2" r="0.85" fill={color} />
      <circle cx="14.8" cy="12.2" r="0.85" fill={color} />
      <path d="M10.7 15.2h2.6l-1.3 1.4z" fill={bg} />
      <path d="M12 16.6v0.9" stroke={bg} stroke-width="0.8" stroke-linecap="round" />
      <path d="M12 17.5c-.55 0-1-.28-1.3-.72M12 17.5c.55 0 1-.28 1.3-.72" stroke={bg} stroke-width="0.8" fill="none" stroke-linecap="round" />
    </g>
  )}
</svg>
