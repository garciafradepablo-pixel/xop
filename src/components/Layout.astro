---
import '../styles/global.css';
import Header from './Header.astro';
import LanguageBar from './LanguageBar.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'MOONKEY LAB by XNLAB Studio — escuela modular para aprender a operar IA, automatizaciones y sistemas de trabajo.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — MOONKEY LAB`} />
    <meta property="og:description" content={description} />
    <title>{title} — MOONKEY LAB</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen antialiased bg-[#f8fafc] text-slate-900">
    <Header />
    <main class="max-w-5xl mx-auto px-6 py-12">
      <slot />
    </main>
    <footer class="border-t border-slate-200 bg-white mt-24 py-12">
      <div class="max-w-3xl mx-auto px-6">

        <!-- Brand + tagline -->
        <div class="text-center mb-8">
          <p class="font-mono text-xs tracking-widest text-slate-400 mb-2">MOONKEY LAB — MMXXVI</p>
          <p class="text-xs text-slate-400 leading-relaxed">Aprende, desbloquea Keys y convierte IA en sistemas reales de trabajo.</p>
        </div>

        <!-- Nav links -->
        <nav class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-xs font-mono mb-8">
          <a href="/manifiesto" class="text-slate-400 hover:text-emerald-600 transition-colors">Manifiesto</a>
          <a href="/info" class="text-slate-400 hover:text-emerald-600 transition-colors">Info</a>
          <a href="/monkeys" class="text-slate-400 hover:text-emerald-600 transition-colors">Monkeys</a>
          <a href="/planes" class="text-slate-400 hover:text-emerald-600 transition-colors">Planes</a>
          <a href="/soporte" class="text-slate-400 hover:text-emerald-600 transition-colors">Soporte</a>
          <a href="/prueba-operador" class="text-slate-400 hover:text-emerald-600 transition-colors">Test de Operador</a>
          <a href="/glosario" class="text-slate-400 hover:text-emerald-600 transition-colors">Glosario</a>
          <a href="/cuenta" class="text-slate-400 hover:text-emerald-600 transition-colors">Cuenta</a>
          <a href="/privacidad" class="text-slate-400 hover:text-emerald-600 transition-colors">Privacidad</a>
        </nav>

        <!-- Divider -->
        <div class="border-t border-slate-100 mb-6"></div>

        <div class="text-center mb-6">
          <p class="text-xs text-slate-400 font-mono">Operator Path construido sobre XN y Connect.</p>
        </div>

        <!-- Language bar -->
        <div class="flex justify-center">
          <LanguageBar subtle={true} />
        </div>

      </div>
    </footer>
  </body>
</html>
