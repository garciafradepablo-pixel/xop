---
import '../styles/global.css';
import Header from './Header.astro';
import LanguageBar from './LanguageBar.astro';
import MoonkeyLogo from './MoonkeyLogo.astro';
import { resolveLocale, localizedPath } from '../i18n/utils';
import { chromeT } from '../i18n/chrome.i18n';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'MOONKEY LAB by XNLAB Studio — escuela modular para aprender a operar IA, automatizaciones y sistemas de trabajo.' } = Astro.props;

import { LOCALES, PREFIX_LOCALES } from '../i18n/config';

const pathname = Astro.url.pathname;
const locale = resolveLocale(Astro.currentLocale, pathname);
const c = chromeT(locale);
const alternates = LOCALES.map((l) => ({ code: l, href: localizedPath(pathname, l) }));
const esHref = localizedPath(pathname, 'es');
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — MOONKEY LAB`} />
    <meta property="og:description" content={description} />
    <title>{title} — MOONKEY LAB</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Typography — Space Grotesk (display) · Inter (body) · JetBrains Mono (labels) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <!-- i18n foundation: locale alternates -->
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.code === 'ch' ? 'de-CH' : a.code} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={esHref} />
  </head>
  <body class="min-h-screen antialiased text-slate-900">
    <!-- Abstract animated colour field behind everything -->
    <div class="mk-bg" aria-hidden="true">
      <span class="mk-blob mk-blob-1"></span>
      <span class="mk-blob mk-blob-2"></span>
      <span class="mk-blob mk-blob-3"></span>
    </div>

    <!-- Reading progress — thin emerald bar at the very top -->
    <div id="mk-progress" class="fixed top-0 left-0 right-0 h-[2px] z-[60] pointer-events-none">
      <div id="mk-progress-fill" class="h-full w-0 origin-left bg-gradient-to-r from-emerald-500 to-emerald-300" style="transform:scaleX(0)"></div>
    </div>

    <Header />
    <main class="max-w-5xl mx-auto px-6 py-12">
      <slot />
    </main>
    <footer class="border-t border-slate-200 bg-white mt-24">
      <div class="max-w-6xl mx-auto px-6 py-16">
        <div class="grid gap-10 sm:gap-8 grid-cols-2 lg:grid-cols-12">

          <!-- Brand block -->
          <div class="col-span-2 lg:col-span-5">
            <MoonkeyLogo variant="horizontal" size="md" />
            <p class="text-sm text-slate-500 leading-relaxed mt-5 max-w-xs">
              {c.tagline}
            </p>
            <a href="https://xnlab.io" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-1.5 mt-5 font-mono text-[11px] tracking-wide text-slate-400 hover:text-emerald-600 transition-colors">
              <span class="w-1 h-1 rounded-full bg-emerald-500"></span>
              {c.lab}
              <span aria-hidden="true">↗</span>
            </a>
          </div>

          <!-- Operator Path -->
          <nav class="lg:col-span-3" aria-label="Operator Path">
            <p class="font-mono text-[10px] tracking-widest uppercase text-slate-400 mb-4">Operator Path</p>
            <ul class="space-y-2.5 text-sm">
              <li><a href={localizedPath('/modulos', locale)} class="text-slate-500 hover:text-emerald-600 transition-colors">{c.level1}</a></li>
              <li><a href={localizedPath('/advanced', locale)} class="text-slate-500 hover:text-emerald-600 transition-colors">{c.level2}</a></li>
              <li><a href={localizedPath('/migrador', locale)} class="text-slate-500 hover:text-emerald-600 transition-colors">{c.level3}</a></li>
              <li><a href={localizedPath('/prueba-operador', locale)} class="text-slate-500 hover:text-emerald-600 transition-colors">{c.opTest}</a></li>
              <li><a href={localizedPath('/prompts', locale)} class="text-slate-500 hover:text-emerald-600 transition-colors">{c.arsenal}</a></li>
            </ul>
          </nav>

          <!-- Ecosystem -->
          <nav class="lg:col-span-2" aria-label={c.ecosystem}>
            <p class="font-mono text-[10px] tracking-widest uppercase text-slate-400 mb-4">{c.ecosystem}</p>
            <ul class="space-y-2.5 text-sm">
              <li><a href={localizedPath('/manifiesto', locale)} class="text-slate-500 hover:text-emerald-600 transition-colors">{c.manifesto}</a></li>
              <li><a href={localizedPath('/monkeys', locale)} class="text-slate-500 hover:text-emerald-600 transition-colors">Monkeys</a></li>
              <li><a href={localizedPath('/planes', locale)} class="text-slate-500 hover:text-emerald-600 transition-colors">{c.plans}</a></li>
              <li><a href={localizedPath('/info', locale)} class="text-slate-500 hover:text-emerald-600 transition-colors">{c.info}</a></li>
              <li><a href={localizedPath('/glosario', locale)} class="text-slate-500 hover:text-emerald-600 transition-colors">{c.glossary}</a></li>
            </ul>
          </nav>

          <!-- Account / support -->
          <nav class="lg:col-span-2" aria-label={c.account}>
            <p class="font-mono text-[10px] tracking-widest uppercase text-slate-400 mb-4">{c.account}</p>
            <ul class="space-y-2.5 text-sm">
              <li><a href={localizedPath('/cuenta', locale)} class="text-slate-500 hover:text-emerald-600 transition-colors">{c.myAccount}</a></li>
              <li><a href={localizedPath('/login', locale)} class="text-slate-500 hover:text-emerald-600 transition-colors">{c.signIn}</a></li>
              <li><a href={localizedPath('/soporte', locale)} class="text-slate-500 hover:text-emerald-600 transition-colors">{c.support}</a></li>
              <li><a href={localizedPath('/privacidad', locale)} class="text-slate-500 hover:text-emerald-600 transition-colors">{c.privacy}</a></li>
            </ul>
          </nav>
        </div>

        <!-- Bottom bar -->
        <div class="mt-14 pt-7 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-5">
          <p class="font-mono text-[11px] tracking-widest text-slate-400 order-2 sm:order-1">
            MOONKEY LAB · MMXXVI — {c.builtOn}
          </p>
          <div class="order-1 sm:order-2">
            <LanguageBar drop="up" />
          </div>
        </div>
      </div>
    </footer>

    <!-- Back to top — appears after scrolling, smooth return -->
    <button
      id="mk-top"
      type="button"
      aria-label="Volver arriba"
      class="fixed bottom-5 right-5 z-50 w-11 h-11 rounded-full bg-slate-900 text-white shadow-lg shadow-slate-900/20 flex items-center justify-center opacity-0 translate-y-3 pointer-events-none transition-all duration-300 hover:bg-emerald-600"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>
    </button>

    <!-- UI behaviours — scroll progress, header shadow on scroll, back-to-top -->
    <script is:inline>
      (function () {
        var fill = document.getElementById('mk-progress-fill');
        var topBtn = document.getElementById('mk-top');
        var header = document.querySelector('header');
        var ticking = false;

        function update() {
          ticking = false;
          var doc = document.documentElement;
          var scrollTop = doc.scrollTop || document.body.scrollTop;
          var height = doc.scrollHeight - doc.clientHeight;
          var ratio = height > 0 ? scrollTop / height : 0;
          if (fill) fill.style.transform = 'scaleX(' + ratio.toFixed(4) + ')';

          if (header) {
            if (scrollTop > 4) header.classList.add('mk-header-scrolled');
            else header.classList.remove('mk-header-scrolled');
          }
          if (topBtn) {
            var show = scrollTop > 600;
            topBtn.classList.toggle('opacity-0', !show);
            topBtn.classList.toggle('translate-y-3', !show);
            topBtn.classList.toggle('pointer-events-none', !show);
          }
        }
        function onScroll() {
          if (!ticking) { ticking = true; requestAnimationFrame(update); }
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        if (topBtn) {
          topBtn.addEventListener('click', function () {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }
        update();
      })();
    </script>

    <!-- Cursor spotlight — feed pointer position into hovered cards -->
    <script is:inline>
      (function () {
        if (window.matchMedia('(pointer: coarse)').matches) return; // skip touch
        var raf = 0, lastCard = null, lx = 0, ly = 0;
        document.addEventListener('pointermove', function (e) {
          var card = e.target instanceof Element ? e.target.closest('.card-hover') : null;
          if (!card) { lastCard = null; return; }
          lastCard = card; lx = e.clientX; ly = e.clientY;
          if (!raf) raf = requestAnimationFrame(function () {
            raf = 0;
            if (!lastCard) return;
            var r = lastCard.getBoundingClientRect();
            lastCard.style.setProperty('--mx', (lx - r.left) + 'px');
            lastCard.style.setProperty('--my', (ly - r.top) + 'px');
          });
        }, { passive: true });
      })();
    </script>

    <!-- Invite capture — first-touch: store ?ref in localStorage, never overwrite -->
    <script is:inline>
      (function () {
        try {
          var ref = new URLSearchParams(window.location.search).get('ref');
          if (!ref) return;
          ref = ref.trim().toUpperCase();
          if (/^[A-Z0-9]{4,32}$/.test(ref) && !localStorage.getItem('moonkey_ref')) {
            localStorage.setItem('moonkey_ref', ref);
          }
        } catch (e) {}
      })();
    </script>

    <!-- Locale detection: record browser preference on first visit, then route the
         visitor to their language on every visit. Any shared link lands in the
         visitor's own language without them touching the switcher. -->
    <script is:inline define:vars={{ PREFIXES: PREFIX_LOCALES }}>
      (function () {
        try {
          if (!localStorage.getItem('moonkey_lang')) {
            var nav = (navigator.language || 'es').toLowerCase();
            // Map the browser language to one of our locales. 'ch' = de-CH (German).
            var detected =
              nav.startsWith('th') ? 'th' :
              nav.startsWith('fr') ? 'fr' :
              nav.startsWith('it') ? 'it' :
              nav.startsWith('de') ? 'ch' :
              nav.startsWith('en') ? 'en' : 'es';
            localStorage.setItem('moonkey_lang', detected);
          }
          var stored = localStorage.getItem('moonkey_lang');
          var seg = location.pathname.split('/').filter(Boolean)[0];
          var onPrefix = PREFIXES.indexOf(seg) !== -1; // already on a /xx/ page
          // Strip any existing locale prefix to get the bare path.
          var rest = onPrefix ? (location.pathname.slice(seg.length + 1) || '/') : location.pathname;
          if (rest.charAt(0) !== '/') rest = '/' + rest;

          if (stored && stored !== 'es' && PREFIXES.indexOf(stored) !== -1) {
            // Non-default language chosen: ensure we're on its prefix.
            if (seg !== stored) {
              location.replace(rest === '/' ? '/' + stored + '/' : '/' + stored + rest);
            }
          } else if (stored === 'es' && onPrefix) {
            // Spanish chosen but sitting on a prefixed page: drop to root locale.
            location.replace(rest);
          }
        } catch (e) {}
      })();
    </script>

    <!-- Scroll-reveal — global IntersectionObserver for [data-reveal] elements.
         Lives here (not per-page) so every page animates in; without it, pages
         using data-reveal stay at opacity:0 forever (this was breaking soporte). -->
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;
        function revealAll() { els.forEach(function (el) { el.classList.add('is-visible'); }); }
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
          revealAll();
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            var el = entry.target;
            var delay = parseInt(el.getAttribute('data-delay') || '0', 10) || 0;
            if (delay) setTimeout(function () { el.classList.add('is-visible'); }, delay);
            else el.classList.add('is-visible');
            io.unobserve(el);
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach(function (el) {
          if (!el.classList.contains('is-visible')) io.observe(el);
        });
        // Safety net: nothing must ever stay stuck invisible.
        window.addEventListener('load', function () {
          setTimeout(function () {
            els.forEach(function (el) {
              var r = el.getBoundingClientRect();
              if (r.top < window.innerHeight && !el.classList.contains('is-visible')) el.classList.add('is-visible');
            });
          }, 700);
        });
      })();
    </script>

    <!-- Advanced scroll parallax -->
    <script is:inline>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var raf = null, lastScroll = 0;
        var blobs = document.querySelectorAll('.mk-blob');
        // Full-bleed colour bands (inline background) plus any explicit opt-in.
        var sections = document.querySelectorAll('section[style*="background"], [data-parallax-band]');

        function updateParallax(scroll) {
          // Blob parallax: dramatic but smooth, 0.4x factor (subtle yet noticeable)
          blobs.forEach(function (blob, i) {
            var factor = 0.4 + i * 0.05;
            blob.style.transform = 'translate3d(0, ' + (scroll * factor) + 'px, 0)';
          });

          // Section band parallax: 0.2x factor (very subtle, maintains professionalism)
          sections.forEach(function (sec) {
            var rect = sec.getBoundingClientRect();
            var inView = rect.top < window.innerHeight && rect.bottom > 0;
            if (inView) {
              var offset = window.innerHeight - rect.top;
              sec.style.backgroundPosition = '0 ' + (offset * 0.15) + 'px';
            }
          });
        }

        function onScroll() {
          lastScroll = window.scrollY || window.pageYOffset;
          if (!raf) {
            raf = requestAnimationFrame(function () {
              updateParallax(lastScroll);
              raf = null;
            });
          }
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        updateParallax(0);
      })();
    </script>
  </body>
</html>
