        objetivo: 'Map งานซ้ำๆ ของตัวเองและตรวจสอบว่าส่วนไหน automate ได้ ส่วนไหนต้องดูแล และส่วนไหนต้องการ human judgment',
        resultado: 'Document พร้อม map ของงาน ติดป้ายตามประเภท (automate ได้ / ดูแล / human) และข้อเสนอ workflow ที่ดีขึ้น',
        errorComun: 'พยายาม automate ทุกอย่างพร้อมกัน เริ่มจากขั้นตอนที่ซ้ำที่สุดและสำคัญน้อยที่สุด ระบบเล็กที่ทำงานได้มีค่ามากกว่าระบบใหญ่ที่ยังไม่เสร็จ',
        comoSaberBien: 'อธิบายระบบได้ใน 5 บรรทัดและบอกวิธีทำงานให้คนอื่นฟังโดยไม่ใช้คำศัพท์เทคนิค',
      },
      steps: [
        'เลือกงานที่ทำอย่างน้อยสัปดาห์ละครั้ง ยิ่งเฉพาะเจาะจงยิ่งดี',
        'เขียนทุกขั้นตอนของงานนั้นตามลำดับ อย่าข้ามแม้แต่ขั้นตอนเล็กๆ',
        `สำหรับแต่ละขั้นตอน ติดป้าย: ${code('automate ได้')}, ${code('ดูแล')}, หรือ ${code('human')}`,
        'ระบุขั้นตอนที่ใช้เวลาหรือพลังงานสมองมากที่สุด',
        'ออกแบบว่าขั้นตอนนั้นจะเป็นอย่างไรถ้า Claude ดำเนินการ Claude ต้องการข้อมูลอะไร? จะผลิตอะไร? คุณจะตรวจสอบอย่างไร?',
      ],
      deliverable: 'Map ของงานพร้อมป้ายและข้อเสนอการทำให้อัตโนมัติ',
      deliverableCheck: 'แยกแยะระหว่างงาน กระบวนการ ระบบ และการทำให้อัตโนมัติได้',
    },
    // M7
    {
      title: 'เผยแพร่และปรับปรุง',
      completion: 'สิ่งที่เผยแพร่แล้วพร้อม URL จริงที่เข้าถึงได้จาก browser ใดก็ได้ และรายการการปรับปรุงที่บันทึกไว้สำหรับเวอร์ชันถัดไป',
      desc: 'การเผยแพร่ปิด cycle เปลี่ยนงานส่วนตัวเป็นงานจริง เรียนรู้วิธี deploy สิ่งเล็กๆ ใน 10 นาที จากนั้นเขียนว่าจะเปลี่ยนอะไร: นั่นคือจุดเริ่มต้นของการ iterate',
      why: 'โปรเจกต์ที่ไม่เผยแพร่ไม่ได้รับ feedback ไม่ปรับปรุง และในที่สุดก็ถูกทิ้ง สิ่งไม่สมบูรณ์ที่ทำงานได้และมีอยู่จริงมีค่ามากกว่าสิ่งสมบูรณ์แบบที่ไม่มีวันออก',
      insightType: 'remember',
      insightHtml: 'เผยแพร่ที่เวอร์ชัน 0.1 ไม่ใช่ 1.0 URL แรกมีอยู่เพื่อให้มีอยู่ feedback จริงเริ่มเมื่อมีบางอย่างเผยแพร่แล้ว การ iterate ก็เช่นกัน',
      exer: {
        objetivo: `Deploy ${code('operador-practica')} บน Cloudflare Pages และบันทึกการปรับปรุงสำหรับ v2`,
        antesDeEmpezar: 'ตรวจสอบว่าโปรเจกต์มีไฟล์เนื้อหาอย่างน้อยหนึ่งไฟล์และ upload ขึ้น GitHub แล้ว',
        resultado: `URL สาธารณะที่ load ได้จาก browser ใดก็ได้ รวมถึงไฟล์ ${code('mejoras-v2.md')} พร้อมอย่างน้อย 3 จุดที่เฉพาะเจาะจง`,
        errorComun: 'รอให้ "สมบูรณ์แบบ" ก่อนเผยแพร่ ไม่มีสมบูรณ์แบบก่อนเผยแพร่ มีแต่สิ่งไม่สมบูรณ์ที่รับ feedback และปรับปรุง',
        comoSaberBien: `URL load ได้ใน browser ที่ไม่ใช่ของคุณ ไฟล์ ${code('mejoras-v2.md')} มีจุดที่เฉพาะเจาะจง ไม่คลุมเครือ`,
      },
      steps: [
        `เข้า ${code('dash.cloudflare.com')} → Workers & Pages → Create → Pages`,
        `เชื่อมต่อบัญชี GitHub ของคุณและเลือก repo ${code('operador-practica')}`,
        `ถ้าเป็น HTML static: ปล่อย Build command ว่างไว้, output directory ${code('/')} ถ้าเป็น Astro: Build command ${code('npm run build')}, output ${code('dist')}`,
        'คลิก Save and Deploy ใน ~60 วินาที จะมี URL สาธารณะ',
        `สร้าง ${code('mejoras-v2.md')} พร้อมอย่างน้อย 3 อย่างที่คุณจะเปลี่ยนหรือเพิ่ม`,
      ],
      deliverable: `URL สาธารณะที่ active + ${code('mejoras-v2.md')}`,
      deliverableCheck: 'ปิด cycle แล้ว: สร้าง → บันทึก → เผยแพร่ → ปรับปรุง',
    },
  ],
};

const mods = MODS[cLocale];

// ── toc (uses module titles from mods) ─────────────────────────────────────────
const toc = mods.map((m, i) => ({ id: `modulo-${i}`, label: m.title, time: modTimes[i] }));

// ── proof checklist ───────────────────────────────────────────────────────────
const proofChecklist: Record<Locale, string[]> = {
  es: [
    'mi-contexto.md en el repo operador-practica',
    'README.md generado con Claude Code y revisado por ti',
    'CLAUDE.md commiteado en el repo',
    '.gitignore y al menos 1 commit (sin secretos)',
    'Prompt operativo propio guardado en el repo',
    'Mapa de automatización de una tarea real',
    'mejoras-v2.md con 3+ puntos concretos',
    'El proyecto desplegado en una URL pública viva',
  ],
  en: [
    'mi-contexto.md in the operador-practica repo',
    'README.md generated with Claude Code and reviewed by you',
    'CLAUDE.md committed to the repo',
    '.gitignore with at least 1 commit (no secrets)',
    'Your own operative prompt saved in the repo',
    'Automation map for a real task',
    'mejoras-v2.md with 3+ concrete points',
    'The project deployed to a live public URL',
  ],
  th: [
    'mi-contexto.md ใน repo operador-practica',
    'README.md ที่สร้างด้วย Claude Code และตรวจสอบโดยคุณ',
    'CLAUDE.md ที่ commit เข้า repo แล้ว',
    '.gitignore และ commit อย่างน้อย 1 อัน (ไม่มี secret)',
    'Prompt เชิงปฏิบัติของตัวเองที่บันทึกใน repo',
    'แผนผัง automation ของงานจริง',
    'mejoras-v2.md พร้อมอย่างน้อย 3 จุดที่เฉพาะเจาะจง',
    'โปรเจกต์ที่ deploy บน URL สาธารณะที่ใช้งานได้จริง',
  ],
};
const checklist = proofChecklist[cLocale];

// ── page meta ─────────────────────────────────────────────────────────────────
const pageTitle = cLocale === 'th' ? 'ระดับ 1 — Operator Foundations' : cLocale === 'en' ? 'Level 1 — Operator Foundations' : 'Nivel 1 — Operator Foundations';
const pageDesc  = cLocale === 'th' ? 'พื้นฐานการใช้ Claude Code, GitHub, automation และระบบ AI 8 โมดูลเชิงปฏิบัติ' : cLocale === 'en' ? 'The foundation for operating Claude Code, GitHub, automations and AI systems. 8 practical modules.' : 'La base para operar Claude Code, GitHub, automatizaciones y sistemas IA. 8 módulos prácticos.';

// ── proof JS strings (passed via define:vars) ─────────────────────────────────
const jsStrings = {
  delivered: t('n1.proof.status.delivered'),
  pending:   t('n1.proof.status.pending'),
  errRepo:        t('n1.proof.err.repo'),
  errRepoFormat:  t('n1.proof.err.repoformat'),
  errUrl:         t('n1.proof.err.url'),
  errUrlFormat:   t('n1.proof.err.urlformat'),
};
---

<LayoutLevel title={pageTitle} description={pageDesc}>

  <!-- SIDEBAR (desktop) -->
  <div slot="sidebar">
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-4 py-3 border-b border-slate-100">
        <span class="font-mono text-xs text-emerald-600 tracking-widest uppercase block mb-0.5">{t('n1.sidebar.label')}</span>
        <p class="font-semibold text-slate-900 leading-snug text-sm">Operator Foundations</p>
        <p class="font-mono text-xs text-emerald-600 mt-0.5">{t('l1.available')}</p>
      </div>
      <div class="px-4 py-3 border-b border-slate-100">
        <div class="flex items-center justify-between mb-1.5">
          <span class="font-mono text-xs text-slate-400">{t('n1.sidebar.progress')}</span>
          <span id="sb-l1-count" class="font-mono text-xs text-slate-500">0/8</span>
        </div>
        <div class="bg-slate-100 rounded-full h-1.5 overflow-hidden">
          <div id="sb-l1-bar" class="bg-emerald-500 h-1.5 rounded-full transition-all duration-500" style="width:0%"></div>
        </div>
      </div>
      <nav class="p-2 space-y-0.5">
        {toc.map((item, i) => (
          <div class="flex items-center gap-1.5">
            <button
              class="sb-mod-btn w-4 h-4 rounded border border-slate-200 shrink-0 text-xs flex items-center justify-center hover:border-emerald-400 transition-colors bg-white leading-none"
              data-mkey={`moonkey_level_1_module_${i}`}
              type="button"
              title={`M${i}`}
            ></button>
            <a href={`#${item.id}`} class="flex-1 flex items-center gap-1.5 text-xs text-slate-500 hover:text-slate-900 px-1 py-1 rounded hover:bg-slate-50 transition-colors overflow-hidden">
              <span class="font-mono text-slate-300 shrink-0">M{i}</span>
              <span class="truncate">{item.label}</span>
            </a>
          </div>
        ))}
      </nav>
      <div class="p-3 border-t border-slate-100">
        <a href="#completar-n1" class="block w-full text-center font-mono text-xs font-medium text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-2 rounded-lg hover:bg-emerald-100 transition-colors">
          {t('n1.sidebar.finalize')}
        </a>
      </div>
    </div>
  </div>

  <!-- MOBILE NAV -->
  <details class="lg:hidden bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden mb-6">
    <summary class="flex items-center justify-between px-4 py-3 cursor-pointer select-none list-none">
      <span class="font-mono text-xs text-emerald-600 tracking-widest uppercase">{t('n1.mobile.label')}</span>
      <span class="text-slate-400 text-xs font-mono">▾</span>
    </summary>
    <nav class="px-4 py-2 border-t border-slate-100 grid grid-cols-2 gap-x-4 gap-y-1">
      {toc.map((item, i) => (
        <a href={`#${item.id}`} class="text-xs text-slate-600 hover:text-emerald-600 py-1 transition-colors flex items-center gap-1.5">
          <span class="font-mono text-slate-300">M{i}</span>{item.label}
        </a>
      ))}
    </nav>
  </details>

  <!-- HERO -->
  <section class="pb-12 border-b border-slate-200">
    <div class="flex items-center gap-3 mb-5">
      <span class="w-11 h-11 rounded-2xl flex items-center justify-center shrink-0 ring-1 ring-slate-900/5" style="background:#1e293b">
        <AnimalIcon name="monkey" color="#94a3b8" bg="#1e293b" size={22} />
      </span>
      <span class="text-xs font-mono text-emerald-600 tracking-widest uppercase">{t('n1.hero.label')}</span>
    </div>
    <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 leading-[1.04] tracking-tight mb-4">
      Operator<br/>Foundations
    </h1>
    <p class="text-slate-600 text-lg leading-relaxed max-w-xl mb-8">{t('n1.hero.desc')}</p>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      {[
        { value: '8',    label: t('n1.stats.modules'),   color: mc[0] },
        { value: '~3h',  label: t('n1.stats.total'),     color: mc[1] },
        { value: '0',    label: t('n1.stats.nocode'),    color: mc[2] },
        { value: '100%', label: t('n1.stats.practical'), color: mc[3] },
      ].map(s => (
        <div class="bg-white rounded-2xl border border-slate-200 p-4 text-center shadow-sm">
          <div class={`text-3xl font-bold mb-1 font-display ${s.color.text}`}>{s.value}</div>
          <div class="text-xs text-slate-500 font-mono">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <FlowDiagram title={t('n1.flow.title')} color="emerald" nodes={fNodes} />

  <MiniGlossary />

  <!-- TOC (mobile only) -->
  <nav id="toc" class="lg:hidden bg-white border border-slate-200 rounded-xl p-5 shadow-sm mb-10">
    <p class="font-semibold text-slate-900 text-sm mb-4">{t('n1.toc.title')}</p>
    <ol class="space-y-2">
      {toc.map((item, i) => (
        <li class="flex items-center gap-3">
          <span class={`font-mono text-xs px-2 py-0.5 rounded shrink-0 w-8 text-center ${mc[i].toc}`}>M{i}</span>
          <a href={`#${item.id}`} class="text-sm text-slate-600 hover:text-slate-900 transition-colors flex-1">{item.label}</a>
          <span class="text-xs text-slate-300 font-mono">{item.time}</span>
        </li>
      ))}
    </ol>
  </nav>

  <!-- MÓDULOS 0–7 -->
  {mods.map((mod, i) => (
    <section id={`modulo-${i}`} class="bg-white rounded-2xl border border-slate-200 shadow-sm p-7 mb-6 scroll-mt-20">
      <div class="flex items-start gap-4 mb-5">
        <span class={`${mc[i].bg} ${mc[i].text} font-mono text-sm font-bold rounded-lg px-3 py-1.5 shrink-0`}>M{i}</span>
        <div>
          <h2 class="text-xl font-bold text-slate-900 tracking-tight">{mod.title}</h2>
          <span class="text-xs text-slate-400 font-mono mt-1 inline-flex items-center gap-1.5">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            {modTimes[i]}
          </span>
        </div>
      </div>

      <div class="bg-emerald-50 border border-emerald-100 rounded-xl px-4 py-3 mb-5">
        <p class="text-xs font-mono text-emerald-600 uppercase tracking-widest mb-1">{t('n1.mod.complete')}</p>
        <p class="text-sm text-slate-700 leading-relaxed">{mod.completion}</p>
      </div>

      <p class="text-slate-600 text-sm leading-relaxed mb-5">{mod.desc}</p>

      <div class={`border-l-4 ${mc[i].border} pl-4 py-1 mb-6`}>
        <p class={`text-xs font-mono ${mc[i].label} uppercase tracking-widest mb-1`}>{t('n1.mod.why')}</p>
        <p class="text-sm text-slate-500 italic leading-relaxed">{mod.why}</p>
      </div>

      {mod.insightType && mod.insightHtml && (
        <InsightBox type={mod.insightType} title={IL[mod.insightType]}>
          <Fragment set:html={mod.insightHtml} />
        </InsightBox>
      )}

      {mod.promptKey && mod.promptTitle && (
        <PromptBlock tag={`PROMPT M${i}`} title={mod.promptTitle} prompt={P(mod.promptKey)} />
      )}

      <ExerciseAccordion
        objetivo={mod.exer.objetivo}
        antesDeEmpezar={mod.exer.antesDeEmpezar}
        resultado={mod.exer.resultado}
        errorComun={mod.exer.errorComun}
        comoSaberBien={mod.exer.comoSaberBien}
        locale={locale}
      >
        <ol class="space-y-3">
          {mod.steps.map((step, si) => (
            <li class="flex gap-3 items-start text-sm text-slate-600">
              <span class="bg-slate-100 text-slate-500 font-mono text-xs rounded px-1.5 py-0.5 shrink-0 mt-0.5 leading-5">{si + 1}</span>
              <span class="leading-relaxed" set:html={step}></span>
            </li>
          ))}
        </ol>
      </ExerciseAccordion>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mt-5 pt-5 border-t border-slate-100 text-xs">
        <div class="flex items-center gap-2 text-slate-500">
          <span class="font-mono">{t('n1.mod.deliverable')}</span>
          <span set:html={mod.deliverable}></span>
        </div>
        <div class="flex items-center gap-2 text-emerald-700"><span>✓</span><span>{mod.deliverableCheck}</span></div>
        <a href="#toc" class="ml-auto text-slate-300 hover:text-slate-500 font-mono transition-colors">{t('n1.mod.index')}</a>
      </div>
    </section>
  ))}

  <!-- PROOF SUBMISSION -->
  <div id="completar-n1" class="bg-emerald-50 border-2 border-emerald-200 rounded-2xl p-7 mt-4 scroll-mt-28">
    <div class="flex items-center justify-between gap-3 mb-2">
      <span class="label">{t('n1.proof.label')}</span>
      <span id="proof-status" class="font-mono text-[10px] tracking-widest uppercase px-2.5 py-1 rounded-lg bg-amber-100 text-amber-700">{t('n1.proof.status.pending')}</span>
    </div>
    <p class="text-slate-700 text-sm leading-relaxed mb-1 font-semibold">{t('n1.proof.title1')}</p>
    <p class="text-slate-600 text-sm leading-relaxed mb-6">
      {t('n1.proof.title2.a')} <strong>{t('n1.proof.title2.b')}</strong>. {t('n1.proof.title2.c')} <code class="bg-white border border-emerald-200 px-1.5 py-0.5 rounded font-mono text-emerald-700 text-xs">operador-practica</code>.
    </p>

    <p class="text-xs font-mono text-emerald-600 uppercase tracking-widest mb-3">{t('n1.proof.checklist.label')}</p>
    <ul class="space-y-2.5 mb-7">
      {checklist.map(item => (
        <li class="flex items-start gap-3 text-sm text-slate-600">
          <span class="text-emerald-500 font-mono shrink-0 mt-0.5 text-base leading-4">✓</span>
          {item}
        </li>
      ))}
    </ul>

    <!-- Pending: form -->
    <div id="proof-form">
      <div class="space-y-4 mb-5">
        <div>
          <label for="proof-repo" class="block font-mono text-xs text-slate-600 mb-1.5">{t('n1.proof.form.repo')}</label>
          <input id="proof-repo" type="url" inputmode="url" autocomplete="off" spellcheck="false" placeholder="https://github.com/tu-usuario/operador-practica" class="w-full font-mono text-sm bg-white border border-slate-300 rounded-xl px-4 py-3 text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-400 transition-colors" />
        </div>
        <div>
          <label for="proof-url" class="block font-mono text-xs text-slate-600 mb-1.5">{t('n1.proof.form.url')}</label>
          <input id="proof-url" type="url" inputmode="url" autocomplete="off" spellcheck="false" placeholder="https://operador-practica.pages.dev" class="w-full font-mono text-sm bg-white border border-slate-300 rounded-xl px-4 py-3 text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-400 transition-colors" />
        </div>
      </div>
      <p id="proof-error" class="hidden text-sm text-rose-600 font-mono mb-4"></p>
      <button id="btn-submit-proof" class="w-full font-mono text-sm font-semibold text-white bg-emerald-500 px-6 py-4 rounded-xl hover:bg-emerald-600 transition-colors cursor-pointer border-0">
        {t('n1.proof.form.submit')}
      </button>
    </div>

    <!-- Delivered state -->
    <div id="proof-delivered" class="hidden">
      <div class="bg-emerald-500 text-white rounded-xl px-6 py-5 text-center mb-4">
        <p class="font-mono text-xs tracking-widest uppercase mb-1.5 opacity-80">{t('n1.proof.delivered.badge')}</p>
        <p class="font-semibold text-base">{t('n1.proof.delivered.subtitle')}</p>
      </div>
      <div class="space-y-2 mb-4">
        <a id="proof-repo-link" href="#" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-white border border-emerald-200 rounded-xl px-4 py-3 font-mono text-xs text-slate-700 hover:border-emerald-400 transition-colors break-all">
          <span class="text-emerald-600 shrink-0">repo →</span><span id="proof-repo-text"></span>
        </a>
        <a id="proof-url-link" href="#" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-white border border-emerald-200 rounded-xl px-4 py-3 font-mono text-xs text-slate-700 hover:border-emerald-400 transition-colors break-all">
          <span class="text-emerald-600 shrink-0">live →</span><span id="proof-url-text"></span>
        </a>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/advanced" class="flex-1 text-center font-mono text-sm font-semibold text-violet-700 border-2 border-violet-300 bg-violet-50 px-6 py-3.5 rounded-xl hover:bg-violet-100 transition-colors">
          {t('n1.proof.delivered.n2')}
        </a>
        <button id="btn-edit-proof" class="font-mono text-xs text-slate-500 hover:text-slate-700 px-4 py-3.5 transition-colors cursor-pointer border-0 bg-transparent">{t('n1.proof.edit')}</button>
      </div>
    </div>
  </div>

</LayoutLevel>

<script define:vars={jsStrings} is:inline>
  (function () {
    var MKEYS = [0,1,2,3,4,5,6,7].map(function(i) { return 'moonkey_level_1_module_' + i; });
    var TOTAL = 8;

    function getCount() {
      return MKEYS.reduce(function(n, k) { return n + (localStorage.getItem(k) === 'true' ? 1 : 0); }, 0);
    }

    function applyChecks() {
      var count = getCount();
      document.querySelectorAll('.sb-mod-btn').forEach(function(btn) {
        var done = localStorage.getItem(btn.getAttribute('data-mkey')) === 'true';
        btn.textContent = done ? '✓' : '';
        btn.style.background = done ? '#10b981' : '';
        btn.style.borderColor = done ? '#10b981' : '';
        btn.style.color = done ? '#fff' : '';
      });
      var bar = document.getElementById('sb-l1-bar');
      if (bar) bar.style.width = (count / TOTAL * 100).toFixed(0) + '%';
      var cnt = document.getElementById('sb-l1-count');
      if (cnt) cnt.textContent = count + '/' + TOTAL;
    }

    applyChecks();

    document.querySelectorAll('.sb-mod-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var key = btn.getAttribute('data-mkey');
        var done = localStorage.getItem(key) === 'true';
        localStorage.setItem(key, done ? 'false' : 'true');
        applyChecks();
      });
    });

    // ── proof submission ──
    var REPO_KEY = 'moonkey_level_1_proof_repo';
    var URL_KEY  = 'moonkey_level_1_proof_url';
    var DONE_KEY = 'moonkey_level_1_completed';

    var formEl      = document.getElementById('proof-form');
    var deliveredEl = document.getElementById('proof-delivered');
    var statusEl    = document.getElementById('proof-status');
    var repoInput   = document.getElementById('proof-repo');
    var urlInput    = document.getElementById('proof-url');
    var errEl       = document.getElementById('proof-error');
    var submitBtn   = document.getElementById('btn-submit-proof');
    var editBtn     = document.getElementById('btn-edit-proof');

    function lsGet(k) { try { return localStorage.getItem(k) || ''; } catch (e) { return ''; } }
    function lsSet(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }

    function isGithubRepo(v) {
      return /^https:\/\/github\.com\/[^/\s]+\/[^/\s]+/i.test(v.trim());
    }
    function isLiveUrl(v) {
      return /^https?:\/\/[^\s.]+\.[^\s]+/i.test(v.trim());
    }

    function showDelivered() {
      var repo = lsGet(REPO_KEY), url = lsGet(URL_KEY);
      if (formEl) formEl.classList.add('hidden');
      if (deliveredEl) deliveredEl.classList.remove('hidden');
      if (statusEl) {
        statusEl.textContent = delivered;
        statusEl.className = 'font-mono text-[10px] tracking-widest uppercase px-2.5 py-1 rounded-lg bg-emerald-100 text-emerald-700';
      }
      var rl = document.getElementById('proof-repo-link');
      var ul = document.getElementById('proof-url-link');
      // Re-validate the scheme before trusting stored values as live hrefs.
      if (rl) rl.href = isGithubRepo(repo) ? repo : '#';
      if (ul) ul.href = isLiveUrl(url) ? url : '#';
      var rt = document.getElementById('proof-repo-text'); if (rt) rt.textContent = repo;
      var ut = document.getElementById('proof-url-text');  if (ut) ut.textContent = url;
    }

    function showForm() {
      if (deliveredEl) deliveredEl.classList.add('hidden');
      if (formEl) formEl.classList.remove('hidden');
      if (statusEl) {
        statusEl.textContent = pending;
        statusEl.className = 'font-mono text-[10px] tracking-widest uppercase px-2.5 py-1 rounded-lg bg-amber-100 text-amber-700';
      }
      if (repoInput) repoInput.value = lsGet(REPO_KEY);
      if (urlInput)  urlInput.value  = lsGet(URL_KEY);
    }

    var savedRepo = lsGet(REPO_KEY), savedUrl = lsGet(URL_KEY);
    if (savedRepo && savedUrl && isGithubRepo(savedRepo) && isLiveUrl(savedUrl)) {
      showDelivered();
    } else {
      showForm();
    }

    if (submitBtn) {
      submitBtn.addEventListener('click', function() {
        var repo = (repoInput && repoInput.value || '').trim();
        var url  = (urlInput  && urlInput.value  || '').trim();
        var problems = [];
        if (!repo) problems.push(errRepo);
        else if (!isGithubRepo(repo)) problems.push(errRepoFormat);
        if (!url) problems.push(errUrl);
        else if (!isLiveUrl(url)) problems.push(errUrlFormat);

        if (problems.length) {
          if (errEl) { errEl.textContent = problems.join(' '); errEl.classList.remove('hidden'); }
          return;
        }
        if (errEl) errEl.classList.add('hidden');
        lsSet(REPO_KEY, repo);
        lsSet(URL_KEY, url);
        lsSet(DONE_KEY, 'true');
        showDelivered();
      });
    }

    if (editBtn) {
      editBtn.addEventListener('click', function() { showForm(); });
    }
  })();
</script>

<script>
  // N1 proof capture — record a valid submission in Supabase so the founder
  // actually receives the proof. RLS requires an authenticated session and binds
  // the row to the caller (proofs_insert_self). So this is HONEST about outcome:
  // logged out → saved locally but not delivered; logged in → delivered, with a
  // visible confirmation. No more silent "Delivered ✓" when the cloud write failed.
  import { supabase } from '../lib/supabase';
  (function () {
    if (!supabase) return;
    const btn = document.getElementById('btn-submit-proof');
    const repoInput = document.getElementById('proof-repo');
    const urlInput = document.getElementById('proof-url');
    const deliveredEl = document.getElementById('proof-delivered');
    if (!btn || !repoInput || !urlInput) return;

    const isRepo = (v) => /^https:\/\/github\.com\/[a-zA-Z0-9._-]+\/[a-zA-Z0-9._-]+\/?$/i.test(v.trim());
    const isUrl = (v) => {
      try { const u = new URL(v.trim()); return u.protocol === 'http:' || u.protocol === 'https:'; }
      catch (e) { return false; }
    };

    const es = (document.documentElement.lang || 'es') === 'es';
    const MSG = {
      sending:   es ? 'Registrando entrega…' : 'Recording your delivery…',
      ok:        es ? 'Entrega registrada en tu cuenta ✓' : 'Delivery recorded in your account ✓',
      needLogin: es ? 'Guardada localmente. Inicia sesión para que tu entrega llegue al equipo →'
                    : 'Saved locally. Log in so your delivery reaches the team →',
      error:     es ? 'No se pudo registrar la entrega. Reintenta más tarde.'
                    : 'Could not record the delivery. Try again later.',
    };

    // A small status line appended once to the delivered card.
    function statusNode() {
      let n = document.getElementById('proof-cloud-status');
      if (!n && deliveredEl) {
        n = document.createElement('p');
        n.id = 'proof-cloud-status';
        n.className = 'font-mono text-[11px] mt-3 leading-relaxed';
        deliveredEl.appendChild(n);
      }
      return n;
    }
    function setStatus(text, tone, href) {
      const n = statusNode();
      if (!n) return;
      const color = tone === 'ok' ? 'text-emerald-600' : tone === 'error' ? 'text-rose-600' : 'text-amber-600';
      n.className = 'font-mono text-[11px] mt-3 leading-relaxed ' + color;
      if (href) {
        const loginHref = (document.documentElement.lang && document.documentElement.lang !== 'es')
          ? '/' + document.documentElement.lang + '/login' : '/login';
        n.innerHTML = '';
        const a = document.createElement('a');
        a.href = loginHref; a.textContent = text; a.className = 'underline hover:text-amber-700';
        n.appendChild(a);
      } else {
        n.textContent = text;
      }
    }

    btn.addEventListener('click', async () => {
      const repo = (repoInput.value || '').trim();
      const live = (urlInput.value || '').trim();
      if (!isRepo(repo) || !isUrl(live)) return; // invalid → inline script shows the error

      let userId = null, email = null, ref = null;
      try {
        const { data } = await supabase.auth.getSession();
        userId = data?.session?.user?.id ?? null;
        email = data?.session?.user?.email ?? null;
      } catch (e) {}

      if (!userId) { setStatus(MSG.needLogin, 'warn', true); return; }

      try { ref = localStorage.getItem('moonkey_ref'); } catch (e) {}
      const locale = (document.documentElement.lang || 'es');

      setStatus(MSG.sending, 'warn');
      const { error } = await supabase.from('proofs').insert({
        level: 'N1', repo_url: repo, live_url: live,
        email, user_id: userId, ref_code: ref, locale,
      });
      if (error) { console.warn('[proof] capture failed:', error.message); setStatus(MSG.error, 'error'); }
      else { setStatus(MSG.ok, 'ok'); }
    });
  })();
</script>
