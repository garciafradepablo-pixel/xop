---
import LayoutLevel from '../components/LayoutLevel.astro';
import ExerciseAccordion from '../components/ExerciseAccordion.astro';
import MiniGlossary from '../components/MiniGlossary.astro';
import PromptBlock from '../components/PromptBlock.astro';
import FlowDiagram from '../components/FlowDiagram.astro';
import InsightBox from '../components/InsightBox.astro';
import AnimalIcon from '../components/AnimalIcon.astro';
import { resolveLocale, useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/config';

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const t = useTranslations(locale);

// Deep module bodies exist only for es/en/th. For other locales (fr/it/ch) the
// page chrome is translated via t(), but the long curriculum content falls back
// to English — far more readable for those audiences than Spanish.
type ContentLocale = 'es' | 'en' | 'th';
const cLocale: ContentLocale = (locale === 'es' || locale === 'th') ? locale : 'en';

// ── helper: inline code HTML ──────────────────────────────────────────────────
const C  = 'bg-slate-100 text-slate-700 px-1.5 py-0.5 rounded text-xs font-mono';
const CE = 'font-mono text-xs bg-rose-100 px-1 rounded';
const B  = 'text-slate-700';
const code  = (x: string) => `<code class="${C}">${x}</code>`;
const codeE = (x: string) => `<code class="${CE}">${x}</code>`;
const bold  = (x: string) => `<strong class="${B}">${x}</strong>`;

// ── color map ─────────────────────────────────────────────────────────────────
const mc = [
  { bg: 'bg-emerald-50', text: 'text-emerald-700', border: 'border-emerald-300', label: 'text-emerald-600', toc: 'text-emerald-700 bg-emerald-50' },
  { bg: 'bg-sky-50',     text: 'text-sky-700',     border: 'border-sky-300',     label: 'text-sky-600',     toc: 'text-sky-700 bg-sky-50'         },
  { bg: 'bg-violet-50',  text: 'text-violet-700',  border: 'border-violet-300',  label: 'text-violet-600',  toc: 'text-violet-700 bg-violet-50'   },
  { bg: 'bg-amber-50',   text: 'text-amber-700',   border: 'border-amber-300',   label: 'text-amber-600',   toc: 'text-amber-700 bg-amber-50'     },
  { bg: 'bg-rose-50',    text: 'text-rose-700',    border: 'border-rose-300',    label: 'text-rose-600',    toc: 'text-rose-700 bg-rose-50'       },
  { bg: 'bg-teal-50',    text: 'text-teal-700',    border: 'border-teal-300',    label: 'text-teal-600',    toc: 'text-teal-700 bg-teal-50'       },
  { bg: 'bg-orange-50',  text: 'text-orange-700',  border: 'border-orange-300',  label: 'text-orange-600',  toc: 'text-orange-700 bg-orange-50'   },
  { bg: 'bg-indigo-50',  text: 'text-indigo-700',  border: 'border-indigo-300',  label: 'text-indigo-600',  toc: 'text-indigo-700 bg-indigo-50'   },
];

// ── module times (locale-invariant) ───────────────────────────────────────────
const modTimes = ['15 min','20 min','20 min','25 min','20 min','20 min','25 min','20 min'];

// ── insight box label overrides ───────────────────────────────────────────────
const insightLabels: Record<Locale, { protip: string; error: string; remember: string; insight: string }> = {
  es: { protip: 'PRO TIP',   error: 'ERROR COMÚN',              remember: 'RECUERDA', insight: 'INSIGHT' },
  en: { protip: 'PRO TIP',   error: 'COMMON MISTAKE',           remember: 'REMEMBER', insight: 'INSIGHT' },
  th: { protip: 'เคล็ดลับ', error: 'ข้อผิดพลาดที่พบบ่อย', remember: 'จำไว้',     insight: 'ข้อมูลเชิงลึก' },
};
const IL = insightLabels[cLocale];

// ── prompts ───────────────────────────────────────────────────────────────────
const prompts: Record<'contexto'|'documentar'|'claudeMd'|'auditoria', Record<Locale, string>> = {
  contexto: {
    es: `Tengo historial de trabajo contigo en conversaciones previas.\n\nExtrae un resumen estructurado con estos bloques:\n- Nombre de mi proyecto o área de trabajo principal\n- Herramientas que uso habitualmente\n- Mis objetivos actuales\n- Mi estilo de trabajo preferido con IA\n- Lo que NO quiero que hagas cuando trabajamos juntos\n- Cualquier regla de trabajo que hayamos establecido juntos\n\nFormato: Markdown. Máximo 30 líneas. Sin decoración ni relleno.`,
    en: `I have work history with you in previous conversations.\n\nExtract a structured summary with these blocks:\n- Name of my project or main work area\n- Tools I regularly use\n- My current objectives\n- My preferred working style with AI\n- What I DON'T want you to do when we work together\n- Any working rules we've established together\n\nFormat: Markdown. Maximum 30 lines. No decoration or filler.`,
    th: `ฉันมีประวัติการทำงานกับคุณในการสนทนาก่อนหน้า\n\nดึงสรุปที่มีโครงสร้างพร้อม sections เหล่านี้:\n- ชื่อโปรเจกต์หรือพื้นที่งานหลักของฉัน\n- เครื่องมือที่ฉันใช้เป็นประจำ\n- เป้าหมายปัจจุบันของฉัน\n- สไตล์การทำงานกับ AI ที่ฉันชอบ\n- สิ่งที่ฉันไม่ต้องการให้คุณทำเมื่อเราทำงานร่วมกัน\n- กฎการทำงานที่เราตกลงกันไว้\n\nFormat: Markdown ไม่เกิน 30 บรรทัด ไม่มีตกแต่งหรือ filler`,
  },
  documentar: {
    es: `Actúa como redactor de documentación técnica.\n\nAnaliza este proyecto y crea un README.md que incluya:\n- Qué hace este proyecto en una sola línea\n- Por qué existe\n- Cómo instalarlo y ejecutarlo\n- Estructura de archivos y carpetas relevante\n- Próximos pasos o cómo contribuir\n\nTono: claro y directo. Sin lenguaje innecesariamente técnico.`,
    en: `Act as a technical documentation writer.\n\nAnalyze this project and create a README.md that includes:\n- What this project does in a single line\n- Why it exists\n- How to install and run it\n- Relevant file and folder structure\n- Next steps or how to contribute\n\nTone: clear and direct. No unnecessarily technical language.`,
    th: `ทำตัวเป็นนักเขียนเอกสารทางเทคนิค\n\nวิเคราะห์โปรเจกต์นี้และสร้าง README.md ที่รวมถึง:\n- สิ่งที่โปรเจกต์นี้ทำในหนึ่งบรรทัด\n- เหตุผลที่มีอยู่\n- วิธีติดตั้งและเรียกใช้\n- โครงสร้างไฟล์และโฟลเดอร์ที่เกี่ยวข้อง\n- ขั้นตอนต่อไปหรือวิธีมีส่วนร่วม\n\nโทน: ชัดเจนและตรงไปตรงมา ไม่ใช้ภาษาเทคนิคโดยไม่จำเป็น`,
  },
  claudeMd: {
    es: `Actúa como arquitecto de proyectos.\n\nCrea un CLAUDE.md para este proyecto con:\n- Descripción y objetivo principal\n- Stack técnico utilizado\n- Convenciones de estilo o código\n- Lo que NO debes hacer en este proyecto\n- Cómo añadir módulos o nuevas secciones\n- Tono y voz del proyecto si aplica\n\nSé conciso. Sin relleno. Máximo 40 líneas.`,
    en: `Act as a project architect.\n\nCreate a CLAUDE.md for this project with:\n- Description and main objective\n- Technical stack used\n- Style or code conventions\n- What you should NOT do in this project\n- How to add modules or new sections\n- Project tone and voice if applicable\n\nBe concise. No filler. Maximum 40 lines.`,
    th: `ทำตัวเป็น architect โปรเจกต์\n\nสร้าง CLAUDE.md สำหรับโปรเจกต์นี้พร้อม:\n- คำอธิบายและเป้าหมายหลัก\n- tech stack ที่ใช้\n- convention ของ style หรือโค้ด\n- สิ่งที่ไม่ควรทำในโปรเจกต์นี้\n- วิธีเพิ่ม module หรือ section ใหม่\n- โทนและเสียงของโปรเจกต์ถ้ามี\n\nกระชับ ไม่มี filler ไม่เกิน 40 บรรทัด`,
  },
  auditoria: {
    es: `Actúa como analista de flujos de trabajo.\n\nAnaliza esta tarea repetitiva: [describe la tarea en detalle]\n\nResponde:\n1. Pasos que la componen, desglosados sin omitir ninguno\n2. Qué pasos son automatizables y cuáles no, con justificación\n3. Qué herramienta resolvería cada parte automatizable\n4. Qué partes requieren supervisión humana obligatoria\n5. Estimación de tiempo ahorrado si se implementara la automatización\n\nSé específico. No generalices.`,
    en: `Act as a workflow analyst.\n\nAnalyze this repetitive task: [describe the task in detail]\n\nAnswer:\n1. The steps that compose it, broken down without omitting any\n2. Which steps are automatable and which are not, with justification\n3. What tool would solve each automatable part\n4. Which parts require mandatory human supervision\n5. Estimated time saved if the automation were implemented\n\nBe specific. Don't generalize.`,
    th: `ทำตัวเป็นนักวิเคราะห์ workflow\n\nวิเคราะห์งานซ้ำๆ นี้: [อธิบายงานในรายละเอียด]\n\nตอบ:\n1. ขั้นตอนที่ประกอบขึ้น แยกออกมาโดยไม่ข้ามขั้นตอนใด\n2. ขั้นตอนไหน automate ได้และไม่ได้ พร้อมเหตุผล\n3. เครื่องมืออะไรที่แก้ปัญหาส่วนที่ automate ได้แต่ละส่วน\n4. ส่วนไหนที่ต้องการการดูแลจากมนุษย์อย่างบังคับ\n5. เวลาที่ประมาณว่าจะประหยัดได้ถ้านำ automation ไปใช้\n\nระบุให้ชัดเจน อย่า generalize`,
  },
};
const P = (k: 'contexto'|'documentar'|'claudeMd'|'auditoria') => prompts[k][cLocale];

// ── flow diagram nodes ─────────────────────────────────────────────────────────
type FlowNode = { label: string; sub: string };
const flowNodes: Record<Locale, FlowNode[]> = {
  es: [
    { label: 'TÚ',                                              sub: 'Operador con contexto y objetivos' },
    { label: 'Claude Code',                                     sub: 'IA en tu entorno local' },
    { label: 'CLAUDE.md + contexto + prompts',                  sub: 'Las instrucciones que guían el trabajo' },
    { label: 'GitHub + archivos + automatizaciones',            sub: 'Donde vive y se versiona el trabajo' },
    { label: 'Output: páginas, sistemas, documentación, workflows', sub: 'El resultado concreto y entregable' },
  ],
  en: [
    { label: 'YOU',                                             sub: 'Operator with context and objectives' },
    { label: 'Claude Code',                                     sub: 'AI in your local environment' },
    { label: 'CLAUDE.md + context + prompts',                   sub: 'The instructions that guide the work' },
    { label: 'GitHub + files + automations',                    sub: 'Where work lives and is versioned' },
    { label: 'Output: pages, systems, documentation, workflows',sub: 'The concrete, deliverable result' },
  ],
  th: [
    { label: 'คุณ',                                             sub: 'Operator พร้อม context และเป้าหมาย' },
    { label: 'Claude Code',                                     sub: 'AI ในสภาพแวดล้อม local ของคุณ' },
    { label: 'CLAUDE.md + context + prompts',                   sub: 'คำสั่งที่ guide การทำงาน' },
    { label: 'GitHub + ไฟล์ + automation',                     sub: 'ที่อยู่และ version ของงาน' },
    { label: 'Output: เว็บ, ระบบ, เอกสาร, workflow',           sub: 'ผลลัพธ์ที่จับต้องได้และส่งมอบได้' },
  ],
};
const fNodes = flowNodes[cLocale];

// ── module content ─────────────────────────────────────────────────────────────
type ModData = {
  title: string;
  completion: string;
  desc: string;
  why: string;
  insightType?: 'protip'|'insight'|'error'|'remember';
  insightHtml?: string;
  promptKey?: 'contexto'|'documentar'|'claudeMd'|'auditoria';
  promptTitle?: string;
  exer: {
    objetivo: string;
    antesDeEmpezar?: string;
    resultado: string;
    errorComun: string;
    comoSaberBien?: string;
  };
  steps: string[];
  deliverable: string;
  deliverableCheck: string;
};

const MODS: Record<Locale, ModData[]> = {
  es: [
    // M0
    {
      title: 'Preparar contexto',
      completion: 'Tienes un documento con tu contexto operativo listo para darle a Claude al inicio de cualquier proyecto.',
      desc: 'Claude no tiene memoria entre sesiones. Sin contexto, trabaja de forma genérica. Con contexto, trabaja de forma precisa. Este módulo te enseña a crear ese contexto antes de empezar cualquier tarea.',
      why: 'La mayoría de outputs mediocres de IA no vienen de la herramienta, vienen de la falta de contexto. Un documento bien escrito te ahorra media hora de correcciones en cada sesión.',
      insightType: 'protip',
      insightHtml: 'Escribe el contexto como si le explicaras tu trabajo a un contratista experto pero recién llegado. Denso, preciso, sin tutoriales. Una línea por punto. Si supera 30 líneas, recorta.',
      promptKey: 'contexto',
      promptTitle: 'Extraer contexto operativo de conversaciones previas',
      exer: {
        objetivo: 'Crear un documento personal de contexto operativo que puedas darle a Claude al inicio de cualquier proyecto.',
        antesDeEmpezar: 'Abre VS Code o cualquier editor. No necesitas instalar nada para este módulo.',
        resultado: `Un archivo ${code('mi-contexto.md')} de 20–30 líneas con información densa y útil sobre ti y tu trabajo.`,
        errorComun: 'Escribir demasiado. El contexto debe ser preciso, no exhaustivo. Si pasa de 30 líneas, recorta.',
        comoSaberBien: 'Puedes darle el archivo a Claude en una nueva sesión y él sabe cómo trabajar contigo sin que tengas que explicar nada básico.',
      },
      steps: [
        `Crea un archivo llamado ${code('mi-contexto.md')} en una carpeta de tu elección.`,
        `Escribe estas secciones: ${bold('Quién soy')}, ${bold('Proyectos activos')}, ${bold('Herramientas que uso')}, ${bold('Cómo prefiero trabajar')}, ${bold('Lo que NO quiero que Claude haga')}.`,
        'Sé concreto. Una línea por punto. Sin párrafos innecesarios.',
        `Si tienes historial en Claude.ai, usa el prompt de arriba para extraer el contexto automáticamente.`,
      ],
      deliverable: code('mi-contexto.md'),
      deliverableCheck: 'Claude entiende tu trabajo sin explicaciones repetidas',
    },
    // M1
    {
      title: 'Entorno de trabajo',
      completion: 'Terminal abierta, carpeta de práctica creada y VS Code funcionando con tu primer archivo.',
      desc: 'No puedes operar sistemas digitales sin conocer el entorno donde viven. La terminal es el cockpit desde donde controlas todo. VS Code es donde editas y revisas. Este módulo te da las herramientas mínimas para empezar.',
      why: 'Muchos principiantes evitan la terminal durante meses. Es el error más caro que puedes cometer. Todo lo que harás en los siguientes módulos requiere moverse por ella con soltura básica.',
      exer: {
        objetivo: 'Abrir la terminal, crear una carpeta de práctica y abrir el entorno de trabajo en VS Code.',
