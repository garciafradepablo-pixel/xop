<script is:inline>
  (function () {
    var SKEYS = [1,2,3,4,5,6,7,8].map(function(i) { return 'moonkey_level_3_section_' + i; });
    var TOTAL = 8;
    function ls(k) { return localStorage.getItem(k) === 'true'; }

    function applyChecks() {
      var count = SKEYS.reduce(function(n, k) { return n + (ls(k) ? 1 : 0); }, 0);
      document.querySelectorAll('.sb-mod-btn').forEach(function(btn) {
        var done = ls(btn.getAttribute('data-mkey'));
        btn.textContent = done ? '✓' : '';
        btn.style.background = done ? '#f59e0b' : '';
        btn.style.borderColor = done ? '#f59e0b' : '';
        btn.style.color = done ? '#fff' : '';
      });
      var bar = document.getElementById('sb-l3-bar');
      if (bar) bar.style.width = (count / TOTAL * 100).toFixed(0) + '%';
      var cnt = document.getElementById('sb-l3-count');
      if (cnt) cnt.textContent = count + '/' + TOTAL;
    }

    function showDone3() {
      var b = document.getElementById('btn-complete-l3');
      if (b) b.style.display = 'none';
      var m = document.getElementById('msg-complete-l3');
      if (m) m.classList.remove('hidden');
    }

    // Reflects current localStorage — re-runnable when cloud sync hydrates it.
    function paint() {
      var l2 = ls('moonkey_level_2_completed');
      if (l2) {
        var overlay = document.getElementById('migrador-lock-overlay');
        if (overlay) overlay.classList.add('hidden');
        var content = document.getElementById('migrador-content');
        if (content) content.classList.remove('hidden');
        var sbLocked = document.getElementById('sb-n3-locked');
        var sbUnlocked = document.getElementById('sb-n3-unlocked');
        if (sbLocked) sbLocked.classList.add('hidden');
        if (sbUnlocked) sbUnlocked.classList.remove('hidden');
      }
      applyChecks();
      if (ls('moonkey_level_3_completed')) showDone3();
    }

    // Listeners attached once (unconditional — clicks on locked/hidden content are inert).
    document.querySelectorAll('.sb-mod-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var key = btn.getAttribute('data-mkey');
        if (ls(key)) return; // completion is one-way; union sync can't revert it anyway
        localStorage.setItem(key, 'true');
        applyChecks();
        document.dispatchEvent(new Event('moonkey:changed'));
      });
    });
    var complBtn = document.getElementById('btn-complete-l3');
    if (complBtn) {
      complBtn.addEventListener('click', function() {
        localStorage.setItem('moonkey_level_3_completed', 'true');
        showDone3();
        document.dispatchEvent(new Event('moonkey:changed'));
      });
    }

    paint();
    document.addEventListener('moonkey:hydrated', paint);
  })();
</script>

<script>
  // Cloud progress — bidirectional sync for logged-in operators (see modulos.astro).
  import { supabase } from '../lib/supabase';
  import { syncProgress, pushLocalToCloud } from '../lib/progress';
  (function () {
    if (!supabase) return;
    let userId: string | null = null;
    let hydrated = false;
    let dirtyDuringHydration = false;
    let timer: ReturnType<typeof setTimeout> | null = null;

    function schedulePush() {
      if (timer) clearTimeout(timer);
      timer = setTimeout(function () { timer = null; if (userId) pushLocalToCloud(supabase, userId); }, 700);
    }
    function flush() {
      if (timer) { clearTimeout(timer); timer = null; if (hydrated && userId) pushLocalToCloud(supabase, userId); }
    }

    document.addEventListener('moonkey:changed', function () {
      if (!userId) return;
      if (!hydrated) { dirtyDuringHydration = true; return; }
      schedulePush();
    });
    window.addEventListener('pagehide', flush);
    document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'hidden') flush(); });

    (async function () {
      try {
        const { data } = await supabase.auth.getSession();
        userId = data?.session?.user?.id ?? null;
      } catch (e) {}
      if (!userId) return;
      const res = await syncProgress(supabase, userId);
      if (!res.ok) return;
      hydrated = true;
      if (dirtyDuringHydration) pushLocalToCloud(supabase, userId);
      document.dispatchEvent(new Event('moonkey:hydrated'));
    })();
  })();
</script>
