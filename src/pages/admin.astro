---
import Layout from '../components/Layout.astro';

const configured = !!(
  import.meta.env.PUBLIC_SUPABASE_URL &&
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);
---

<Layout
  title="Admin"
  description="Panel de administración de MOONKEY LAB."
>
  <section class="pb-10 border-b border-slate-200">
    <span class="label block mb-3">ADMIN</span>
    <h1 class="text-2xl font-bold text-slate-900 mb-3">Panel de operadores.</h1>
    <p class="text-slate-500 text-sm leading-relaxed max-w-md">
      Vista de estado de la plataforma piloto. Acceso restringido — pendiente de implementar autenticación admin.
    </p>
  </section>

  {!configured ? (
    <section class="py-12">
      <div class="bg-amber-50 border border-amber-200 rounded-2xl p-8 max-w-lg mb-6">
        <span class="font-mono text-[10px] tracking-widest text-amber-700 uppercase block mb-3">SETUP PENDIENTE</span>
        <h2 class="text-lg font-bold text-slate-900 mb-3">Admin pendiente de conexión.</h2>
        <p class="text-slate-600 text-sm leading-relaxed mb-4">
          El panel admin requiere Supabase configurado. Una vez activo, este panel mostrará datos reales del piloto.
        </p>
        <p class="font-mono text-xs text-amber-700">Consulta <code>docs/platform-next-steps.md</code> en el repositorio.</p>
      </div>

      <!-- Preview of what it will show -->
      <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase mb-4">VISTA PREVIA — DATOS REALES CUANDO ESTÉ ACTIVO</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-8">
        {[
          { label: 'Monkeys registrados', value: '—', color: 'text-emerald-600' },
          { label: 'N1 completados', value: '—', color: 'text-emerald-600' },
          { label: 'N2 en curso', value: '—', color: 'text-violet-600' },
          { label: 'Feedbacks recibidos', value: '—', color: 'text-amber-600' },
        ].map(s => (
          <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm text-center opacity-50">
            <p class={`text-2xl font-bold font-mono mb-1 ${s.color}`}>{s.value}</p>
            <p class="text-xs text-slate-500">{s.label}</p>
          </div>
        ))}
      </div>

      <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase mb-4">TABLA DE MONKEYS — PENDIENTE</p>
      <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden opacity-50">
        <div class="bg-slate-50 border-b border-slate-200 px-5 py-3 grid grid-cols-5 gap-4">
          {['Email', 'Nivel actual', 'N1', 'N2/N3', 'Última actividad'].map(h => (
            <p class="font-mono text-[10px] uppercase tracking-widest text-slate-400">{h}</p>
          ))}
        </div>
        {[1, 2, 3].map(() => (
          <div class="border-b border-slate-100 px-5 py-3 grid grid-cols-5 gap-4">
            {['—', '—', '—', '—', '—'].map(v => (
              <p class="text-xs text-slate-400 font-mono">{v}</p>
            ))}
          </div>
        ))}
      </div>
    </section>
  ) : (
    <section class="py-12">
      <div class="bg-rose-50 border border-rose-200 rounded-2xl p-6 max-w-lg mb-8">
        <p class="font-mono text-[10px] tracking-widest text-rose-700 uppercase mb-2">SEGURIDAD</p>
        <p class="text-sm text-slate-700 leading-relaxed">
          Este panel aún no tiene autenticación server-side. No expongas datos sensibles hasta implementar RLS y verificación de rol admin en Supabase.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-8" id="stats-grid">
        {[
          { label: 'Monkeys registrados', id: 'stat-total', color: 'text-emerald-600' },
          { label: 'N1 completados', id: 'stat-n1', color: 'text-emerald-600' },
          { label: 'Feedbacks recibidos', id: 'stat-fb', color: 'text-violet-600' },
          { label: 'Leads captados', id: 'stat-leads', color: 'text-amber-600' },
        ].map(s => (
          <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm text-center">
            <p id={s.id} class={`text-2xl font-bold font-mono mb-1 ${s.color}`}>—</p>
            <p class="text-xs text-slate-500">{s.label}</p>
          </div>
        ))}
      </div>

      <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase mb-4">MONKEYS REGISTRADOS</p>
      <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
        <div class="bg-slate-50 border-b border-slate-200 px-5 py-3 grid grid-cols-4 gap-4">
          {['Email', 'Registrado', 'N1', 'N2/N3'].map(h => (
            <p class="font-mono text-[10px] uppercase tracking-widest text-slate-400">{h}</p>
          ))}
        </div>
        <div id="users-table-body">
          <div class="px-5 py-4 text-sm text-slate-400 font-mono">Cargando…</div>
        </div>
      </div>
    </section>
  )}
</Layout>

{configured && (
  <script>
    import { supabase } from '../lib/supabase';

    (async () => {
      if (!supabase) return;

      const [profilesRes, feedbackRes, leadsRes] = await Promise.all([
        supabase.from('profiles').select('id, email, created_at, role', { count: 'exact' }),
        supabase.from('feedback').select('id', { count: 'exact' }),
        supabase.from('leads').select('id', { count: 'exact' }),
      ]);

      const progressRes = await supabase
        .from('progress')
        .select('user_id, level_1_completed, level_2_completed, level_3_completed');

      const setEl = (id: string, val: string | number) => {
        const el = document.getElementById(id);
        if (el) el.textContent = String(val);
      };

      setEl('stat-total', profilesRes.count ?? '—');
      setEl('stat-n1', progressRes.data?.filter((r: any) => r.level_1_completed).length ?? '—');
      setEl('stat-fb', feedbackRes.count ?? '—');
      setEl('stat-leads', leadsRes.count ?? '—');

      const tbody = document.getElementById('users-table-body');
      if (!tbody) return;

      const profiles = profilesRes.data ?? [];
      if (profiles.length === 0) {
        tbody.innerHTML = '<div class="px-5 py-4 text-sm text-slate-400 font-mono">Sin registros todavía.</div>';
        return;
      }

      const progressMap: Record<string, any> = {};
      (progressRes.data ?? []).forEach((p: any) => { progressMap[p.user_id] = p; });

      tbody.innerHTML = profiles.map((u: any) => {
        const prog = progressMap[u.id] ?? {};
        const date = u.created_at ? new Date(u.created_at).toLocaleDateString('es-ES') : '—';
        return `<div class="border-b border-slate-100 px-5 py-3 grid grid-cols-4 gap-4">
          <p class="text-xs text-slate-700 font-mono truncate">${u.email ?? '—'}</p>
          <p class="text-xs text-slate-500">${date}</p>
          <p class="text-xs font-mono ${prog.level_1_completed ? 'text-emerald-600' : 'text-slate-400'}">${prog.level_1_completed ? '✓' : '—'}</p>
          <p class="text-xs font-mono ${(prog.level_2_completed || prog.level_3_completed) ? 'text-violet-600' : 'text-slate-400'}">${prog.level_2_completed ? 'N2✓' : ''}${prog.level_3_completed ? ' N3✓' : ''}</p>
        </div>`;
      }).join('');
    })();
  </script>
)}
