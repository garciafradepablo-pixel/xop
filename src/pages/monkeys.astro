---
import Layout from '../components/Layout.astro';
import MoonkeyLogo from '../components/MoonkeyLogo.astro';

const supabaseConfigured = !!(
  import.meta.env.PUBLIC_SUPABASE_URL &&
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

const keys = [
  {
    tag: 'Key 1',
    title: 'Operator Foundations',
    desc: 'Entorno de trabajo, CLAUDE.md, GitHub, prompts operativos y primera automatización.',
    color: 'text-emerald-700',
    bg: 'bg-emerald-50',
    border: 'border-emerald-200',
    accent: 'bg-emerald-500',
    modules: 8,
    href: '/modulos',
  },
  {
    tag: 'Key 2',
    title: 'Advanced Operator',
    desc: 'Arquitectura, debugging, refactors, MCPs, deploy y documentación operativa avanzada.',
    color: 'text-violet-700',
    bg: 'bg-violet-50',
    border: 'border-violet-200',
    accent: 'bg-violet-500',
    modules: 10,
    href: '/advanced',
  },
  {
    tag: 'Key 3',
    title: 'Migration Master',
    desc: 'Contexto migrado desde ChatGPT, sistema de prompts propio y workflows operativos documentados.',
    color: 'text-amber-700',
    bg: 'bg-amber-50',
    border: 'border-amber-200',
    accent: 'bg-amber-500',
    modules: 8,
    href: '/migrador',
  },
];

const rasgos = [
  { icon: '⬡', title: 'Sistemático', desc: 'No improvisa. Construye con estructura. Cada nivel tiene ejercicios reales y entregables concretos.' },
  { icon: '⬡', title: 'Constructor', desc: 'No memoriza teoría. Hace cosas. La formación se mide en archivos creados y sistemas que funcionan.' },
  { icon: '⬡', title: 'En progresión', desc: 'Empieza en Nivel 1 y desbloquea Keys a medida que completa el trabajo. Sin atajos.' },
  { icon: '⬡', title: 'Ecosistema', desc: 'Los Monkeys que completan la escuela pueden colaborar con el ecosistema MOONKEY XN.' },
];

const moduleStats = [
  { value: '3', label: 'Keys de progreso' },
  { value: '26', label: 'Módulos prácticos' },
  { value: '0', label: 'Código requerido' },
  { value: '100%', label: 'Basado en entregables' },
];

const rankDefs = [
  { rank: 'Monkey',  desc: 'en formación',        textCls: 'text-slate-700',  bg: 'bg-white',      border: 'border-slate-200'  },
  { rank: 'Gorilla', desc: 'ejecuta con fuerza',  textCls: 'text-violet-700', bg: 'bg-violet-50',  border: 'border-violet-200' },
  { rank: 'Eagle',   desc: 'puede volar solo',    textCls: 'text-emerald-700',bg: 'bg-emerald-50', border: 'border-emerald-200'},
];
---

<Layout title="The Monkey Lab" description="Programa piloto de operadores MOONKEY LAB. Avanza por el Operator Path y construye sistemas reales con IA.">

  <!-- Hero -->
  <section class="pb-12 border-b border-slate-200">
    <span class="label block mb-6">THE MONKEY LAB</span>
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 leading-tight mb-5">
      Bienvenido al Lab.<br/>
      <span class="text-emerald-600">Monkeys en formación.</span>
    </h1>
    <p class="text-slate-600 text-base leading-relaxed max-w-xl mb-5">
      MOONKEY LAB forma operadores que aprenden a construir con IA de forma sistemática. Los llamamos Monkeys: aprendices ágiles, curiosos y constructores de sistemas reales.
    </p>
    <p class="text-slate-900 text-xl font-bold leading-snug max-w-xl mb-6">
      No completas módulos.<br/>
      <span class="text-emerald-600">Evolucionas dentro de la jungla.</span>
    </p>
    <div class="bg-slate-50 border border-slate-200 rounded-2xl px-5 py-4 inline-flex items-center gap-3">
      <span class="font-mono text-xs text-slate-400">ETIMOLOGÍA</span>
      <span class="w-px h-4 bg-slate-300"></span>
      <span class="text-sm text-slate-600 font-medium">Moon</span>
      <span class="text-slate-300 text-xs">+</span>
      <span class="text-sm text-slate-600 font-medium">Monkey</span>
      <span class="text-slate-300 text-xs">+</span>
      <span class="text-sm text-emerald-600 font-bold">Key</span>
      <span class="w-px h-4 bg-slate-300"></span>
      <span class="text-xs text-slate-400 font-mono">visión · agilidad · acceso</span>
    </div>
  </section>

  <!-- La jungla está creciendo -->
  <section class="py-10 border-b border-slate-200">
    <div class="border-l-4 border-emerald-400 bg-emerald-50 rounded-r-2xl pl-6 pr-6 py-6 max-w-2xl">
      <p class="font-mono text-[10px] tracking-widest text-emerald-700 uppercase mb-3">LA JUNGLA ESTÁ CRECIENDO</p>
      <p class="text-slate-800 text-base leading-relaxed font-medium mb-2">
        Cada operador que completa el camino deja una señal para el siguiente.
      </p>
      <p class="text-slate-500 text-sm leading-relaxed">
        MOONKEY LAB no es una lista de módulos: es una jungla de agentes aprendiendo a operar sistemas reales.
      </p>
      <div class="flex flex-wrap gap-x-2 gap-y-1 mt-4 items-center text-xs font-mono text-slate-400">
        <span>Aprendes</span><span class="text-emerald-500">→</span>
        <span>desbloqueas rango</span><span class="text-emerald-500">→</span>
        <span>recibes badge</span><span class="text-emerald-500">→</span>
        <span>compartes avance</span><span class="text-emerald-500">→</span>
        <span>entra otro</span><span class="text-emerald-500">→</span>
        <span class="text-emerald-700 font-semibold">crece la jungla</span>
      </div>
    </div>
  </section>

  <!-- Module stats strip -->
  <section class="py-10 border-b border-slate-200">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      {moduleStats.map(s => (
        <div class="stat-pill">
          <p class="text-2xl font-bold text-slate-900 font-mono mb-1">{s.value}</p>
          <p class="text-xs text-slate-500">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Piloto actual — rank stats + XNLAB copy -->
  <section class="py-10 border-b border-slate-200">
    <span class="label block mb-2">PILOTO ACTUAL</span>
    <p class="text-slate-600 text-sm leading-relaxed max-w-xl mb-1">
      MOONKEY LAB es el laboratorio de operadores IA de XNLAB.
    </p>
    <p class="text-slate-400 text-xs font-mono mb-6">Los rangos no se autodeclaran: se validan desde XNLAB.</p>

    <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 max-w-2xl">
      <div class="bg-white border border-slate-200 rounded-xl p-4 text-center shadow-sm">
        <p id="stat-total" class="text-2xl font-bold font-mono text-slate-900 mb-1">—</p>
        <p class="text-[10px] font-mono text-slate-400 uppercase tracking-wide">Operadores</p>
      </div>
      <div class="bg-white border border-slate-200 rounded-xl p-4 text-center shadow-sm">
        <p id="stat-monkey" class="text-2xl font-bold font-mono text-slate-600 mb-1">—</p>
        <p class="text-[10px] font-mono text-slate-400 uppercase tracking-wide">Monkey</p>
      </div>
      <div class="bg-white border border-violet-200 rounded-xl p-4 text-center shadow-sm">
        <p id="stat-gorilla" class="text-2xl font-bold font-mono text-violet-600 mb-1">—</p>
        <p class="text-[10px] font-mono text-slate-400 uppercase tracking-wide">Gorilla</p>
      </div>
      <div class="bg-white border border-emerald-200 rounded-xl p-4 text-center shadow-sm">
        <p id="stat-eagle" class="text-2xl font-bold font-mono text-emerald-600 mb-1">—</p>
        <p class="text-[10px] font-mono text-slate-400 uppercase tracking-wide">Eagle</p>
      </div>
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center shadow-sm">
        <p id="stat-founder" class="text-2xl font-bold font-mono text-amber-700 mb-1">—</p>
        <p class="text-[10px] font-mono text-amber-600 uppercase tracking-wide">Founder</p>
      </div>
    </div>
  </section>

  <!-- Rangos oficiales -->
  <section class="py-10 border-b border-slate-200">
    <span class="label block mb-2">RANGOS OFICIALES</span>
    <p class="text-xs text-slate-400 font-mono mb-6">Los rangos son asignados por XNLAB según progreso real en el Operator Path. No se autodeclaran.</p>
    <div class="grid sm:grid-cols-3 gap-4 max-w-2xl">
      <div class="bg-white border-2 border-slate-200 rounded-xl p-5 shadow-sm">
        <p class="font-mono text-xs font-bold text-slate-700 mb-1">Monkey</p>
        <p class="text-sm font-semibold text-slate-900 mb-2">En formación</p>
        <p class="text-xs text-slate-500 leading-relaxed">Construye los cimientos. Cada módulo completado deja rastro en la jungla.</p>
      </div>
      <div class="bg-violet-50 border-2 border-violet-200 rounded-xl p-5 shadow-sm">
        <p class="font-mono text-xs font-bold text-violet-700 mb-1">Gorilla</p>
        <p class="text-sm font-semibold text-slate-900 mb-2">Ejecuta con fuerza</p>
        <p class="text-xs text-slate-500 leading-relaxed">Opera sistemas complejos. Arquitectura, debugging, deploy sin supervisión.</p>
      </div>
      <div class="bg-emerald-50 border-2 border-emerald-200 rounded-xl p-5 shadow-sm">
        <p class="font-mono text-xs font-bold text-emerald-700 mb-1">Eagle</p>
        <p class="text-sm font-semibold text-slate-900 mb-2">Puede volar solo</p>
        <p class="text-xs text-slate-500 leading-relaxed">Autonomía total. Sistema de prompts propio, workflows delegables.</p>
      </div>
    </div>
  </section>

  <!-- Badges de jungla -->
  <section class="py-10 border-b border-slate-200">
    <span class="label block mb-2">BADGES DE JUNGLA</span>
    <p class="text-xs text-slate-400 font-mono mb-6">Sistema de reconocimiento visual — próxima fase de gamificación.</p>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 max-w-2xl">
      {[
        { symbol: '🦉', name: 'Owl',    trait: 'Estrategia',      desc: 'Pensamiento sistémico. Ve el bosque, no solo el árbol.' },
        { symbol: '🦊', name: 'Fox',    trait: 'Caminos ocultos', desc: 'Encuentra rutas que otros no ven.' },
        { symbol: '🐆', name: 'Jaguar', trait: 'Velocidad',       desc: 'Ejecución rápida. De prompt a sistema en tiempo récord.' },
        { symbol: '🐝', name: 'Bee',    trait: 'Colaboración',    desc: 'Poliniza ideas. Comparte lo que funciona.' },
        { symbol: '🌱', name: 'Spore',  trait: 'Expansión',       desc: 'Propaga el conocimiento. Cada salida es semilla.' },
        { symbol: '🔑', name: 'Key',    trait: 'Desbloqueo',      desc: 'Abre nuevos caminos al completar un nivel.' },
      ].map(b => (
        <div class="bg-white border border-slate-200 rounded-xl px-4 py-3.5 shadow-sm flex items-start gap-3">
          <span class="text-xl shrink-0 mt-0.5">{b.symbol}</span>
          <div>
            <p class="font-mono text-xs font-bold text-slate-700 mb-0.5">{b.name} <span class="text-slate-400 font-normal">— {b.trait}</span></p>
            <p class="text-[11px] text-slate-400 leading-relaxed">{b.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Efecto espora -->
  <section class="py-10 border-b border-slate-200">
    <div class="bg-slate-900 rounded-2xl px-7 py-6 max-w-2xl">
      <p class="font-mono text-[10px] tracking-widest text-emerald-400 uppercase mb-3">EFECTO ESPORA</p>
      <p class="text-white text-sm leading-relaxed max-w-lg">
        Cuando un operador avanza, no solo desbloquea contenido: deja una ruta más clara para que otro entre, aprenda y suba de rango.
      </p>
    </div>
  </section>

  <!-- Operadores registrados — filled by script -->
  <section id="operators-section" class="py-10 border-b border-slate-200 hidden">
    <span class="label block mb-2">OPERADORES</span>
    <p class="text-xs text-slate-400 font-mono mb-5">Registrados en el programa piloto.</p>
    <div id="operators-list" class="space-y-2 max-w-2xl"></div>
    <p id="operators-error" class="hidden text-sm text-slate-400 font-mono mt-4">No se pudieron cargar los operadores todavía.</p>
  </section>

  <!-- Qué es un Monkey -->
  <section class="py-12 border-b border-slate-200">
    <span class="label block mb-6">QUÉ ES UN MONKEY</span>
    <div class="grid sm:grid-cols-2 gap-4">
      {rasgos.map(r => (
        <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm flex items-start gap-3">
          <span class="text-emerald-400 text-sm mt-0.5 shrink-0">—</span>
          <div>
            <h3 class="font-semibold text-slate-900 text-sm mb-1.5">{r.title}</h3>
            <p class="text-slate-500 text-xs leading-relaxed">{r.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Insight box inline -->
    <div class="mt-6 border-l-4 border-emerald-400 bg-emerald-50 rounded-r-xl pl-4 pr-4 py-3.5">
      <p class="font-mono text-[10px] uppercase tracking-widest font-bold mb-1.5 text-emerald-700">MENTALIDAD CLAVE</p>
      <p class="text-sm leading-relaxed text-slate-700">Un Monkey no espera que la IA sea perfecta. Aprende a guiarla, corregirla y construir sistemas que funcionen en el mundo real, no en demos.</p>
    </div>
  </section>

  <!-- Keys de progreso -->
  <section class="py-12 border-b border-slate-200">
    <span class="label block mb-2">LAS KEYS DE PROGRESO</span>
    <p class="text-slate-500 text-sm mb-8 max-w-xl">
      Cada nivel completado desbloquea una Key. Las Keys son el registro del Operator Path — el camino de formación de la metodología MOONKEY XN.
    </p>
    <div class="space-y-3">
      {keys.map((k, i) => (
        <a href={k.href} class={`flex items-stretch gap-0 ${k.bg} border ${k.border} rounded-xl overflow-hidden hover:shadow-md transition-shadow group`}>
          <div class={`${k.accent} opacity-90 w-1 shrink-0`}></div>
          <div class="flex items-start gap-4 px-5 py-4 flex-1">
            <div class="shrink-0 mt-0.5">
              <span class={`font-mono text-xs font-bold ${k.color}`}>{k.tag}</span>
              <p class={`font-mono text-[10px] text-slate-400 mt-0.5`}>{k.modules} módulos</p>
            </div>
            <div class="flex-1">
              <p class={`font-semibold text-sm mb-1 ${k.color}`}>{k.title}</p>
              <p class="text-slate-500 text-xs leading-relaxed">{k.desc}</p>
            </div>
            <span aria-hidden="true" class={`font-mono text-sm shrink-0 mt-1 opacity-0 group-hover:opacity-100 transition-opacity ${k.color}`}>→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- De Monkey a Moonkey -->
  <section class="py-12 border-b border-slate-200">
    <span class="label block mb-6">DE MONKEY A MOONKEY</span>
    <div class="bg-slate-900 rounded-2xl overflow-hidden">
      <div class="px-8 py-10">
        <span class="font-mono text-[10px] tracking-widest uppercase text-emerald-400 block mb-4">OPERATOR PATH COMPLETO</span>
        <h2 class="text-2xl font-bold text-white mb-3 leading-snug">
          Completa las 3 Keys.<br/>Conviértete en Moonkey.
        </h2>
        <p class="text-slate-400 text-sm leading-relaxed mb-8 max-w-lg">
          Un Moonkey es un operador que ha completado los tres niveles de formación y puede trabajar con IA de forma autónoma, documentada y sistemática. La base para colaborar con el ecosistema MOONKEY XN o implementar sistemas propios.
        </p>

        <div class="grid sm:grid-cols-3 gap-px bg-white/[0.06] rounded-xl overflow-hidden mb-8">
          {[
            { tag: 'KEY 1', color: 'text-emerald-400', label: 'Operator Foundations', note: 'Entorno · CLAUDE.md · Prompts' },
            { tag: 'KEY 2', color: 'text-violet-400', label: 'Advanced Operator', note: 'Arquitectura · Debug · Deploy' },
            { tag: 'KEY 3', color: 'text-amber-400', label: 'Migration Master', note: 'Migrar · Sistematizar · Delegar' },
          ].map(k => (
            <div class="bg-slate-800/60 px-4 py-5">
              <p class={`font-mono text-[10px] tracking-widest font-bold mb-2 ${k.color}`}>{k.tag}</p>
              <p class="text-white text-sm font-semibold mb-1">{k.label}</p>
              <p class="text-slate-500 text-[11px] font-mono">{k.note}</p>
            </div>
          ))}
        </div>

        <div class="border-t border-white/10 pt-6 mb-6">
          <p class="text-slate-400 text-xs leading-relaxed max-w-lg">
            Los Monkeys que completan el Operator Path están en la mejor posición para integrarse al ecosistema MOONKEY XN cuando se abran oportunidades de colaboración.
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <a href="/modulos" class="inline-block font-mono text-sm font-medium text-slate-900 bg-emerald-400 px-6 py-3 rounded-xl hover:bg-emerald-300 transition-colors">
            Empezar Nivel 1 →
          </a>
          <a href="/prueba-operador" class="inline-block font-mono text-sm text-slate-400 border border-slate-600 px-6 py-3 rounded-xl hover:border-slate-400 transition-colors">
            Test de Operador
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Programa piloto -->
  <section class="py-12 border-b border-slate-200">
    <span class="label block mb-6">PROGRAMA PILOTO</span>
    <div class="bg-emerald-50 border-2 border-emerald-200 rounded-2xl p-8 mb-6">
      <div class="flex items-start justify-between mb-4">
        <h2 class="text-xl font-bold text-slate-900">Primeros perfiles en formación.</h2>
        <span class="font-mono text-[10px] tracking-widest bg-emerald-200 text-emerald-800 px-2.5 py-1 rounded-lg uppercase">Fase inicial</span>
      </div>
      <p class="text-slate-600 text-sm leading-relaxed mb-4 max-w-lg">
        MOONKEY LAB está en fase inicial. No hay una comunidad establecida todavía: hay un programa piloto con los primeros perfiles que avanzan por el Operator Path.
      </p>
      <p class="text-slate-500 text-sm leading-relaxed mb-8 max-w-lg">
        El objetivo es simple: que los primeros Monkeys completen el recorrido, entreguen feedback real, y ayuden a afinar el sistema antes de que escale.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/modulos" class="inline-block font-mono text-sm font-medium text-white bg-emerald-500 px-6 py-3 rounded-xl hover:bg-emerald-600 transition-colors">
          Empezar Nivel 1 →
        </a>
        <a href="/prueba-operador" class="inline-block font-mono text-sm text-emerald-700 border border-emerald-300 bg-white px-6 py-3 rounded-xl hover:bg-emerald-50 transition-colors">
          Hacer Test de Operador
        </a>
        <a href="/planes" class="inline-block font-mono text-sm text-slate-600 border border-slate-200 bg-white px-6 py-3 rounded-xl hover:bg-slate-50 transition-colors">
          Ver planes
        </a>
      </div>
    </div>

    <!-- Qué esperamos -->
    <div class="bg-white border border-slate-200 rounded-2xl p-7 shadow-sm">
      <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase mb-4">QUÉ ESPERAMOS DE UN MONKEY PILOTO</p>
      <div class="grid sm:grid-cols-2 gap-3">
        {[
          'Avanzar por el Nivel 1 sin saltarse módulos',
          'Marcar progreso real al completar cada sección',
          'Entregar feedback claro cuando algo no está bien explicado',
          'Detectar confusión antes de que la IA la amplifique',
          'Probar los prompts del Arsenal en proyectos reales',
          'Documentar lo aprendido aunque sea en una nota propia',
        ].map(item => (
          <div class="flex items-start gap-2.5">
            <span class="text-emerald-400 font-mono text-xs shrink-0 mt-0.5">—</span>
            <p class="text-slate-600 text-xs leading-relaxed">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cultura del Lab -->
  <section class="py-12">
    <span class="label block mb-6">CULTURA DEL LAB</span>
    <div class="grid sm:grid-cols-2 gap-6">
      <div class="bg-slate-900 rounded-2xl p-6">
        <p class="font-mono text-[10px] tracking-widest text-emerald-400 uppercase mb-3">Lo que construimos</p>
        <ul class="space-y-2.5">
          {[
            'Sistemas documentados que funcionan sin supervisión',
            'CLAUDE.md que Claude Code entiende y respeta',
            'Prompts con estructura ROL · TAREA · FORMATO · LÍMITE',
            'Workflows delegables a agentes autónomos',
            'Conocimiento migrado y organizado desde otros modelos',
          ].map(item => (
            <li class="flex items-start gap-2.5 text-xs text-slate-400 leading-relaxed">
              <span class="text-emerald-400 shrink-0 mt-0.5">—</span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
        <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase mb-3">Lo que evitamos</p>
        <ul class="space-y-2.5">
          {[
            'Usar la IA como buscador glorificado',
            'Depender del chat sin estructura',
            'Construir sin documentar',
            'Automatizar sin entender el proceso',
            'Migrar sin criterio',
          ].map(item => (
            <li class="flex items-start gap-2.5 text-xs text-slate-500 leading-relaxed">
              <span class="text-rose-400 shrink-0 mt-0.5">×</span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

</Layout>

<!-- Script unconditional — Astro/Vite bundles it. Runtime guard handles unconfigured case. -->
<script>
  import { supabase } from '../lib/supabase';

  const RANK: Record<string, { label: string; textCls: string; borderCls: string }> = {
    monkey:  { label: 'Monkey · en formación',        textCls: 'text-slate-600',   borderCls: 'border-slate-200'  },
    gorilla: { label: 'Gorilla · ejecuta con fuerza', textCls: 'text-violet-600',  borderCls: 'border-violet-200' },
    eagle:   { label: 'Eagle · puede volar solo',     textCls: 'text-emerald-600', borderCls: 'border-emerald-300' },
  };

  function esc(s: string | null | undefined): string {
    if (s == null) return '';
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function maskedEmail(email: string): string {
    const at = email.indexOf('@');
    if (at < 1) return '***';
    return email[0] + '***' + email.slice(at);
  }

  (async () => {
    if (!supabase) return;

    type Profile = {
      id: string;
      email: string | null;
      nickname: string | null;
      operator_goal: string | null;
      operator_rank: string | null;
      founder_badge: boolean | null;
    };

    const setEl = (id: string, val: string | number) => {
      const el = document.getElementById(id);
      if (el) el.textContent = String(val);
    };

    try {
      const { data, error } = await supabase
        .from('profiles')
        .select('id, email, nickname, operator_goal, operator_rank, founder_badge')
        .order('created_at', { ascending: true });

      if (error) throw error;

      const profiles = (data ?? []) as Profile[];
      const total    = profiles.length;
      const nMonkey  = profiles.filter(p => !p.operator_rank || p.operator_rank === 'monkey').length;
      const nGorilla = profiles.filter(p => p.operator_rank === 'gorilla').length;
      const nEagle   = profiles.filter(p => p.operator_rank === 'eagle').length;
      const nFounder = profiles.filter(p => p.founder_badge === true).length;

      setEl('stat-total',   total);
      setEl('stat-monkey',  nMonkey);
      setEl('stat-gorilla', nGorilla);
      setEl('stat-eagle',   nEagle);
      setEl('stat-founder', nFounder);

      // Show operator roster
      const section = document.getElementById('operators-section');
      const listEl  = document.getElementById('operators-list');
      if (section) section.classList.remove('hidden');

      if (!listEl) return;

      if (total === 0) {
        listEl.innerHTML = '<p class="text-sm text-slate-400 font-mono">Sin operadores registrados aún.</p>';
        return;
      }

      // Sort: founders first, then eagle → gorilla → monkey
      const ORDER: Record<string, number> = { eagle: 0, gorilla: 1, monkey: 2 };
      const sorted = [...profiles].sort((a, b) => {
        if (a.founder_badge && !b.founder_badge) return -1;
        if (!a.founder_badge && b.founder_badge) return  1;
        const ra = ORDER[a.operator_rank ?? 'monkey'] ?? 2;
        const rb = ORDER[b.operator_rank ?? 'monkey'] ?? 2;
        return ra - rb;
      });

      listEl.innerHTML = sorted.map(p => {
        const rank    = RANK[p.operator_rank ?? 'monkey'] ?? RANK['monkey'];
        const display = p.nickname
          ? esc(p.nickname)
          : p.email ? esc(maskedEmail(p.email)) : 'Operador';

        const goalHtml = p.operator_goal
          ? `<p class="text-xs text-slate-400 leading-relaxed mt-1">${esc(p.operator_goal)}</p>`
          : '';

        const founderBadge = p.founder_badge
          ? '<span class="font-mono text-[10px] px-2 py-0.5 rounded-full bg-amber-50 border border-amber-200 text-amber-700">Founder · XNLAB Studio</span>'
          : '';

        return `<div class="bg-white border border-slate-200 rounded-xl px-5 py-4 hover:border-slate-300 hover:shadow-sm transition-all">
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <span class="text-sm font-semibold text-slate-900">${display}</span>
            <span class="font-mono text-[10px] px-2.5 py-0.5 rounded-full border font-medium ${rank.borderCls} ${rank.textCls}">${esc(rank.label)}</span>
            ${founderBadge}
          </div>
          ${goalHtml}
        </div>`;
      }).join('');

    } catch {
      const errEl = document.getElementById('operators-error');
      if (errEl) errEl.classList.remove('hidden');
    }
  })();
</script>
