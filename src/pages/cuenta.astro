---
import Layout from '../components/Layout.astro';
import AnimalIcon from '../components/AnimalIcon.astro';
import { resolveLocale, localizedPath, useTranslations } from '../i18n/utils';

const configured = !!(
  import.meta.env.PUBLIC_SUPABASE_URL &&
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const t = useTranslations(locale);
---

<Layout
  title={t('cuenta.meta.title')}
  description={t('cuenta.meta.desc')}
>
  <section class="pb-10 border-b border-slate-200">
    <span class="label block mb-4">{t('cuenta.label')}</span>
    <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight mb-4">{t('cuenta.h1')}</h1>
    <p class="text-slate-600 text-base leading-relaxed max-w-md">
      {t('cuenta.intro')}
    </p>
  </section>

  <!-- Welcome panel — shown by JS only on the post-registration redirect -->
  <section id="welcome-panel" class="hidden py-6">
    <div class="rounded-2xl overflow-hidden max-w-md" style="background:linear-gradient(160deg,#030b05 0%,#06140b 55%,#0a1a0c 100%);border:1px solid rgba(52,211,153,0.16);box-shadow:0 0 44px rgba(52,211,153,0.05)">
      <div class="px-6 sm:px-7 py-7">
        <p class="font-mono text-[9px] tracking-[0.4em] uppercase font-bold mb-4" style="color:rgba(52,211,153,0.5)">◆ MOONKEY LAB</p>
        <h2 class="text-2xl font-bold mb-3" style="color:#f0fdf4">{t('acct.welcome.title')}</h2>
        <p class="text-sm leading-relaxed mb-2" style="color:rgba(226,232,240,0.85)">{t('acct.welcome.line1')}</p>
        <p class="text-sm leading-relaxed mb-1" style="color:rgba(148,163,184,0.8)">{t('acct.welcome.line2')}</p>
        <p class="text-base font-semibold mb-5" style="color:#34d399">{t('acct.welcome.line3')}</p>
        <div class="flex gap-2">
          <button
            id="welcome-copy"
            class="flex-1 font-mono text-xs font-medium text-white bg-emerald-500 px-4 py-2.5 rounded-xl hover:bg-emerald-600 transition-colors"
          >
            {t('acct.welcome.copy')}
          </button>
          <button
            id="welcome-share"
            class="flex-1 font-mono text-xs font-medium px-4 py-2.5 rounded-xl transition-colors inline-flex items-center justify-center gap-1.5"
            style="color:#34d399;border:1px solid rgba(52,211,153,0.35);background:rgba(52,211,153,0.06)"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
            </svg>
            {t('acct.welcome.share')}
          </button>
        </div>
        <div id="welcome-reinforcement" class="hidden mt-3">
          <p class="text-sm font-semibold" style="color:#34d399">{t('acct.reinforce.1')}</p>
          <p class="text-xs mt-0.5" style="color:rgba(148,163,184,0.7)">{t('acct.reinforce.2')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Auth state — filled by script -->
  <section class="py-10 border-b border-slate-200">
    <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase mb-4">{t('cuenta.status.label')}</p>

    {!configured && (
      <div class="bg-amber-50 border border-amber-200 rounded-xl px-5 py-4 max-w-sm">
        <p class="text-sm font-medium text-amber-800 mb-1">{t('cuenta.status.pending.title')}</p>
        <p class="text-xs text-slate-500 leading-relaxed">{t('cuenta.status.pending.desc')}</p>
      </div>
    )}

    {configured && (
      <div id="account-state">
        <div id="loading-state" class="text-sm text-slate-400 font-mono">Comprobando sesión…</div>
        <div id="logged-out-state" class="hidden">
          <div class="bg-slate-50 border border-slate-200 rounded-xl px-5 py-4 max-w-sm mb-4">
            <p class="text-sm font-medium text-slate-700 mb-1">Sin sesión activa</p>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">Tu progreso local sigue guardado en este dispositivo.</p>
            <a href="/login" class="inline-block font-mono text-xs font-medium text-emerald-600 border border-emerald-300 px-3 py-1.5 rounded-lg hover:bg-emerald-50 transition-colors">
              Entrar con email →
            </a>
          </div>
        </div>
        <div id="logged-in-state" class="hidden">
          <div class="bg-emerald-50 border border-emerald-200 rounded-xl px-5 py-4 max-w-sm mb-4">
            <p class="font-mono text-[10px] tracking-widest text-emerald-700 uppercase mb-2">SESIÓN ACTIVA</p>
            <p id="user-email" class="text-sm font-medium text-slate-900 mb-3"></p>
            <button
              id="logout-btn"
              class="font-mono text-xs text-slate-500 border border-slate-200 px-3 py-1.5 rounded-lg hover:bg-slate-100 transition-colors"
            >
              Cerrar sesión
            </button>
          </div>
        </div>
      </div>
    )}
  </section>

  <!-- Monkey profile — shown by script when session is active -->
  {configured && (
    <section id="monkey-profile-section" class="py-10 border-b border-slate-200 hidden">
      <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase mb-5">PERFIL MONKEY</p>

      <!-- MONKEY ID — dark atmospheric identity card -->
      <div class="max-w-sm mb-6 rounded-2xl overflow-hidden" style="background:linear-gradient(160deg,#030b05 0%,#060e08 60%,#0a1a0c 100%);border:1px solid rgba(52,211,153,0.14);box-shadow:0 0 40px rgba(52,211,153,0.04)">
        <!-- Header strip -->
        <div class="flex items-center justify-between px-5 pt-4 pb-3" style="border-bottom:1px solid rgba(255,255,255,0.05)">
          <span class="font-mono text-[9px] tracking-widest uppercase font-bold" style="color:#34d399">MONKEY ID</span>
          <!-- Moon crescent micro icon -->
          <svg width="14" height="14" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" style="opacity:0.5">
            <defs><mask id="id-moon"><rect width="20" height="20" fill="white"/><circle cx="13" cy="7" r="6" fill="black"/></mask></defs>
            <circle cx="8" cy="10" r="7" fill="#34d399" mask="url(#id-moon)"/>
          </svg>
        </div>
        <!-- Identity body -->
        <div class="px-5 py-4">
          <p id="pf-card-email" class="text-[11px] font-mono mb-1" style="color:rgba(148,163,184,0.7)"></p>
          <p id="pf-card-ceo" class="font-mono text-[9px] tracking-widest uppercase hidden mb-1" style="color:#fbbf24">CEO · XNLAB Studio</p>
          <p id="pf-card-nickname" class="text-base font-bold hidden mb-1" style="color:#f0fdf4"></p>
          <p id="pf-card-goal" class="text-[11px] hidden mb-3" style="color:rgba(148,163,184,0.6)"></p>
          <p id="pf-card-level" class="font-mono text-[9px] tracking-widest uppercase hidden mt-2" style="color:#34d399"></p>
          <p id="pf-card-rank" class="font-mono text-[9px] tracking-widest uppercase hidden mt-1.5" style="color:rgba(148,163,184,0.45)"></p>
          <p id="pf-card-founder" class="font-mono text-[9px] tracking-widest uppercase hidden mt-1" style="color:#fbbf24">Founder · XNLAB Studio</p>
          <p id="pf-card-elephant" class="font-mono text-[9px] tracking-widest uppercase hidden mt-0.5" style="color:rgba(52,211,153,0.55)">Elephant · Founder Archetype</p>
        </div>
      </div>

      <!-- Posición en la jungla — filled by script -->
      <div id="pf-jungle-card" class="hidden bg-slate-50 border border-slate-200 rounded-xl px-5 py-4 max-w-sm mb-6">
        <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase mb-3">TU POSICIÓN EN LA JUNGLA</p>
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span id="pf-jungle-rank" class="font-mono text-xs font-bold px-2.5 py-0.5 rounded-full border"></span>
          <span class="text-slate-300 text-xs">→</span>
          <span id="pf-jungle-next" class="font-mono text-xs text-slate-400"></span>
        </div>
        <p id="pf-jungle-desc" class="text-xs text-slate-500 leading-relaxed"></p>
      </div>

      <form id="profile-form" class="max-w-sm space-y-4" novalidate>
        <div>
          <label for="pf-nickname" class="block text-sm font-medium text-slate-700 mb-1.5">Nickname</label>
          <input
            id="pf-nickname" name="nickname" type="text" maxlength="40"
            placeholder="Cómo quieres que te llamen"
            class="w-full font-mono text-sm border border-slate-300 rounded-xl px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:border-transparent"
          />
        </div>
        <div>
          <label for="pf-goal" class="block text-sm font-medium text-slate-700 mb-1.5">¿Qué quieres lograr?</label>
          <select
            id="pf-goal" name="operator_goal"
            class="w-full font-mono text-sm border border-slate-300 rounded-xl px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:border-transparent bg-white"
          >
            <option value="">Elige tu objetivo</option>
            <option value="operar-ia">Operar la IA con criterio</option>
            <option value="producto">Construir y lanzar productos</option>
            <option value="datos">Datos, backend y automatización</option>
            <option value="mercados">Mercados, trading, research</option>
            <option value="marca">Diseño, marca y contenido</option>
            <option value="seguridad">Seguridad y operaciones</option>
            <option value="explorar">Aún explorando</option>
          </select>
        </div>
        <div id="pf-level-field">
          <label for="pf-level" class="block text-sm font-medium text-slate-700 mb-1.5">Nivel de experiencia</label>
          <select
            id="pf-level" name="experience_level"
            class="w-full font-mono text-sm border border-slate-300 rounded-xl px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:border-transparent bg-white"
          >
            <option value="">Selecciona tu nivel</option>
            <option value="starter">Empezando — poca o ninguna experiencia técnica</option>
            <option value="builder">Construyo con IA, pero aún sin sistema</option>
            <option value="operator">Opero sistemas reales en producción</option>
            <option value="team">Formo o dirijo a otros operadores</option>
          </select>
        </div>

        <p id="pf-error" class="hidden text-xs text-rose-600 font-mono border border-rose-200 bg-rose-50 rounded-lg px-3 py-2"></p>

        <div class="flex items-center gap-4">
          <button
            type="submit" id="pf-submit"
            class="font-mono text-xs font-medium text-white bg-emerald-500 px-5 py-2 rounded-lg hover:bg-emerald-600 transition-colors disabled:opacity-50"
          >
            Guardar perfil →
          </button>
          <p id="pf-status" class="hidden text-xs font-mono text-emerald-700"></p>
        </div>
      </form>
    </section>
  )}

  <!-- CEO dashboard — shown by script only for CEO/founder/admin -->
  {configured && (
    <section id="ceo-section" class="py-10 border-b border-slate-200 hidden">
      <div class="flex items-center justify-between gap-4 mb-6 flex-wrap">
        <p class="font-mono text-[10px] tracking-widest text-amber-600 uppercase">PANEL CEO · XNLAB STUDIO</p>
        <a href="/admin" class="font-mono text-[11px] text-slate-500 border border-slate-200 px-3 py-1.5 rounded-lg hover:border-emerald-300 hover:text-emerald-600 transition-colors">Gestión completa →</a>
      </div>

      <div class="grid grid-cols-3 gap-3 max-w-md mb-8">
        <div class="bg-white border border-slate-200 rounded-xl p-4 text-center shadow-sm">
          <p id="ceo-stat-link" class="text-2xl font-bold font-mono mb-1 text-emerald-600">—</p>
          <p class="text-[10px] text-slate-500 leading-tight">Con tu enlace</p>
        </div>
        <div class="bg-white border border-slate-200 rounded-xl p-4 text-center shadow-sm">
          <p id="ceo-stat-ref" class="text-2xl font-bold font-mono mb-1 text-violet-600">—</p>
          <p class="text-[10px] text-slate-500 leading-tight">Referidos directos</p>
        </div>
        <div class="bg-white border border-slate-200 rounded-xl p-4 text-center shadow-sm">
          <p id="ceo-stat-ops" class="text-2xl font-bold font-mono mb-1 text-slate-900">—</p>
          <p class="text-[10px] text-slate-500 leading-tight">Operadores</p>
        </div>
      </div>

      <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase mb-3">GENTE CON TU ENLACE</p>
      <p class="text-slate-500 text-xs mb-4 max-w-lg">Cada persona que hizo el perfil de operador desde tu enlace — virtudes, objetivo y constelación de entrada, para filtrar a quién formar.</p>
      <div id="ceo-link-list" class="space-y-2 max-w-2xl mb-10"></div>

      <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase mb-3">QUIÉN TRABAJA</p>
      <p class="text-slate-500 text-xs mb-4 max-w-lg">Operadores registrados en el ecosistema, con su rango, objetivo y nivel.</p>
      <div id="ceo-ops-list" class="space-y-2 max-w-2xl"></div>
    </section>
  )}

  <!-- Invitar operador — always visible; auth state managed by JS -->
  <section id="invite-section" class="py-10 border-b border-slate-200">
    <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase mb-3">{t('acct.invite.label')}</p>
    <div class="max-w-md">
      <p class="text-slate-600 text-sm leading-relaxed mb-5">
        {t('acct.invite.desc')}
      </p>
      <!-- Static fallback when auth not configured -->
      {!configured && (
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-5 py-5 mb-3">
          <a
            href={localizedPath('/', locale)}
            class="inline-flex items-center gap-2 font-mono text-sm font-medium text-white bg-emerald-500 px-5 py-2.5 rounded-xl hover:bg-emerald-600 transition-colors"
          >
            Compartir Moonkey →
          </a>
          <p class="font-mono text-[11px] text-emerald-700 opacity-60 mt-4">
            Tu enlace personal aparecerá al iniciar sesión.
          </p>
        </div>
      )}
      <!-- Not logged in: show login prompt (hidden, shown by JS) -->
      {configured && (
        <div id="invite-login-prompt" class="hidden">
          <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-5 py-5 mb-3">
            <a
              href={localizedPath('/', locale)}
              class="inline-flex items-center gap-2 font-mono text-sm font-medium text-white bg-emerald-500 px-5 py-2.5 rounded-xl hover:bg-emerald-600 transition-colors"
            >
              Compartir Moonkey →
            </a>
            <p class="font-mono text-[11px] text-emerald-700 opacity-60 mt-4">
              Tu enlace personal aparecerá al iniciar sesión.
            </p>
          </div>
        </div>
      )}
      <!-- Logged in: invite link area (hidden, shown by JS) -->
      <div id="invite-link-area" class="hidden">
        <label for="invite-link" class="block font-mono text-xs text-emerald-600 uppercase tracking-widest mb-1.5">Tu enlace</label>
        <input
          id="invite-link" type="text" readonly value=""
          class="w-full font-mono text-xs bg-emerald-50 border border-emerald-300 rounded-xl px-4 py-2.5 text-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-400 mb-2"
        />
        <div class="flex gap-2">
          <button
            id="invite-copy"
            class="flex-1 font-mono text-xs font-medium text-white bg-emerald-500 px-4 py-2.5 rounded-xl hover:bg-emerald-600 transition-colors"
          >
            {t('acct.invite.copy')}
          </button>
          <button
            id="invite-share"
            class="flex-1 font-mono text-xs font-medium text-emerald-700 bg-white border border-emerald-300 px-4 py-2.5 rounded-xl hover:bg-emerald-50 transition-colors inline-flex items-center justify-center gap-1.5"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
            </svg>
            {t('acct.invite.share')}
          </button>
        </div>
        <div id="invite-reinforcement" class="hidden mt-3">
          <p class="text-sm font-semibold text-slate-800">{t('acct.reinforce.1')}</p>
          <p class="text-xs text-slate-500 mt-0.5">{t('acct.reinforce.2')}</p>
        </div>
        <div class="mt-4 pt-3 border-t border-slate-100">
          <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase mb-1">{t('acct.invite.count.label')}</p>
          <p id="invite-count" class="font-mono text-2xl font-bold text-slate-900 mb-3">0</p>
          <p class="font-mono text-[10px] text-slate-400 leading-relaxed">
            {t('acct.invite.privacy1')}<br />{t('acct.invite.privacy2')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Referral dashboard — shown by JS when logged in (PARTS 2 + 4) -->
  <section id="referral-section" class="py-10 border-b border-slate-200 hidden">
    <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase mb-4">{t('acct.ref.label')}</p>

    <!--
      TODO PART 3 — future data model (no implementation yet):
      invited_users    → COUNT(*) FROM auth.users WHERE raw_user_meta_data->>'referred_by' = myCode
      registered_users → subset of above who completed ≥1 module (join progress table)
      completed_proofs → subset who completed a full level proof (join proofs table)
      When implemented, update #ref-sent, #ref-registered, #ref-proofs via JS.
    -->
    <div class="max-w-sm mb-8">
      <div class="bg-white border border-slate-200 rounded-xl overflow-hidden divide-y divide-slate-100">
        <div class="flex items-center justify-between px-5 py-3.5">
          <p class="text-sm text-slate-600">{t('acct.ref.sent')}</p>
          <p id="ref-sent" class="font-mono text-base font-bold text-slate-900">0</p>
        </div>
        <div class="flex items-center justify-between px-5 py-3.5">
          <p class="text-sm text-slate-600">{t('acct.ref.registered')}</p>
          <p id="ref-registered" class="font-mono text-base font-bold text-slate-900">0</p>
        </div>
        <div class="flex items-center justify-between px-5 py-3.5">
          <p class="text-sm text-slate-600">{t('acct.ref.proofs')}</p>
          <p id="ref-proofs" class="font-mono text-base font-bold text-slate-900">0</p>
        </div>
      </div>
    </div>

    <!-- EMERALD connection (PART 4) — no CTA, no page, no signup -->
    <div class="max-w-sm rounded-2xl overflow-hidden" style="background:linear-gradient(160deg,#030712 0%,#040d0d 55%,#030712 100%);border:1px solid rgba(52,211,153,0.12);">
      <div class="px-5 py-6">
        <p class="font-mono text-[9px] tracking-[0.35em] uppercase font-bold mb-4" style="color:rgba(52,211,153,0.5)">◆ {t('acct.emerald.label')}</p>
        <p class="text-sm leading-relaxed mb-1" style="color:rgba(226,232,240,0.8)">{t('acct.emerald.line1')}</p>
        <p class="text-sm leading-relaxed mb-5" style="color:rgba(226,232,240,0.8)">{t('acct.emerald.line2')}</p>
        <p class="font-mono text-[10px] tracking-widest uppercase" style="color:rgba(148,163,184,0.4)">{t('acct.emerald.soon')}</p>
      </div>
    </div>
  </section>

  <!-- Local progress summary -->
  <section class="py-10 border-b border-slate-200">
    <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase mb-5">{t('cuenta.progress.label')}</p>
    <div class="grid sm:grid-cols-3 gap-3 max-w-2xl" id="progress-summary">
      <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
        <div class="flex items-center gap-2.5 mb-3">
          <span class="w-8 h-8 rounded-full flex items-center justify-center shrink-0 ring-1 ring-slate-900/5" style="background:#1e293b">
            <AnimalIcon name="monkey" color="#94a3b8" bg="#1e293b" size={16} />
          </span>
          <p class="font-mono text-[10px] text-emerald-600 uppercase tracking-widest">KEY 1</p>
        </div>
        <p id="l1-count" class="text-2xl font-bold text-slate-900 font-display">—/8</p>
        <p class="text-[11px] text-slate-400">{t('cuenta.progress.modules')}</p>
      </div>
      <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
        <div class="flex items-center gap-2.5 mb-3">
          <span class="w-8 h-8 rounded-full flex items-center justify-center shrink-0 ring-1 ring-slate-900/5" style="background:#1e1b4b">
            <AnimalIcon name="gorilla" color="#a78bfa" bg="#1e1b4b" size={16} />
          </span>
          <p class="font-mono text-[10px] text-violet-600 uppercase tracking-widest">KEY 2</p>
        </div>
        <p id="l2-count" class="text-2xl font-bold text-slate-900 font-display">—/10</p>
        <p class="text-[11px] text-slate-400">{t('cuenta.progress.modules')}</p>
      </div>
      <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
        <div class="flex items-center gap-2.5 mb-3">
          <span class="w-8 h-8 rounded-full flex items-center justify-center shrink-0 ring-1 ring-slate-900/5" style="background:#022c22">
            <AnimalIcon name="panda" color="#34d399" bg="#022c22" size={16} />
          </span>
          <p class="font-mono text-[10px] text-amber-600 uppercase tracking-widest">KEY 3</p>
        </div>
        <p id="l3-count" class="text-2xl font-bold text-slate-900 font-display">—/8</p>
        <p class="text-[11px] text-slate-400">{t('cuenta.progress.sections')}</p>
      </div>
    </div>
    <p class="text-[11px] text-slate-400 font-mono mt-4">{t('cuenta.progress.note')}</p>
  </section>

  <!-- Cloud sync note -->
  {configured && (
    <section class="py-10 border-b border-slate-200">
      <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase mb-4">SINCRONIZACIÓN EN NUBE</p>
      <div class="bg-slate-50 border border-slate-200 rounded-xl px-5 py-5 max-w-md">
        <p class="text-sm text-slate-600 leading-relaxed mb-3" id="sync-message">
          Inicia sesión para sincronizar tu progreso entre dispositivos.
        </p>
        <button
          id="sync-btn"
          class="hidden font-mono text-xs font-medium text-emerald-600 border border-emerald-300 px-3 py-1.5 rounded-lg hover:bg-emerald-50 transition-colors"
        >
          Sincronizar ahora →
        </button>
        <p id="sync-result" class="hidden text-xs text-emerald-700 font-mono mt-2"></p>
      </div>
    </section>
  )}

  <!-- Qué hacer ahora -->
  <section class="py-10">
    <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase mb-5">{t('cuenta.next.label')}</p>
    <div class="space-y-3 max-w-lg">
      <a href={localizedPath('/modulos', locale)} class="flex items-start gap-4 bg-white border border-slate-200 rounded-xl px-5 py-4 hover:border-emerald-300 hover:shadow-sm transition-all group">
        <span class="font-mono text-[10px] tracking-widest text-emerald-500 uppercase mt-0.5 shrink-0">01</span>
        <div class="flex-1">
          <p class="text-sm font-semibold text-slate-900 group-hover:text-emerald-700 transition-colors mb-0.5">{t('cuenta.next.1.title')}</p>
          <p class="text-xs text-slate-500 leading-relaxed">{t('cuenta.next.1.desc')}</p>
        </div>
        <span class="text-slate-300 group-hover:text-emerald-400 transition-colors font-mono text-sm shrink-0 mt-0.5">→</span>
      </a>
      <a href={localizedPath('/prueba-operador', locale)} class="flex items-start gap-4 bg-white border border-slate-200 rounded-xl px-5 py-4 hover:border-sky-300 hover:shadow-sm transition-all group">
        <span class="font-mono text-[10px] tracking-widest text-sky-500 uppercase mt-0.5 shrink-0">02</span>
        <div class="flex-1">
          <p class="text-sm font-semibold text-slate-900 group-hover:text-sky-700 transition-colors mb-0.5">{t('cuenta.next.2.title')}</p>
          <p class="text-xs text-slate-500 leading-relaxed">{t('cuenta.next.2.desc')}</p>
        </div>
        <span class="text-slate-300 group-hover:text-sky-400 transition-colors font-mono text-sm shrink-0 mt-0.5">→</span>
      </a>
      <a href={localizedPath('/monkeys', locale)} class="flex items-start gap-4 bg-white border border-slate-200 rounded-xl px-5 py-4 hover:border-violet-300 hover:shadow-sm transition-all group">
        <span class="font-mono text-[10px] tracking-widest text-violet-500 uppercase mt-0.5 shrink-0">03</span>
        <div class="flex-1">
          <p class="text-sm font-semibold text-slate-900 group-hover:text-violet-700 transition-colors mb-0.5">{t('cuenta.next.3.title')}</p>
          <p class="text-xs text-slate-500 leading-relaxed">{t('cuenta.next.3.desc')}</p>
        </div>
        <span class="text-slate-300 group-hover:text-violet-400 transition-colors font-mono text-sm shrink-0 mt-0.5">→</span>
      </a>
    </div>
  </section>
</Layout>

<!-- Capture the post-registration redirect synchronously, before Supabase
     consumes and clears the auth hash. Used to show the welcome panel once. -->
<script is:inline>
  window.__mkFreshAuth = /[#&?]type=(signup|invite)/.test(
    (location.hash || '') + (location.search || '')
  );
</script>

<script>
  // Read local progress
  (function () {
    const l1c = Array.from({ length: 8 }, (_, i) => localStorage.getItem(`moonkey_level_1_module_${i}`) === 'true').filter(Boolean).length;
    const l2c = Array.from({ length: 10 }, (_, i) => localStorage.getItem(`moonkey_level_2_module_${i + 1}`) === 'true').filter(Boolean).length;
    const l3c = Array.from({ length: 8 }, (_, i) => localStorage.getItem(`moonkey_level_3_section_${i + 1}`) === 'true').filter(Boolean).length;

    const l1done = localStorage.getItem('moonkey_level_1_completed') === 'true';
    const l2done = localStorage.getItem('moonkey_level_2_completed') === 'true';
    const l3done = localStorage.getItem('moonkey_level_3_completed') === 'true';

    const el1 = document.getElementById('l1-count');
    const el2 = document.getElementById('l2-count');
    const el3 = document.getElementById('l3-count');
    if (el1) {
      el1.textContent = l1done ? '✓ Completo' : `${l1c}/8`;
      if (l1done) el1.classList.add('text-emerald-600', 'text-base');
    }
    if (el2) {
      el2.textContent = l2done ? '✓ Completo' : `${l2c}/10`;
      if (l2done) el2.classList.add('text-emerald-600', 'text-base');
    }
    if (el3) {
      el3.textContent = l3done ? '✓ Completo' : `${l3c}/8`;
      if (l3done) el3.classList.add('text-emerald-600', 'text-base');
    }
  })();
</script>

<!-- Script unconditional — Astro/Vite bundles it. Runtime guard handles unconfigured case. -->
<script>
  import { supabase } from '../lib/supabase';
  import { readLocalProgress, toSupabasePayload } from '../lib/progress';

  const LEVEL_LABELS: Record<string, string> = {
    starter:  'Empezando',
    builder:  'Construye con IA, sin sistema',
    operator: 'Opera sistemas reales',
    team:     'Forma o dirige operadores',
  };

  const GOAL_LABELS: Record<string, string> = {
    'operar-ia': 'Operar la IA con criterio',
    producto:    'Construir y lanzar productos',
    datos:       'Datos, backend y automatización',
    mercados:    'Mercados, trading, research',
    marca:       'Diseño, marca y contenido',
    seguridad:   'Seguridad y operaciones',
    explorar:    'Aún explorando',
  };

  const RANK_DESC: Record<string, string> = {
    monkey:  'Monkey · en formación',
    gorilla: 'Gorilla · ejecuta con fuerza',
    eagle:   'Panda · domina su sistema',
  };

  const CONST_LABEL: Record<string, string> = {
    'operator-core': 'Operator Core', 'data-systems': 'Data & Systems', 'builders': 'Builders',
    signal: 'Signal', 'brand-surface': 'Brand & Surface', 'ops-security': 'Ops & Security',
  };
  const esc = (s: any) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  // ── CEO dashboard: who has the link (referred intakes) + who works (operators) ──
  async function loadCeoDashboard(myId: string) {
    if (!supabase) return;
    document.getElementById('ceo-section')?.classList.remove('hidden');

    const [intakeRes, profRes] = await Promise.all([
      supabase.from('operator_intake')
        .select('created_at, ref_code, name, email, virtues, aptitude, domains, goal, time_week, recommended, note')
        .order('created_at', { ascending: false }).limit(100),
      supabase.from('profiles')
        .select('id, email, nickname, operator_goal, experience_level, operator_rank, founder_badge, role, created_at')
        .order('created_at', { ascending: true }),
    ]);

    const intakes = (intakeRes.data ?? []) as any[];
    const profs = (profRes.data ?? []) as any[];

    const setN = (id: string, v: number | string) => { const el = document.getElementById(id); if (el) el.textContent = String(v); };
    setN('ceo-stat-link', intakes.length);
    setN('ceo-stat-ops', profs.length);
    const withRef = intakes.filter((r) => r.ref_code).length;
    setN('ceo-stat-ref', withRef);

    // "Gente con tu enlace" — referred profiler intakes
    const linkList = document.getElementById('ceo-link-list');
    if (linkList) {
      linkList.innerHTML = intakes.length === 0
        ? '<p class="text-sm text-slate-400 font-mono">Aún nadie ha hecho el perfil con tu enlace.</p>'
        : intakes.map((r) => {
            const when = r.created_at ? new Date(r.created_at).toLocaleDateString() : '';
            const virtues = Array.isArray(r.virtues) ? r.virtues.slice(0, 4).join(' · ') : '';
            const rec = CONST_LABEL[r.recommended] ?? r.recommended ?? '—';
            const goal = GOAL_LABELS[r.goal] ?? r.goal ?? '';
            const lvl = LEVEL_LABELS[r.aptitude] ?? r.aptitude ?? '';
            return `
              <div class="bg-white border border-slate-200 rounded-xl px-5 py-4">
                <div class="flex flex-wrap items-center gap-2 mb-1.5">
                  ${r.name ? `<span class="text-sm font-semibold text-slate-900">${esc(r.name)}</span>` : '<span class="text-sm text-slate-400 italic">Anónimo</span>'}
                  ${r.email ? `<span class="font-mono text-[11px] text-slate-500">${esc(r.email)}</span>` : ''}
                  ${r.ref_code ? `<span class="font-mono text-[10px] px-2 py-0.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700">ref ${esc(r.ref_code)}</span>` : '<span class="font-mono text-[10px] px-2 py-0.5 rounded-full bg-slate-50 border border-slate-200 text-slate-400">directo</span>'}
                  <span class="font-mono text-[10px] px-2 py-0.5 rounded-full bg-violet-50 border border-violet-200 text-violet-700">→ ${esc(rec)}</span>
                  <span class="font-mono text-[10px] text-slate-300 ml-auto">${esc(when)}</span>
                </div>
                <p class="font-mono text-[11px] text-slate-500">${esc(goal)}${lvl ? ` · ${esc(lvl)}` : ''}${r.time_week ? ` · ${esc(r.time_week)}/sem` : ''}</p>
                ${virtues ? `<p class="font-mono text-[11px] text-slate-400 mt-0.5">${esc(virtues)}</p>` : ''}
                ${r.note ? `<p class="text-xs text-slate-400 leading-relaxed mt-1 truncate max-w-xl">${esc(r.note)}</p>` : ''}
              </div>`;
          }).join('');
    }

    // "Quién trabaja" — registered operators
    const opsList = document.getElementById('ceo-ops-list');
    if (opsList) {
      const others = profs.filter((p) => p.id !== myId);
      opsList.innerHTML = others.length === 0
        ? '<p class="text-sm text-slate-400 font-mono">Aún no hay operadores registrados además de ti.</p>'
        : others.map((p) => {
            const who = p.nickname ? esc(p.nickname) : (p.email ? esc(p.email) : 'Operador');
            const role = p.role && p.role !== 'student' ? p.role : '';
            const rank = RANK_DESC[p.operator_rank] ?? '';
            const goal = GOAL_LABELS[p.operator_goal] ?? p.operator_goal ?? '';
            const lvl = LEVEL_LABELS[p.experience_level] ?? p.experience_level ?? '';
            return `
              <div class="bg-white border border-slate-200 rounded-xl px-5 py-4">
                <div class="flex flex-wrap items-center gap-2 mb-1">
                  <span class="text-sm font-semibold text-slate-900">${who}</span>
                  ${role ? `<span class="font-mono text-[10px] px-2 py-0.5 rounded-full bg-violet-50 border border-violet-200 text-violet-700">${esc(role)}</span>` : ''}
                  ${rank ? `<span class="font-mono text-[10px] px-2 py-0.5 rounded-full bg-slate-50 border border-slate-200 text-slate-500">${esc(rank)}</span>` : ''}
                  ${p.founder_badge ? '<span class="font-mono text-[10px] px-2 py-0.5 rounded-full bg-amber-50 border border-amber-200 text-amber-700">Founder</span>' : ''}
                </div>
                ${(goal || lvl) ? `<p class="font-mono text-[11px] text-slate-500">${esc(goal)}${goal && lvl ? ' · ' : ''}${esc(lvl)}</p>` : ''}
              </div>`;
          }).join('');
    }
  }

  async function doSync(userId: string) {
    if (!supabase) return null;
    const data = readLocalProgress();
    const payload = toSupabasePayload(data, userId);
    const { error } = await supabase
      .from('progress')
      .upsert(payload, { onConflict: 'user_id' });
    if (error) console.error('[cuenta] sync error:', error.message);
    return error;
  }

  function setCardField(id: string, value: string | null | undefined) {
    const el = document.getElementById(id);
    if (!el) return;
    if (value) {
      el.textContent = value;
      el.classList.remove('hidden');
    } else {
      el.classList.add('hidden');
    }
  }

  (async () => {
    if (!supabase) return;

    const loadingEl  = document.getElementById('loading-state');
    const loggedOutEl = document.getElementById('logged-out-state');
    const loggedInEl  = document.getElementById('logged-in-state');
    const emailEl     = document.getElementById('user-email');
    const syncBtn     = document.getElementById('sync-btn') as HTMLButtonElement | null;
    const syncMsg     = document.getElementById('sync-message');
    const syncResult  = document.getElementById('sync-result');
    const logoutBtn   = document.getElementById('logout-btn');

    const { data: { session } } = await supabase.auth.getSession();

    loadingEl?.classList.add('hidden');

    if (session?.user) {
      loggedInEl?.classList.remove('hidden');
      if (emailEl) emailEl.textContent = session.user.email ?? '';

      // Show profile section immediately; seed email in card
      document.getElementById('monkey-profile-section')?.classList.remove('hidden');
      const cardEmail = document.getElementById('pf-card-email');
      if (cardEmail) cardEmail.textContent = session.user.email ?? '';

      // ── Invite link (stable code derived from user id — no backend write needed) ──
      const myCode = session.user.id.replace(/-/g, '').slice(0, 8).toUpperCase();
      // Land referred visitors on the operator profiler — they get a personalised
      // entry constellation, and their profile reaches you attributed to this code.
      const inviteLink = `${location.origin}/perfil?ref=${myCode}`;
      const inviteInput = document.getElementById('invite-link') as HTMLInputElement | null;
      if (inviteInput) inviteInput.value = inviteLink;
      document.getElementById('invite-login-prompt')?.classList.add('hidden');
      document.getElementById('invite-link-area')?.classList.remove('hidden');

      // Show referral dashboard + populate REAL counts via the secure RPC.
      document.getElementById('referral-section')?.classList.remove('hidden');
      supabase.rpc('my_referral_stats').then(({ data, error }) => {
        if (error || !data || !data[0]) return;
        const registered = Number(data[0].referred_count) || 0;
        const proofs = Number(data[0].proof_count) || 0;
        const set = (id: string, v: number) => { const el = document.getElementById(id); if (el) el.textContent = String(v); };
        set('ref-registered', registered);
        set('ref-proofs', proofs);
        set('ref-sent', registered); // operators that entered through your link
      });

      // Pre-filled share message — picked at runtime by the active locale.
      const SHARE_MSG: Record<string, string> = {
        es: 'He estado usando Moonkey Lab.\n\nNo es un curso.\nEs un campo de pruebas para operadores IA.\n\nSi te gusta construir más que consumir:\n\n' + inviteLink,
        en: "I've been using Moonkey Lab.\n\nIt's not a course.\nIt's a proving ground for AI operators.\n\nIf you enjoy building more than consuming:\n\n" + inviteLink,
        th: 'ผมใช้ Moonkey Lab อยู่\n\nไม่ใช่คอร์ส\nมันคือสนามพิสูจน์ความสามารถของ AI operator\n\nถ้าคุณชอบสร้างมากกว่าบริโภค:\n\n' + inviteLink,
        fr: "J'utilise Moonkey Lab.\n\nCe n'est pas un cours.\nC'est un terrain de preuve pour opérateurs IA.\n\nSi tu aimes construire plus que consommer :\n\n" + inviteLink,
        it: 'Sto usando Moonkey Lab.\n\nNon è un corso.\nÈ un campo di prova per operatori IA.\n\nSe ti piace costruire più che consumare:\n\n' + inviteLink,
        ch: 'Ich nutze Moonkey Lab.\n\nKein Kurs.\nEin Prüffeld für KI-Operatoren.\n\nWenn du lieber baust als konsumierst:\n\n' + inviteLink,
      };
      const htmlLang = document.documentElement.lang;
      const lang = ['en', 'th', 'fr', 'it', 'ch'].includes(htmlLang) ? htmlLang : 'es';

      // PART 5 — share reinforcement: fade-out after 3 s
      function showReinforcement(el: Element | null) {
        if (!el) return;
        const htmlEl = el as HTMLElement;
        htmlEl.classList.remove('hidden');
        htmlEl.style.opacity = '1';
        htmlEl.style.transition = '';
        setTimeout(() => {
          htmlEl.style.transition = 'opacity 0.6s ease';
          htmlEl.style.opacity = '0';
          setTimeout(() => {
            htmlEl.classList.add('hidden');
            htmlEl.style.opacity = '';
            htmlEl.style.transition = '';
          }, 600);
        }, 3000);
      }
      async function copyInvite(reinforcement: Element | null) {
        try {
          await navigator.clipboard.writeText(inviteLink);
        } catch (e) {
          if (inviteInput) { inviteInput.select(); document.execCommand('copy'); }
        }
        showReinforcement(reinforcement);
      }
      // Native share when available (WhatsApp / Telegram / iMessage / share sheet);
      // otherwise fall back to copying the invite link.
      async function shareInvite(reinforcement: Element | null) {
        const text = SHARE_MSG[lang];
        if (navigator.share) {
          try {
            await navigator.share({ title: 'MOONKEY LAB', text });
            showReinforcement(reinforcement);
            return;
          } catch (e) {
            // user cancelled — no feedback
            if ((e as DOMException)?.name === 'AbortError') return;
          }
        }
        await copyInvite(reinforcement);
      }

      const inviteReinforcement = document.getElementById('invite-reinforcement');
      document.getElementById('invite-copy')?.addEventListener('click', () => copyInvite(inviteReinforcement));
      document.getElementById('invite-share')?.addEventListener('click', () => shareInvite(inviteReinforcement));

      // ── Welcome panel — only on the post-registration redirect ──
      if ((window as any).__mkFreshAuth) {
        const welcomePanel          = document.getElementById('welcome-panel');
        const welcomeReinforcement  = document.getElementById('welcome-reinforcement');
        welcomePanel?.classList.remove('hidden');
        document.getElementById('welcome-copy')?.addEventListener('click', () => copyInvite(welcomeReinforcement));
        document.getElementById('welcome-share')?.addEventListener('click', () => shareInvite(welcomeReinforcement));
      }

      // First-touch attribution: persist captured ref into auth user_metadata
      // (no schema change). Skip self-referral and never overwrite an existing one.
      try {
        const storedRef = (localStorage.getItem('moonkey_ref') || '').toUpperCase();
        const alreadySet = (session.user.user_metadata as Record<string, unknown> | null)?.referred_by;
        if (storedRef && storedRef !== myCode && !alreadySet) {
          await supabase.auth.updateUser({
            data: { referred_by: storedRef, referred_at: new Date().toISOString() },
          });
        }
      } catch (e) {
        console.warn('[invite] attribution skipped:', e);
      }

      // Load profile + auto-sync progress in parallel
      if (syncMsg) syncMsg.textContent = 'Sincronizando progreso…';
      const [profileRes, autoError] = await Promise.all([
        supabase
          .from('profiles')
          .select('nickname, operator_goal, experience_level, operator_rank, founder_badge, role')
          .eq('id', session.user.id)
          .single(),
        doSync(session.user.id),
      ]);

      // Populate card and form
      const prof = profileRes.data as {
        nickname?: string;
        operator_goal?: string;
        experience_level?: string;
        operator_rank?: string;
        founder_badge?: boolean;
        role?: string;
      } | null;

      const isCeo = prof?.role === 'ceo' || prof?.role === 'founder' || prof?.role === 'admin' || prof?.founder_badge === true;

      if (prof) {
        setCardField('pf-card-nickname', prof.nickname ?? null);
        setCardField('pf-card-goal', prof.operator_goal ? (GOAL_LABELS[prof.operator_goal] ?? prof.operator_goal) : null);
        setCardField('pf-card-level', prof.experience_level ? (LEVEL_LABELS[prof.experience_level] ?? null) : null);
        setCardField(
          'pf-card-rank',
          prof.operator_rank ? `Rango validado por XNLAB: ${RANK_DESC[prof.operator_rank] ?? prof.operator_rank}` : null
        );
        if (prof.founder_badge) {
          document.getElementById('pf-card-founder')?.classList.remove('hidden');
          document.getElementById('pf-card-elephant')?.classList.remove('hidden');
        }

        const nickInput  = document.getElementById('pf-nickname')  as HTMLInputElement  | null;
        const goalInput  = document.getElementById('pf-goal')      as HTMLInputElement  | null;
        const levelSelect = document.getElementById('pf-level')    as HTMLSelectElement | null;
        if (nickInput   && prof.nickname)          nickInput.value   = prof.nickname;
        if (goalInput   && prof.operator_goal)     goalInput.value   = prof.operator_goal;
        if (levelSelect && prof.experience_level)  levelSelect.value = prof.experience_level;
      }

      // ── CEO mode: no student level required; show CEO identity + dashboard ──
      if (isCeo) {
        document.getElementById('pf-level-field')?.classList.add('hidden');
        document.getElementById('pf-card-ceo')?.classList.remove('hidden');
        loadCeoDashboard(session.user.id);
      }

      // Jungle position card (operator/student concept — not for CEO)
      if (!isCeo) {
        const rank = prof?.operator_rank ?? 'monkey';
        const JUNGLE_NEXT: Record<string, string> = {
          monkey:  'próximo: Gorilla',
          gorilla: 'próximo: Panda',
          eagle:   'próximo: Mentor / Network',
        };
        const JUNGLE_DESC: Record<string, string> = {
          monkey:  'Estás en formación. Cada módulo que completas es una señal para el siguiente operador.',
          gorilla: 'Ejecutas con fuerza. Ya tienes sistemas reales funcionando.',
          eagle:   'Dominas tu sistema. El siguiente paso es transmitir lo aprendido.',
        };
        const JUNGLE_CLS: Record<string, string> = {
          monkey:  'text-slate-700 border-slate-300',
          gorilla: 'text-violet-700 border-violet-300',
          eagle:   'text-emerald-700 border-emerald-300',
        };
        const jungleCard = document.getElementById('pf-jungle-card');
        const jungleRank = document.getElementById('pf-jungle-rank');
        const jungleNext = document.getElementById('pf-jungle-next');
        const jungleDesc = document.getElementById('pf-jungle-desc');
        if (jungleCard) {
          jungleCard.classList.remove('hidden');
          if (jungleRank) {
            jungleRank.textContent = RANK_DESC[rank] ?? rank;
            jungleRank.className = `font-mono text-xs font-bold px-2.5 py-0.5 rounded-full border ${JUNGLE_CLS[rank] ?? ''}`;
          }
          if (jungleNext) jungleNext.textContent = JUNGLE_NEXT[rank] ?? '';
          if (jungleDesc) jungleDesc.textContent = JUNGLE_DESC[rank] ?? '';
        }
      }

      // Sync result
      if (syncResult) {
        syncResult.textContent = autoError
          ? `Error al sincronizar: ${autoError.message}`
          : '✓ Progreso sincronizado en la nube.';
        syncResult.classList.remove('hidden');
      }
      if (syncMsg) syncMsg.textContent = autoError
        ? 'Hubo un error al sincronizar. Prueba de nuevo.'
        : 'Tu progreso está guardado en la nube.';

      syncBtn?.classList.remove('hidden');
      if (syncBtn) syncBtn.textContent = 'Sincronizar de nuevo →';

      syncBtn?.addEventListener('click', async () => {
        if (!supabase || !session?.user) return;
        syncBtn.disabled = true;
        syncBtn.textContent = 'Sincronizando…';
        if (syncResult) syncResult.classList.add('hidden');
        const manualError = await doSync(session.user.id);
        syncBtn.disabled = false;
        syncBtn.textContent = 'Sincronizar de nuevo →';
        if (syncResult) {
          syncResult.textContent = manualError
            ? `Error: ${manualError.message}`
            : '✓ Progreso sincronizado.';
          syncResult.classList.remove('hidden');
        }
      });

      // Profile form — only edits: nickname, operator_goal, experience_level
      const profileForm = document.getElementById('profile-form') as HTMLFormElement | null;
      const pfSubmit    = document.getElementById('pf-submit')    as HTMLButtonElement | null;
      const pfStatus    = document.getElementById('pf-status');
      const pfError     = document.getElementById('pf-error');

      profileForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!supabase || !profileForm || !session?.user) return;

        const nickname        = (profileForm.querySelector('[name="nickname"]')         as HTMLInputElement)?.value.trim() || null;
        const operator_goal   = (profileForm.querySelector('[name="operator_goal"]')    as HTMLInputElement)?.value.trim() || null;
        const experience_level = (profileForm.querySelector('[name="experience_level"]') as HTMLSelectElement)?.value || null;

        if (pfSubmit) { pfSubmit.disabled = true; pfSubmit.textContent = 'Guardando…'; }
        if (pfStatus) pfStatus.classList.add('hidden');
        if (pfError)  pfError.classList.add('hidden');

        const { error } = await supabase
          .from('profiles')
          .update({ nickname, operator_goal, experience_level, updated_at: new Date().toISOString() })
          .eq('id', session.user.id);

        if (pfSubmit) { pfSubmit.disabled = false; pfSubmit.textContent = 'Guardar perfil →'; }

        if (error) {
          if (pfError) { pfError.textContent = `Error: ${error.message}`; pfError.classList.remove('hidden'); }
          console.error('[cuenta] profile update error:', error.message);
        } else {
          if (pfStatus) { pfStatus.textContent = 'Perfil actualizado.'; pfStatus.classList.remove('hidden'); }
          setCardField('pf-card-nickname', nickname);
          setCardField('pf-card-goal', operator_goal ? (GOAL_LABELS[operator_goal] ?? operator_goal) : null);
          setCardField('pf-card-level', experience_level ? (LEVEL_LABELS[experience_level] ?? null) : null);
        }
      });

    } else {
      loggedOutEl?.classList.remove('hidden');
      document.getElementById('invite-login-prompt')?.classList.remove('hidden');
    }

    logoutBtn?.addEventListener('click', async () => {
      if (!supabase) return;
      await supabase.auth.signOut();
      location.href = '/';
    });
  })();
</script>
