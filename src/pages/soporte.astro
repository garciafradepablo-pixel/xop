---
import Layout from '../components/Layout.astro';
import { resolveLocale, localizedPath } from '../i18n/utils';
import { frontTr } from '../data/frontdoor.i18n';

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const tr = frontTr('soporte', locale);
const lp = (p: string) => localizedPath(p, locale);

const faqs = [
  {
    q: '¿Cómo funciona el desbloqueo de niveles?',
    a: 'El progreso se guarda en tu navegador (localStorage). Completa el Nivel 1 y haz clic en "Marcar Nivel 1 como completado" al final de la página. El Nivel 2 se desbloqueará automáticamente. Mismo sistema para el Nivel 3.',
  },
  {
    q: '¿Qué pasa si cierro el navegador?',
    a: 'Tu progreso se mantiene si usas el mismo navegador y dispositivo. Si cambias de dispositivo o borras el caché del navegador, el progreso se reinicia desde cero.',
  },
  {
    q: 'El Nivel 2 no se desbloquea. ¿Qué hago?',
    a: 'Ve a /modulos, llega al final de la página y haz clic en "Marcar Nivel 1 como completado". Si el botón ya no aparece pero el nivel sigue bloqueado, intenta desde un navegador sin modo incógnito o limpia el caché.',
  },
  {
    q: '¿Cómo reinicio mi progreso?',
    a: 'En la pantalla de inicio, al final de la página, hay un botón "Reiniciar progreso". También puedes abrir la consola del navegador (F12) y ejecutar: localStorage.clear()',
  },
  {
    q: '¿Es necesario crear una cuenta?',
    a: 'No. MOONKEY LAB funciona sin registro ni login. Todo el progreso se guarda localmente en tu navegador, sin servidores ni bases de datos.',
  },
  {
    q: '¿Cuándo estará disponible el acceso de pago?',
    a: 'Estamos en programa piloto con acceso libre. El acceso privado y los pagos se implementarán en una fase posterior. Los primeros participantes tendrán condiciones especiales.',
  },
  {
    q: '¿Puedo usar el Arsenal de Prompts aunque no haya terminado el Nivel 1?',
    a: 'Sí. El Arsenal de Prompts, el Glosario y el Test de Operador son accesibles directamente desde el menú, sin prerequisitos.',
  },
];

const resetSteps = [
  'Ve a la pantalla de inicio (/).',
  'Baja al final de la página.',
  'Haz clic en el botón "Reiniciar progreso" y confirma.',
];

const privadoItems = [
  'Acceso privado a niveles avanzados',
  'Sistema de pagos integrado',
  'Panel de progreso personal',
  'Certificados de completado',
  'Soporte directo y acompañamiento',
];
---

<Layout title={tr('Soporte y Acceso')} description={tr('Soporte técnico y preguntas frecuentes de MOONKEY LAB.')}>

  <!-- Hero -->
  <section class="pb-12 border-b border-slate-200">
    <span class="label block mb-2">{tr('SOPORTE Y ACCESO')}</span>
    <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 leading-tight mb-4">
      {tr('Estamos aquí.')}
    </h1>
    <p class="text-slate-600 text-base leading-relaxed max-w-xl">
      {tr('Dudas técnicas, problemas de acceso, información sobre el programa piloto o servicios de equipo. Aquí encuentras lo que necesitas.')}
    </p>
  </section>

  <!-- FAQ -->
  <section class="py-12 border-b border-slate-200">
    <span class="label block mb-8">{tr('PREGUNTAS FRECUENTES')}</span>
    <div class="space-y-2">
      {faqs.map((item, i) => (
        <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm accordion-item" data-reveal data-delay={i * 60}>
          <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer list-none select-none font-semibold text-slate-900 text-sm hover:bg-slate-50 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-inset">
            {tr(item.q)}
            <span class="shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-45" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </span>
          </summary>
          <div class="accordion-body px-5 pb-5 pt-1">
            <p class="text-slate-500 text-sm leading-relaxed">{tr(item.a)}</p>
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- Reiniciar progreso -->
  <section class="py-12 border-b border-slate-200">
    <span class="label block mb-6">{tr('REINICIAR PROGRESO')}</span>
    <div class="bg-rose-50 border border-rose-200 rounded-xl p-6">
      <h3 class="font-semibold text-slate-900 text-sm mb-3">{tr('Cómo reiniciar tu progreso')}</h3>
      <ol class="space-y-2 mb-5">
        {resetSteps.map((step, i) => (
          <li class="flex items-start gap-3 text-sm text-slate-600">
            <span class="font-mono text-rose-400 shrink-0">{i+1}.</span>
            {tr(step)}
          </li>
        ))}
      </ol>
      <p class="text-slate-400 text-xs font-mono">
        {tr('Alternativa técnica: consola del navegador (F12) →')} <code class="bg-rose-100 px-1.5 py-0.5 rounded">localStorage.clear()</code>
      </p>
    </div>
  </section>

  <!-- Acceso de pago próximamente -->
  <section class="py-12 border-b border-slate-200">
    <span class="label block mb-6">{tr('ACCESO PRIVADO Y PAGOS')}</span>
    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8">
      <h2 class="text-xl font-bold text-slate-900 mb-3">{tr('Acceso privado próximamente.')}</h2>
      <p class="text-slate-600 text-sm leading-relaxed mb-5 max-w-lg">
        {tr('MOONKEY LAB está en programa piloto. En una fase posterior se habilitarán:')}
      </p>
      <ul class="space-y-2.5 mb-6">
        {privadoItems.map(item => (
          <li class="flex items-center gap-2.5 text-sm text-slate-600">
            <span class="w-1.5 h-1.5 rounded-full bg-slate-300 shrink-0"></span>
            {tr(item)}
          </li>
        ))}
      </ul>
      <a href={lp('/planes')} class="inline-block font-mono text-sm font-medium text-slate-700 border border-slate-300 px-5 py-2.5 rounded-xl hover:bg-white transition-colors">
        {tr('Ver planes de acceso →')}
      </a>
    </div>
  </section>

  <!-- Contacto directo -->
  <section class="py-12">
    <span class="label block mb-6">{tr('CONTACTO DIRECTO')}</span>
    <div class="grid sm:grid-cols-2 gap-4">
      <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-6">
        <h3 class="font-semibold text-slate-900 text-sm mb-2">{tr('Programa piloto')}</h3>
        <p class="text-slate-500 text-xs leading-relaxed mb-4">
          {tr('¿Quieres acceso anticipado, recursos avanzados o tienes dudas sobre el programa? Canal de contacto privado.')}
        </p>
        <a href="mailto:garciafradepablo@gmail.com?subject=MOONKEY%20XN%20-%20Acceso%20piloto" class="font-mono text-xs font-medium text-emerald-700 hover:underline">
          {tr('→ Contacto directo')}
        </a>
      </div>
      <div class="bg-violet-50 border border-violet-200 rounded-xl p-6">
        <h3 class="font-semibold text-slate-900 text-sm mb-2">{tr('Implementación para equipos')}</h3>
        <p class="text-slate-500 text-xs leading-relaxed mb-4">
          {tr('¿Quieres esta formación para tu equipo o construir un sistema interno? Ve el proceso de colaboración.')}
        </p>
        <a href={lp('/onboarding')} class="font-mono text-xs font-medium text-violet-700 hover:underline">
          {tr('→ Ver proceso de colaboración')}
        </a>
      </div>
    </div>
  </section>

</Layout>
