].map((o) => ({ v: o.v, t: tr(o.t), d: tr(o.d) }));

const GOALS = [
  { v: 'operar-ia', c: 'operator-core', t: { es:'Operar la IA como un profesional', en:'Operate AI like a professional', th:'ปฏิบัติการ AI อย่างมืออาชีพ', fr:'Opérer l\'IA comme un professionnel', it:'Operare l\'IA come un professionista', ch:'KI wie ein Profi bedienen' } },
  { v: 'producto', c: 'builders', t: { es:'Construir y lanzar productos', en:'Build and ship products', th:'สร้างและเปิดตัวโปรดักต์', fr:'Construire et lancer des produits', it:'Costruire e lanciare prodotti', ch:'Produkte bauen und launchen' } },
  { v: 'datos', c: 'data-systems', t: { es:'Dominar datos, backend y automatización', en:'Master data, backend and automation', th:'เชี่ยวชาญข้อมูล แบ็กเอนด์ และระบบอัตโนมัติ', fr:'Maîtriser données, backend et automatisation', it:'Padroneggiare dati, backend e automazione', ch:'Daten, Backend und Automatisierung meistern' } },
  { v: 'mercados', c: 'signal', t: { es:'Investigar mercados, trading, quant', en:'Research markets, trading, quant', th:'วิจัยตลาด เทรด quant', fr:'Étudier marchés, trading, quant', it:'Studiare mercati, trading, quant', ch:'Märkte, Trading, Quant erforschen' } },
  { v: 'marca', c: 'brand-surface', t: { es:'Diseño, marca, contenido y voz', en:'Design, brand, content and voice', th:'ดีไซน์ แบรนด์ คอนเทนต์ และน้ำเสียง', fr:'Design, marque, contenu et voix', it:'Design, brand, contenuti e voce', ch:'Design, Marke, Content und Stimme' } },
  { v: 'seguridad', c: 'ops-security', t: { es:'Seguridad, operaciones e infraestructura', en:'Security, operations and infrastructure', th:'ความปลอดภัย ปฏิบัติการ และโครงสร้างพื้นฐาน', fr:'Sécurité, opérations et infrastructure', it:'Sicurezza, operazioni e infrastruttura', ch:'Sicherheit, Betrieb und Infrastruktur' } },
].map((o) => ({ v: o.v, c: o.c, t: tr(o.t) }));

const TIMES = [
  { v: 'Menos de 2h', l: { es:'Menos de 2h', en:'Less than 2h', th:'น้อยกว่า 2 ชม.', fr:'Moins de 2h', it:'Meno di 2h', ch:'Weniger als 2h' } },
  { v: '2–5h',  l: { es:'2–5h', en:'2–5h', th:'2–5 ชม.', fr:'2–5h', it:'2–5h', ch:'2–5h' } },
  { v: '5–10h', l: { es:'5–10h', en:'5–10h', th:'5–10 ชม.', fr:'5–10h', it:'5–10h', ch:'5–10h' } },
  { v: 'Más de 10h', l: { es:'Más de 10h', en:'More than 10h', th:'มากกว่า 10 ชม.', fr:'Plus de 10h', it:'Più di 10h', ch:'Mehr als 10h' } },
].map((o) => ({ v: o.v, label: tr(o.l) }));

// Compact constellation map for the client-side result renderer + client messages.
const CONST_MAP = Object.fromEntries(localizedConstellations(L).map((c) => [c.id, {
  name: c.name, tagline: c.tagline, dot: { emerald:'#10b981', sky:'#0ea5e9', violet:'#8b5cf6', amber:'#f59e0b', rose:'#f43f5e', indigo:'#6366f1' }[c.theme],
  text: c.theme,
  modules: c.modules.slice(0, 3).map((m) => m.title),
  href: localizedPath(`/constelacion/${c.id}`, L),
}]));
const CLIENT = { CONST: CONST_MAP, MSG: MSGS[L] };
const modulosHref = localizedPath('/modulos', L);
const galaxiaHref = localizedPath('/galaxia', L);
const loginHref = localizedPath('/login', L);
const privacyHref = localizedPath('/privacidad', L);
---

<Layout title={S.metaTitle} description={S.metaDesc}>

  <!-- Hero -->
  <section class="max-w-2xl hero-enter">
    <span class="label block mb-3">{S.label}</span>
    <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 leading-[1.05] mb-4">
      {S.t1}<br/>{S.t2}
    </h1>
    <p class="text-slate-500 text-base leading-relaxed mb-5" set:html={S.intro}></p>
    <div id="ref-note" class="hidden items-center gap-2 font-mono text-xs text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-lg px-4 py-2.5 max-w-md">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
      <span>{S.refNote}</span>
    </div>
  </section>

  <form id="perfil-form" class="py-10 space-y-12 max-w-2xl" novalidate>

    <!-- 1 · VIRTUDES -->
    <fieldset>
      <legend class="label block mb-1">{S.s1}</legend>
      <p class="text-slate-500 text-sm mb-4">{S.s1p}</p>
      <div class="flex flex-wrap gap-2" data-chips="virtues" role="group" aria-label={S.s1}>
        {VIRTUES.map((v) => (
          <button type="button" class="chip" data-value={v.v} aria-pressed="false">{v.label}</button>
        ))}
      </div>
    </fieldset>

    <!-- 2 · APTITUDES -->
    <fieldset>
      <legend class="label block mb-1">{S.s2}</legend>
      <p class="text-slate-500 text-sm mb-4">{S.s2p}</p>
      <div class="grid sm:grid-cols-2 gap-3" data-radio="aptitude" role="radiogroup" aria-label={S.s2}>
        {APTITUDES.map((a) => (
          <button type="button" class="opt text-left" data-value={a.v} role="radio" aria-checked="false">
            <span class="block font-semibold text-slate-900 text-sm mb-0.5">{a.t}</span>
            <span class="block text-slate-500 text-xs leading-relaxed">{a.d}</span>
          </button>
        ))}
      </div>
      <p class="text-slate-500 text-sm mt-6 mb-3">{S.s2dp}</p>
      <div class="flex flex-wrap gap-2" data-chips="domains" role="group" aria-label={S.s2dp}>
        {DOMAINS.map((d) => (
          <button type="button" class="chip" data-value={d.v} aria-pressed="false">{d.label}</button>
        ))}
      </div>
    </fieldset>

    <!-- 3 · NECESIDADES -->
    <fieldset>
      <legend class="label block mb-1">{S.s3}</legend>
      <p class="text-slate-500 text-sm mb-4">{S.s3p}</p>
      <div class="space-y-2.5" data-radio="goal" role="radiogroup" aria-label={S.s3}>
        {GOALS.map((g) => (
          <button type="button" class="opt flex items-center gap-3 w-full text-left" data-value={g.v} data-constellation={g.c} role="radio" aria-checked="false">
            <span class="font-mono text-[10px] text-slate-300 shrink-0 w-4 chip-mark">○</span>
            <span class="font-medium text-slate-800 text-sm">{g.t}</span>
          </button>
        ))}
      </div>

      <p class="text-slate-500 text-sm mt-6 mb-3">{S.s3tp}</p>
      <div class="flex flex-wrap gap-2" data-radio="time" role="radiogroup" aria-label={S.s3tp}>
        {TIMES.map((tm) => (
          <button type="button" class="chip" data-value={tm.v} role="radio" aria-checked="false">{tm.label}</button>
        ))}
      </div>

      <label for="note" class="block text-slate-500 text-sm mt-6 mb-2">{S.noteL} <span class="text-slate-400">{S.opt}</span></label>
      <textarea id="note" rows="3" maxlength="400" class="w-full text-sm bg-white border border-slate-300 rounded-xl px-4 py-3 text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-400 transition-colors" placeholder={S.noteP}></textarea>
    </fieldset>

    <!-- 4 · CONEXIÓN -->
    <fieldset>
      <legend class="label block mb-1">{S.s4}</legend>
      <p class="text-slate-500 text-sm mb-4">{S.s4p} <span class="text-slate-400">{S.opt}</span></p>
      <div class="grid sm:grid-cols-2 gap-3">
        <input id="name" type="text" autocomplete="given-name" maxlength="80" class="text-sm bg-white border border-slate-300 rounded-xl px-4 py-3 text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-400 transition-colors" placeholder={S.nameP} />
        <input id="email" type="email" autocomplete="email" maxlength="120" class="text-sm bg-white border border-slate-300 rounded-xl px-4 py-3 text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-400 transition-colors" placeholder="tu@email.com" />
      </div>
    </fieldset>

    <div>
      <p id="perfil-error" class="hidden text-sm text-rose-600 font-mono mb-3" role="alert"></p>
      <button type="submit" id="perfil-submit" class="w-full sm:w-auto font-mono text-sm font-semibold text-white bg-emerald-500 px-8 py-4 rounded-xl hover:bg-emerald-600 transition-colors shadow-sm cursor-pointer border-0">
        {S.submit}
      </button>
      <p class="font-mono text-[11px] text-slate-400 mt-3">
        {S.privacyPre} <a href={privacyHref} class="underline hover:text-slate-600">{S.privacyWord}</a>.
      </p>
    </div>
  </form>

  <!-- RESULT -->
  <section id="perfil-result" class="hidden py-8 max-w-2xl">
    <div class="glass rounded-2xl p-7 border-t-2 border-emerald-300">
      <span class="label block mb-4">{S.rLabel}</span>

      <div class="flex items-start gap-3 mb-6 pb-6 border-b border-slate-200/70">
        <span class="w-3 h-3 rounded-full mt-1 shrink-0" style="background:#10b981;box-shadow:0 0 14px rgba(16,185,129,0.55)"></span>
        <div>
          <p class="font-mono text-[10px] tracking-widest uppercase text-slate-400 mb-1">{S.baseLabel}</p>
          <h3 class="font-display text-xl font-bold text-slate-900">Operator Core</h3>
          <p class="text-slate-500 text-sm leading-relaxed mt-1">{S.baseDesc}</p>
          <a href={modulosHref} class="inline-block mt-3 font-mono text-xs font-medium text-emerald-700 border border-emerald-200 px-4 py-2 rounded-lg hover:bg-emerald-50 transition-colors">{S.baseBtn}</a>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <span id="orbit-dot" class="w-3 h-3 rounded-full mt-1 shrink-0"></span>
        <div class="flex-1">
          <p class="font-mono text-[10px] tracking-widest uppercase text-slate-400 mb-1">{S.orbitLabel}</p>
          <h3 id="orbit-name" class="font-display text-xl font-bold text-slate-900"></h3>
          <p id="orbit-tagline" class="font-mono text-xs mb-2"></p>
          <p class="text-slate-500 text-xs leading-relaxed mb-2">{S.orbitSteps}</p>
          <ul id="orbit-modules" class="space-y-1 mb-3"></ul>
          <a id="orbit-link" href="#" class="inline-block font-mono text-xs font-medium text-slate-700 border border-slate-300 px-4 py-2 rounded-lg hover:bg-slate-50 transition-colors">{S.orbitBtn}</a>
        </div>
      </div>

      <p id="perfil-saved" class="font-mono text-[11px] text-slate-400 mt-6 pt-5 border-t border-slate-200/70"></p>
    </div>

    <div class="text-center mt-8">
      <a href={galaxiaHref} class="font-mono text-xs text-slate-400 hover:text-slate-700 transition-colors">{S.back}</a>
    </div>
  </section>
</Layout>

<style>
  .chip { font-family: 'JetBrains Mono', monospace; font-size: 12px; padding: 7px 14px; border-radius: 9999px; border: 1px solid #e2e8f0; background: #fff; color: #475569; cursor: pointer; transition: all 0.18s ease; }
  .chip:hover { border-color: #6ee7b7; color: #0f172a; }
  .chip[aria-pressed="true"], .chip[aria-checked="true"] { background: #ecfdf5; border-color: #34d399; color: #047857; font-weight: 600; }
  .chip:focus-visible, .opt:focus-visible { outline: none; box-shadow: 0 0 0 2px #34d399; }
  .opt { border: 1px solid #e2e8f0; background: #fff; border-radius: 14px; padding: 14px 16px; cursor: pointer; transition: all 0.18s ease; }
  .opt:hover { border-color: #cbd5e1; background: #f8fafc; }
  .opt[aria-checked="true"] { border-color: #34d399; background: #ecfdf5; box-shadow: 0 1px 0 rgba(16,185,129,0.1); }
  .opt[aria-checked="true"] .chip-mark { color: #10b981; }
</style>

<script>
  import { supabase } from '../lib/supabase';

  const cfg = JSON.parse(document.getElementById('perfil-data')?.textContent || '{}');
  const CONST = cfg.CONST || {};
  const MSG = cfg.MSG || {};
  const TEXT_COLOR: Record<string, string> = { emerald:'#059669', sky:'#0284c7', violet:'#7c3aed', amber:'#d97706', rose:'#e11d48', indigo:'#4f46e5' };

  document.querySelectorAll('[data-chips]').forEach((group) => {
    group.addEventListener('click', (e) => {
      const b = (e.target as Element).closest('.chip') as HTMLElement | null;
      if (!b) return;
      b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
    });
  });
  document.querySelectorAll('[data-radio]').forEach((group) => {
    group.addEventListener('click', (e) => {
      const b = (e.target as Element).closest('[role="radio"], .opt, .chip') as HTMLElement | null;
      if (!b || !group.contains(b)) return;
      group.querySelectorAll('[role="radio"], .opt, .chip').forEach((o) => o.setAttribute('aria-checked', 'false'));
      b.setAttribute('aria-checked', 'true');
    });
  });

  const picks = (sel: string) => Array.from(document.querySelectorAll(`${sel} [aria-pressed="true"]`)).map((e) => (e as HTMLElement).dataset.value || '');
  const picked = (sel: string) => { const e = document.querySelector(`${sel} [aria-checked="true"]`) as HTMLElement | null; return e ? (e.dataset.value || '') : ''; };
  const pickedEl = (sel: string) => document.querySelector(`${sel} [aria-checked="true"]`) as HTMLElement | null;

  const form = document.getElementById('perfil-form') as HTMLFormElement | null;
  const errEl = document.getElementById('perfil-error');
  const resultEl = document.getElementById('perfil-result');

  try { if (localStorage.getItem('moonkey_ref')) document.getElementById('ref-note')?.classList.replace('hidden', 'flex'); } catch (e) {}

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const virtues = picks('[data-chips="virtues"]');
    const domains = picks('[data-chips="domains"]');
    const aptitude = picked('[data-radio="aptitude"]');
    const goalEl = pickedEl('[data-radio="goal"]');
    const goal = goalEl?.dataset.value || '';
    const constellation = goalEl?.dataset.constellation || 'operator-core';
    const time = picked('[data-radio="time"]');
    const note = (document.getElementById('note') as HTMLTextAreaElement)?.value.trim() || null;
    const name = (document.getElementById('name') as HTMLInputElement)?.value.trim() || null;
    const email = (document.getElementById('email') as HTMLInputElement)?.value.trim() || null;

    const problems = [];
    if (virtues.length === 0) problems.push(MSG.vVirtue);
    if (!aptitude) problems.push(MSG.vApt);
    if (!goal) problems.push(MSG.vGoal);
    if (email && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) problems.push(MSG.vEmail);
    if (problems.length) {
      if (errEl) { errEl.textContent = problems.join(' '); errEl.classList.remove('hidden'); }
      return;
    }
    if (errEl) errEl.classList.add('hidden');

    let ref = null, userId = null;
    try { ref = localStorage.getItem('moonkey_ref'); } catch (e) {}
    const locale = document.documentElement.lang || 'es';

    const c = CONST[constellation] || CONST['operator-core'];
    const dot = document.getElementById('orbit-dot');
    if (dot) dot.setAttribute('style', `background:${c.dot};box-shadow:0 0 14px ${c.dot}88`);
    const nameEl = document.getElementById('orbit-name'); if (nameEl) nameEl.textContent = c.name;
    const tagEl = document.getElementById('orbit-tagline'); if (tagEl) { tagEl.textContent = c.tagline; tagEl.style.color = TEXT_COLOR[c.text] || '#475569'; }
    const ul = document.getElementById('orbit-modules');
    if (ul) ul.innerHTML = c.modules.map((m: string) => `<li class="flex items-start gap-2 text-xs text-slate-600"><span class="text-slate-300 font-mono shrink-0">—</span>${m.replace(/</g,'&lt;')}</li>`).join('');
    const link = document.getElementById('orbit-link') as HTMLAnchorElement | null;
    if (link) link.href = c.href;

    resultEl?.classList.remove('hidden');
    resultEl?.scrollIntoView({ behavior: 'smooth', block: 'start' });

    const savedEl = document.getElementById('perfil-saved');
    try { const { data } = await supabase!.auth.getSession(); userId = data?.session?.user?.id ?? null; } catch (e) {}

    if (supabase) {
      const { error } = await supabase.from('operator_intake').insert({
        ref_code: ref, name, email, virtues, aptitude, domains,
        goal, blocker: null, time_week: time || null, recommended: constellation, note, locale, user_id: userId,
      });
      if (savedEl) savedEl.textContent = error ? MSG.savedErr : (ref ? MSG.savedRef : MSG.savedPlain);
      if (error) console.warn('[intake] save failed:', error.message);
    }
  });
</script>

<script id="perfil-data" type="application/json" set:html={JSON.stringify(CLIENT)} is:inline></script>
