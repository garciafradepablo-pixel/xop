---
import Layout from '../components/Layout.astro';
import { resolveLocale, useTranslations } from '../i18n/utils';

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const t = useTranslations(locale);

const isSpa = locale === 'es';
const copy = {
  title: isSpa ? 'Solicitar acceso' : 'Request access',
  subtitle: isSpa
    ? 'Completa el siguiente formulario para recibir una invitación automática al curso.'
    : 'Complete the form below to receive an automatic invitation to the course.',
  email: isSpa ? 'Tu email' : 'Your email',
  button: isSpa ? 'Solicitar invitación' : 'Request invitation',
  sending: isSpa ? 'Enviando...' : 'Sending...',
  success: isSpa ? '✓ Invitación enviada' : '✓ Invitation sent',
  error: isSpa ? '✗ Ocurrió un error. Intenta de nuevo.' : '✗ An error occurred. Please try again.',
  validate: isSpa ? 'Por favor, usa un email válido.' : 'Please enter a valid email.',
};
---

<Layout title={copy.title} description={copy.subtitle}>
  <div class="max-w-2xl mx-auto py-12 px-6">
    <section class="text-center mb-12">
      <h1 class="text-3xl sm:text-4xl font-display font-bold mb-4 text-slate-900">
        {copy.title}
      </h1>
      <p class="text-base sm:text-lg text-slate-500 leading-relaxed">
        {copy.subtitle}
      </p>
    </section>

    <section class="bg-white border border-slate-200 rounded-2xl px-6 sm:px-8 py-8 max-w-md mx-auto">
      <form id="access-form" class="space-y-4">
        <div>
          <label for="email" class="block font-mono text-[10px] tracking-widest uppercase text-slate-400 mb-2">
            {copy.email}
          </label>
          <input
            id="email"
            type="email"
            name="email"
            required
            autocomplete="email"
            maxlength="120"
            class="w-full text-sm bg-white border border-slate-300 rounded-xl px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-400 transition-colors"
            placeholder="tu@email.com"
          />
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full font-mono text-sm font-medium px-4 py-3 rounded-xl bg-emerald-600 text-white hover:bg-emerald-700 transition-colors"
        >
          {copy.button}
        </button>
      </form>

      <div id="status" class="mt-4 text-center hidden">
        <p id="status-text" class="font-mono text-sm text-slate-600"></p>
      </div>
    </section>

    <!-- Info block -->
    <section class="mt-12 max-w-md mx-auto">
      <div class="bg-slate-50 border border-slate-200 rounded-xl px-5 py-4">
        <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase mb-2">
          {isSpa ? 'Próximos pasos' : 'What happens next'}
        </p>
        <ol class="text-sm text-slate-600 space-y-1.5 list-decimal list-inside">
          <li>{isSpa ? 'Recibirás un email de confirmación.' : 'You'll receive a confirmation email.'}</li>
          <li>{isSpa ? 'Haz clic en el enlace para crear tu cuenta.' : 'Click the link to create your account.'}</li>
          <li>{isSpa ? 'Acceso automático al curso.' : 'Automatic access to the course.'}</li>
        </ol>
      </div>
    </section>
  </div>

  <script define:vars={{ copy, locale }}>
    const form = document.getElementById('access-form');
    const submitBtn = document.getElementById('submit-btn');
    const statusDiv = document.getElementById('status');
    const statusText = document.getElementById('status-text');
    const emailInput = document.getElementById('email');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const email = emailInput?.value?.trim();
      if (!email) return;

      // Basic validation
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        statusDiv?.classList.remove('hidden');
        statusText.textContent = copy.validate;
        statusText.classList.add('text-rose-600');
        return;
      }

      // Disable button, show loading
      submitBtn.disabled = true;
      submitBtn.textContent = copy.sending;

      try {
        const response = await fetch(
          `https://wuchsslgbqlhyxljsmxi.supabase.co/functions/v1/request-access`,
          {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'apikey': 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Ind1Y2hzc2xnYnFsbGh5eGxqc214aSIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNzE5ODEzNzcyLCJleHAiOjE5Nzc1OTMzNzJ9.kOvNEi_tZWI-PsWN6JG-dHzTVmSSmDHkKOXD95yKlZY',
            },
            body: JSON.stringify({ email, locale }),
          }
        );

        if (response.ok) {
          statusDiv?.classList.remove('hidden');
          statusText.textContent = copy.success;
          statusText.classList.remove('text-rose-600');
          statusText.classList.add('text-emerald-600');
          form.reset();
          submitBtn.textContent = copy.button;
          submitBtn.disabled = false;
        } else {
          throw new Error('Response not ok');
        }
      } catch (err) {
        console.error('Request error:', err);
        statusDiv?.classList.remove('hidden');
        statusText.textContent = copy.error;
        statusText.classList.add('text-rose-600');
        submitBtn.textContent = copy.button;
        submitBtn.disabled = false;
      }
    });
  </script>
</Layout>
