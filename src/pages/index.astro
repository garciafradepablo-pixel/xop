---
import Layout from '../components/Layout.astro';
import AnimalIcon from '../components/AnimalIcon.astro';
import { resolveLocale, localizedPath, useTranslations } from '../i18n/utils';
import { chromeT } from '../i18n/chrome.i18n';

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const t = useTranslations(locale);
const c = chromeT(locale);

const level1Outcomes = [
  'Terminal, VS Code y Claude Code operativos',
  'Primer repositorio en GitHub con historial limpio',
  'CLAUDE.md propio configurado y funcionando',
  'Prompts operativos que producen trabajo usable',
  'Primera automatización mapeada y documentada',
  'Proyecto publicado con URL real',
];

const level2Outcomes = [
  'Arquitectura de proyectos profesional',
  'Control de contexto y tokens optimizado',
  'Git workflow con commits y ramas',
  'Debugging sistemático sin depender ciegamente de IA',
  'Refactors seguros con validación por fases',
  'SOPs de deploy y documentación operativa',
];

const level3Outcomes = [
  'CLAUDE.md centralizado con contexto migrado',
  'Carpeta /prompts con prompts operativos propios',
  'Workflows documentados y listos para ejecutar',
  'Backlog de automatizaciones priorizado',
  'README operativo completo',
  'Sistema de trabajo con Claude Code desde cero',
];

const servicios = [
  { label: t('s.1'), color: 'text-emerald-600' },
  { label: t('s.2'), color: 'text-sky-600'     },
  { label: t('s.3'), color: 'text-violet-600'  },
  { label: t('s.4'), color: 'text-amber-600'   },
  { label: t('s.5'), color: 'text-rose-600'    },
  { label: t('s.6'), color: 'text-teal-600'    },
];

// El ecosistema — tres capas: entidad, laboratorio, metodología
const ecosistema = [
  { layer: t('eco.entity.layer'), name: 'XNLAB Studio',  desc: t('eco.entity.desc'), dot: 'bg-slate-900',   lbl: 'text-slate-400'   },
  { layer: t('eco.lab.layer'),    name: 'MOONKEY LAB',   desc: t('eco.lab.desc'),    dot: 'bg-emerald-500', lbl: 'text-emerald-500' },
  { layer: t('eco.method.layer'), name: 'Operator Path', desc: t('eco.method.desc'), dot: 'bg-slate-400',   lbl: 'text-slate-400'   },
];

// ¿Para quién es?
const audiencia = [
  { tag: '01', title: t('aud.1.title'), desc: t('aud.1.desc') },
  { tag: '02', title: t('aud.2.title'), desc: t('aud.2.desc') },
  { tag: '03', title: t('aud.3.title'), desc: t('aud.3.desc') },
  { tag: '04', title: t('aud.4.title'), desc: t('aud.4.desc') },
];

// Elige tu camino
const caminos = [
  {
    tag: t('c.0.tag'), who: t('c.0.who'), desc: t('c.0.desc'), cta: t('c.0.cta'),
    href: localizedPath('/modulos', locale),
    bg: 'bg-emerald-50', border: 'border-emerald-200', text: 'text-emerald-700',
    lbl: 'text-emerald-500', btn: 'bg-emerald-500 text-white hover:bg-emerald-600',
  },
  {
    tag: t('c.1.tag'), who: t('c.1.who'), desc: t('c.1.desc'), cta: t('c.1.cta'),
    href: localizedPath('/prueba-operador', locale),
    bg: 'bg-sky-50', border: 'border-sky-200', text: 'text-sky-700',
    lbl: 'text-sky-500', btn: 'bg-sky-500 text-white hover:bg-sky-600',
  },
  {
    tag: t('c.2.tag'), who: t('c.2.who'), desc: t('c.2.desc'), cta: t('c.2.cta'),
    href: localizedPath('/planes', locale),
    bg: 'bg-amber-50', border: 'border-amber-200', text: 'text-amber-700',
    lbl: 'text-amber-500', btn: 'bg-amber-500 text-white hover:bg-amber-600',
  },
];
---

<Layout title="Inicio" description="MOONKEY LAB by XNLAB Studio — Aprende a operar IA de forma sistemática. Sin código. Sin teoría infinita.">

  <!-- Hero — Light Premium / Integrated Scene -->
  <section id="mk-hero" class="relative overflow-hidden flex items-center min-h-[80vh] lg:min-h-[86vh]" style="margin-left:calc(-50vw + 50%);width:100vw;background:radial-gradient(120% 95% at 80% 28%,rgba(16,185,129,0.10) 0%,transparent 55%),linear-gradient(135deg,#f8fafc 0%,#f1f5f9 100%)">

    <!-- Interactive cursor glow — follows the pointer across the hero -->
    <div id="mk-hero-glow" aria-hidden="true" class="pointer-events-none absolute rounded-full hidden lg:block" style="z-index:0;width:560px;height:560px;left:0;top:0;transform:translate(-50%,-50%);background:radial-gradient(circle,rgba(16,185,129,0.20),rgba(56,189,248,0.10) 45%,transparent 65%);filter:blur(30px);opacity:0;transition:opacity .5s ease"></div>

    <div class="relative w-full max-w-screen-xl mx-auto px-6 sm:px-10 lg:px-16 py-10 lg:py-0 flex flex-col lg:flex-row items-center gap-8 lg:gap-6" style="z-index:1">

      <!-- LEFT — text column -->
      <div class="flex-1 max-w-[600px] text-center lg:text-left order-last lg:order-first hero-enter" style="animation-delay:0.05s">
        <p class="font-mono text-[10px] tracking-[0.38em] uppercase mb-5" style="color:#059669">{t('hero.label')}</p>
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold leading-[1.06] tracking-tight mb-5" style="color:#0f172a">
          {t('hero.h1.a')}<br/>{t('hero.h1.b')}<br/>
          <span style="background:linear-gradient(90deg,#059669 0%,#34d399 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">{t('hero.h1.c')}</span>
        </h1>
        <p class="text-base leading-relaxed max-w-lg mb-2 mx-auto lg:mx-0" style="color:#475569">
          {t('hero.sub1')}
        </p>
        <p class="text-sm leading-relaxed max-w-lg mb-7 mx-auto lg:mx-0" style="color:#64748b">
          {t('hero.sub2')}
        </p>
        <div class="flex flex-wrap gap-3 justify-center lg:justify-start">
          <a href={localizedPath('/modulos', locale)} class="inline-flex items-center gap-2 font-mono text-sm font-semibold px-6 py-3 rounded-xl transition-all duration-300 ease-out hover:-translate-y-0.5 hover:bg-emerald-700 hover:shadow-lg hover:shadow-emerald-500/25 focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2" style="background:#059669;color:#ffffff">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            {t('hero.cta.primary')}
          </a>
          <a href={localizedPath('/monkeys', locale)} class="inline-flex items-center gap-2 font-mono text-sm px-6 py-3 rounded-xl transition-all duration-300 ease-out hover:border-emerald-400 hover:text-emerald-700 focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2" style="color:#0f172a;border:1px solid #cbd5e1">
            {t('hero.cta.secondary')} →
          </a>
        </div>
        <p class="font-mono text-[10px] tracking-wide mt-4 mx-auto lg:mx-0" style="color:#64748b">{t('hero.disclaimer')}</p>
      </div>

      <!-- RIGHT — soft-alpha scene floating on the hero background: no panel, no canvas edge -->
      <div class="relative shrink-0 order-first lg:order-last w-[88%] mx-auto lg:w-[620px] lg:mx-0 hero-enter-img" style="aspect-ratio:1/1;overflow:visible">
        <!-- emerald fog behind, blurred, low — gives depth, kills any residual edge -->
        <div class="absolute pointer-events-none" style="inset:-8%;z-index:0;border-radius:50%;background:radial-gradient(circle at 52% 46%,rgba(16,185,129,0.16) 0%,rgba(16,185,129,0.05) 46%,transparent 70%);filter:blur(70px)"></div>
        <!-- scene: real radial alpha feather baked into the asset — dissolves into the bg -->
        <picture>
          <source media="(max-width:767px)" srcset="/assets/moonkey/hero-scene-soft-mobile.webp" type="image/webp" />
          <source media="(min-width:768px)" srcset="/assets/moonkey/hero-scene-soft.webp, /assets/moonkey/hero-scene-soft@2x.webp 1.5x" type="image/webp" />
          <img src="/assets/moonkey/hero-scene-soft.webp" alt="Escena MOONKEY — mono contemplando la luna en una jungla cinematográfica" class="relative w-full h-full object-cover" style="z-index:1" loading="eager" width="1080" height="1080" />
        </picture>
        <!-- particles — desktop only, respects prefers-reduced-motion via CSS -->
        <div class="mk-particles absolute inset-0 pointer-events-none hidden lg:block" aria-hidden="true">
          <span class="mk-particle" style="width:4px;height:4px;top:11%;left:17%;animation-delay:0s"></span>
          <span class="mk-particle" style="width:3px;height:3px;top:23%;right:7%;animation-delay:1.6s"></span>
          <span class="mk-particle" style="width:3px;height:3px;top:60%;right:2%;animation-delay:3.2s"></span>
          <span class="mk-particle" style="width:4px;height:4px;top:70%;left:4%;animation-delay:0.8s"></span>
          <span class="mk-particle" style="width:2px;height:2px;top:40%;left:-1%;animation-delay:2.4s"></span>
        </div>
      </div>

    </div>
  </section>

  <!-- Product system strip — three Keys, each with its animal -->
  <div class="pt-8 pb-2">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">

      <!-- KEY 1 — available -->
      <a href={localizedPath('/modulos', locale)} class="group block glass rounded-2xl p-5 transition-all duration-300 hover:shadow-md card-hover" data-reveal data-delay="0">
        <div class="flex items-center gap-3 mb-3.5">
          <span class="w-9 h-9 rounded-full flex items-center justify-center shrink-0 ring-1 ring-slate-900/5" style="background:#1e293b">
            <AnimalIcon name="monkey" color="#94a3b8" bg="#1e293b" size={18} />
          </span>
          <div class="flex-1 flex items-center justify-between">
            <span class="font-mono text-[10px] tracking-widest uppercase font-semibold text-emerald-600">KEY 1 · N1</span>
            <span id="hero-l1-progress" class="font-mono text-[10px] text-slate-400">0/8</span>
          </div>
        </div>
        <p class="text-sm font-semibold text-slate-900 mb-1 group-hover:text-emerald-700 transition-colors">Foundations</p>
        <p class="font-mono text-[11px] text-slate-500 mb-4">Terminal · Claude · GitHub · Prompts</p>
        <div class="h-1 rounded-full bg-slate-100 overflow-hidden">
          <div id="hero-l1-bar" class="h-full rounded-full bg-emerald-500" style="width:0%;transition:width 0.6s ease"></div>
        </div>
      </a>

      <!-- KEY 2 — locked -->
      <div id="hero-n2-col" class="glass rounded-2xl p-5 transition-opacity" style="opacity:0.78" data-reveal data-delay="120">
        <div class="flex items-center gap-3 mb-3.5">
          <span class="w-9 h-9 rounded-full flex items-center justify-center shrink-0 ring-1 ring-slate-900/5" style="background:#1e1b4b">
            <AnimalIcon name="gorilla" color="#a78bfa" bg="#1e1b4b" size={18} />
          </span>
          <div class="flex-1 flex items-center justify-between">
            <span class="font-mono text-[10px] tracking-widest uppercase font-semibold text-violet-500">KEY 2 · N2</span>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
        </div>
        <p class="text-sm font-semibold text-slate-700 mb-1">Builder</p>
        <p class="font-mono text-[11px] text-slate-500">Arquitectura · Debug · Deploy · MCPs</p>
      </div>

      <!-- KEY 3 — locked -->
      <div class="glass rounded-2xl p-5" style="opacity:0.78" data-reveal data-delay="240">
        <div class="flex items-center gap-3 mb-3.5">
          <span class="w-9 h-9 rounded-full flex items-center justify-center shrink-0 ring-1 ring-slate-900/5" style="background:#022c22">
            <AnimalIcon name="panda" color="#34d399" bg="#022c22" size={18} />
          </span>
          <div class="flex-1 flex items-center justify-between">
            <span class="font-mono text-[10px] tracking-widest uppercase font-semibold text-amber-500">KEY 3 · N3</span>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
        </div>
        <p class="text-sm font-semibold text-slate-700 mb-1">Mastery</p>
        <p class="font-mono text-[11px] text-slate-500">Contexto · SOPs · Workflows · Sistema</p>
      </div>

    </div>
  </div>

  <!-- El ecosistema — full-bleed emerald band -->
  <section class="relative py-24" style="margin-left:calc(-50vw + 50%);width:100vw;background:radial-gradient(70% 120% at 12% 0%,rgba(16,185,129,0.14),transparent 55%),linear-gradient(180deg,rgba(209,250,229,0.5),rgba(248,250,252,0) 88%)">
    <div class="max-w-5xl mx-auto px-6">
      <span class="label block mb-3" data-reveal>{t('label.ecosystem')}</span>
      <p class="text-slate-600 text-sm leading-relaxed max-w-xl mb-10" data-reveal data-delay="80">
        {t('eco.desc')}
      </p>
      <div class="relative">
        {ecosistema.map((e, i) => (
          <div class={`relative pl-8 ${i < ecosistema.length - 1 ? 'pb-9 border-l-2 border-emerald-200/70' : 'border-l-2 border-transparent'}`} data-reveal data-delay={i * 180}>
            <span class={`absolute -left-[7px] top-1 w-3 h-3 rounded-full ${e.dot} ring-4 ring-white`}></span>
            <p class={`font-mono text-[10px] tracking-widest uppercase mb-1.5 ${e.lbl}`}>{e.layer}</p>
            <h3 class="text-xl font-bold text-slate-900 mb-1.5">{e.name}</h3>
            <p class="text-slate-500 text-sm leading-relaxed max-w-md">{e.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- No somos una escuela -->
  <section class="py-24 border-b border-slate-200">
    <span class="label block mb-8" data-reveal>{t('label.notschool')}</span>
    <div class="space-y-4 max-w-2xl">
      <p class="text-2xl sm:text-3xl font-bold text-slate-300 leading-snug tracking-tight" data-reveal data-delay="100">
        {t('contrast.tool')}
      </p>
      <p class="text-2xl sm:text-3xl font-bold text-slate-900 leading-snug tracking-tight" data-reveal data-delay="240">
        {t('contrast.systems')}
      </p>
    </div>
    <div class="mt-12 pt-8 border-t border-slate-200 max-w-2xl" data-reveal data-delay="380">
      <p class="text-base text-slate-500 leading-relaxed mb-1.5">{t('contrast.goal.not')}</p>
      <p class="text-base text-slate-900 font-semibold leading-relaxed">{t('contrast.goal.yes')}</p>
    </div>
  </section>

  <!-- Para quién es — full-bleed violet band -->
  <section class="relative py-24" style="margin-left:calc(-50vw + 50%);width:100vw;background:radial-gradient(70% 120% at 88% 0%,rgba(139,92,246,0.14),transparent 55%),linear-gradient(180deg,rgba(237,233,254,0.5),rgba(248,250,252,0) 88%)">
    <div class="max-w-5xl mx-auto px-6">
    <span class="label block mb-3" data-reveal style="color:#7c3aed">{t('label.forwhom')}</span>
    <p class="text-slate-600 text-sm leading-relaxed max-w-xl mb-8" data-reveal data-delay="80">
      {t('forwhom.desc')}
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {audiencia.map((a, i) => (
        <div class="glass rounded-2xl p-6 hover:shadow-md transition-all card-hover" data-reveal data-delay={i * 110}>
          <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase mb-3">{a.tag}</p>
          <h3 class="text-base font-bold text-slate-900 mb-1.5">{a.title}</h3>
          <p class="text-slate-500 text-sm leading-relaxed">{a.desc}</p>
        </div>
      ))}
    </div>
    </div>
  </section>

  <!-- Progreso global -->
  <section class="py-20 border-b border-slate-200" data-reveal>
    <div class="flex items-center justify-between mb-4">
      <span class="label">{t('label.progress')}</span>
      <span class="font-mono text-xs text-slate-500"><span id="progress-count">0</span>/3 {t('progress.levels')}</span>
    </div>
    <div class="flex gap-3 mb-1.5">
      <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
        <div id="dot-l1" class="h-full w-1/3 bg-slate-200 rounded-full transition-colors duration-500"></div>
      </div>
      <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
        <div id="dot-l2" class="h-full w-full bg-slate-200 rounded-full transition-colors duration-500"></div>
      </div>
      <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
        <div id="dot-l3" class="h-full w-full bg-slate-200 rounded-full transition-colors duration-500"></div>
      </div>
    </div>
    <div class="flex gap-3 mb-4">
      <span class="flex-1 font-mono text-[10px] text-slate-500 text-center">Key 1</span>
      <span class="flex-1 font-mono text-[10px] text-slate-500 text-center">Key 2</span>
      <span class="flex-1 font-mono text-[10px] text-slate-500 text-center">Key 3</span>
    </div>
    <a href={localizedPath('/cuenta', locale)} class="font-mono text-xs text-slate-500 hover:text-emerald-600 transition-colors">{t('progress.sync')}</a>
  </section>

  <!-- Operator Path dark block -->
  <section class="py-20 border-b border-slate-200">
    <div class="bg-slate-900 rounded-2xl overflow-hidden" data-reveal="scale">
      <div class="px-7 sm:px-9 py-8">
        <span class="font-mono text-[10px] tracking-widest text-emerald-400 uppercase block mb-3">{t('label.op')}</span>
        <h2 class="text-xl font-bold text-white mb-2 leading-snug">{t('op.h1')}</h2>
        <p class="text-slate-400 text-sm leading-relaxed mb-7 max-w-lg">{t('op.sub')}</p>
        <div class="grid sm:grid-cols-3 gap-px bg-white/[0.06] rounded-xl overflow-hidden mb-5">
          <div class="bg-slate-800/70 px-5 py-5" data-reveal data-delay="120">
            <span class="font-mono text-[10px] text-emerald-400 tracking-widest uppercase block mb-2">KEY 1</span>
            <p class="text-white text-sm font-semibold mb-1.5">Operator Foundations</p>
            <p class="text-slate-400 text-xs leading-relaxed">{t('op.key1.desc')}</p>
          </div>
          <div class="bg-slate-800/70 px-5 py-5 border-t sm:border-t-0 sm:border-l border-white/[0.06]" data-reveal data-delay="240">
            <span class="font-mono text-[10px] text-violet-400 tracking-widest uppercase block mb-2">KEY 2</span>
            <p class="text-white text-sm font-semibold mb-1.5">Advanced Operator</p>
            <p class="text-slate-400 text-xs leading-relaxed">{t('op.key2.desc')}</p>
          </div>
          <div class="bg-slate-800/70 px-5 py-5 border-t sm:border-t-0 sm:border-l border-white/[0.06]" data-reveal data-delay="360">
            <span class="font-mono text-[10px] text-amber-400 tracking-widest uppercase block mb-2">KEY 3</span>
            <p class="text-white text-sm font-semibold mb-1.5">Migration Master</p>
            <p class="text-slate-400 text-xs leading-relaxed">{t('op.key3.desc')}</p>
          </div>
        </div>
        <p class="text-slate-500 text-xs font-mono">{t('op.footer')}</p>
      </div>
    </div>
  </section>

  <!-- EMERALD teaser — atmospheric, no CTA, generates curiosity -->
  <section class="py-10 border-b border-slate-200" data-reveal="scale">
    <div class="rounded-2xl overflow-hidden" style="background:linear-gradient(160deg,#030712 0%,#0a0a14 60%,#030b05 100%);border:1px solid rgba(52,211,153,0.10)">
      <div class="px-7 sm:px-10 py-9">
        <div class="flex items-center gap-2.5 mb-5">
          <span class="font-mono text-[9px] tracking-[0.5em] uppercase font-bold" style="color:rgba(52,211,153,0.45)">◆ {t('label.emerald')}</span>
        </div>
        <p class="text-lg sm:text-xl font-semibold text-white mb-4 max-w-lg leading-snug">
          {t('emerald.desc')}
        </p>
        <div class="flex flex-wrap gap-x-5 gap-y-1 font-mono text-xs mb-6" style="color:rgba(148,163,184,0.45)">
          <span>{t('emerald.no1')}</span>
          <span>{t('emerald.no2')}</span>
          <span>{t('emerald.no3')}</span>
        </div>
        <p class="font-mono text-[10px] tracking-widest uppercase" style="color:rgba(52,211,153,0.3)">{t('emerald.soon')}</p>
      </div>
    </div>
  </section>

  <!-- La evolución — full-bleed amber band -->
  <section class="relative py-24" style="margin-left:calc(-50vw + 50%);width:100vw;background:radial-gradient(70% 120% at 50% 0%,rgba(245,158,11,0.12),transparent 55%),linear-gradient(180deg,rgba(254,243,199,0.45),rgba(248,250,252,0) 88%)">
    <div class="max-w-5xl mx-auto px-6">
    <span class="label block mb-2" data-reveal style="color:#d97706">{t('label.evolution')}</span>
    <p class="font-mono text-xs text-slate-500 mb-10" data-reveal data-delay="80">{t('evo.desc')}</p>
    <div class="relative">
      <!-- Gradient connector line — desktop only -->
      <div class="hidden sm:block absolute left-[44px] right-[44px] pointer-events-none" style="top:22px;height:1px;background:linear-gradient(to right,rgba(148,163,184,0.3),rgba(139,92,246,0.4) 30%,rgba(16,185,129,0.4) 55%,rgba(245,158,11,0.3) 75%,rgba(6,78,59,0.2) 100%)"></div>
      <div class="grid grid-cols-5 gap-2 sm:gap-4">

        <!-- 01 Monkey -->
        <div class="flex flex-col items-center text-center" data-reveal data-delay="0">
          <div class="relative z-10 w-10 h-10 sm:w-11 sm:h-11 rounded-full flex items-center justify-center mb-3 shrink-0" style="background:#1e293b;border:2px solid rgba(148,163,184,0.35)">
            <AnimalIcon name="monkey" color="#94a3b8" bg="#1e293b" size={22} />
          </div>
          <p class="font-mono text-[8px] font-bold text-slate-400 uppercase mb-0.5">01</p>
