---
import Layout from '../components/Layout.astro';
import LanguageBar from '../components/LanguageBar.astro';

const level1Outcomes = [
  'Terminal, VS Code y Claude Code operativos',
  'Primer repositorio en GitHub con historial limpio',
  'CLAUDE.md propio configurado y funcionando',
  'Prompts operativos que producen trabajo usable',
  'Primera automatización mapeada y documentada',
  'Proyecto publicado con URL real',
];

const level2Outcomes = [
  'Arquitectura de proyectos profesional',
  'Control de contexto y tokens optimizado',
  'Git workflow con commits y ramas',
  'Debugging sistemático sin depender ciegamente de IA',
  'Refactors seguros con validación por fases',
  'SOPs de deploy y documentación operativa',
];

const level3Outcomes = [
  'CLAUDE.md centralizado con contexto migrado',
  'Carpeta /prompts con prompts operativos propios',
  'Workflows documentados y listos para ejecutar',
  'Backlog de automatizaciones priorizado',
  'README operativo completo',
  'Sistema de trabajo con Claude Code desde cero',
];

const servicios = [
  { label: 'Escuela interna de IA para equipos',          color: 'text-emerald-600' },
  { label: 'Sistema de prompts y SOPs operativos',        color: 'text-sky-600'     },
  { label: 'Migración ChatGPT → Claude',                  color: 'text-violet-600'  },
  { label: 'Automatización de workflows de trabajo',      color: 'text-amber-600'   },
  { label: 'Documentación operativa de procesos',         color: 'text-rose-600'    },
  { label: 'Portal interno de formación personalizado',   color: 'text-teal-600'    },
];

// El ecosistema — tres capas: entidad, laboratorio, metodología
const ecosistema = [
  { layer: 'Entidad',      name: 'XNLAB Studio',  desc: 'Diseñamos sistemas, operadores y laboratorios de IA.', dot: 'bg-slate-900',  lbl: 'text-slate-400'  },
  { layer: 'Laboratorio',  name: 'MOONKEY LAB',   desc: 'El entorno de formación para operadores de IA.',       dot: 'bg-emerald-500', lbl: 'text-emerald-500' },
  { layer: 'Metodología',  name: 'Operator Path', desc: 'El método para pasar de usuario a constructor.',        dot: 'bg-slate-400',  lbl: 'text-slate-400'  },
];

// ¿Para quién es?
const audiencia = [
  { tag: '01', title: 'Operadores IA',              desc: 'Ya usas IA a diario y quieres convertir ese uso en sistemas que no dependan de recordar el prompt correcto.' },
  { tag: '02', title: 'Freelancers',                desc: 'Buscas entregar más rápido y con más criterio, automatizando lo repetitivo sin perder el control.' },
  { tag: '03', title: 'Fundadores',                 desc: 'Necesitas que tu equipo opere IA con método, no con improvisación dispersa entre chats.' },
  { tag: '04', title: 'Constructores de sistemas',  desc: 'Piensas en procesos, no en respuestas sueltas. Quieres infraestructura operativa propia.' },
];
---

<Layout title="Inicio" description="MOONKEY LAB by XNLAB Studio — Aprende a operar IA de forma sistemática. Sin código. Sin teoría infinita.">

  <!-- Hero — Light Premium / Integrated Scene -->
  <section class="relative overflow-hidden flex items-center min-h-[80vh] lg:min-h-[86vh]" style="margin-left:calc(-50vw + 50%);width:100vw;background:radial-gradient(120% 95% at 80% 28%,rgba(16,185,129,0.10) 0%,transparent 55%),linear-gradient(135deg,#f8fafc 0%,#f1f5f9 100%)">

    <div class="relative w-full max-w-screen-xl mx-auto px-6 sm:px-10 lg:px-16 py-10 lg:py-0 flex flex-col lg:flex-row items-center gap-8 lg:gap-6" style="z-index:1">

      <!-- LEFT — text column -->
      <div class="flex-1 max-w-[600px] text-center lg:text-left order-last lg:order-first hero-enter" style="animation-delay:0.05s">
        <p class="font-mono text-[10px] tracking-[0.38em] uppercase mb-5" style="color:#059669">THE MONKEY LAB</p>
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold leading-[1.06] tracking-tight mb-5" style="color:#0f172a">
          De prompt<br/>a operador.<br/>
          <span style="background:linear-gradient(90deg,#059669 0%,#34d399 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">En tres niveles.</span>
        </h1>
        <p class="text-base leading-relaxed max-w-lg mb-2 mx-auto lg:mx-0" style="color:#475569">
          Sistema de formación para operadores IA. Tres niveles progresivos, módulos prácticos, entregables reales desde el primer día.
        </p>
        <p class="text-sm leading-relaxed max-w-lg mb-7 mx-auto lg:mx-0" style="color:#64748b">
          Para freelancers, fundadores y operadores que ya usan IA a diario.
        </p>
        <div class="flex flex-wrap gap-3 justify-center lg:justify-start">
          <a href="/modulos" class="inline-flex items-center gap-2 font-mono text-sm font-semibold px-6 py-3 rounded-xl transition-all duration-300 ease-out hover:-translate-y-0.5 hover:bg-emerald-700 hover:shadow-lg hover:shadow-emerald-500/25 focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2" style="background:#059669;color:#ffffff">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Empezar Nivel 1
          </a>
          <a href="/monkeys" class="inline-flex items-center gap-2 font-mono text-sm px-6 py-3 rounded-xl transition-all duration-300 ease-out hover:border-emerald-400 hover:text-emerald-700 focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2" style="color:#0f172a;border:1px solid #cbd5e1">
            Entrar al Lab →
          </a>
        </div>
        <p class="font-mono text-[10px] tracking-wide mt-4 mx-auto lg:mx-0" style="color:#64748b">Sin registro · Empieza gratis · 10–15 min al día</p>
      </div>

      <!-- RIGHT — soft-alpha scene floating on the hero background: no panel, no canvas edge -->
      <div class="relative shrink-0 order-first lg:order-last w-[88%] mx-auto lg:w-[620px] lg:mx-0 hero-enter-img" style="aspect-ratio:1/1;overflow:visible">
        <!-- emerald fog behind, blurred, low — gives depth, kills any residual edge -->
        <div class="absolute pointer-events-none" style="inset:-8%;z-index:0;border-radius:50%;background:radial-gradient(circle at 52% 46%,rgba(16,185,129,0.16) 0%,rgba(16,185,129,0.05) 46%,transparent 70%);filter:blur(70px)"></div>
        <!-- scene: real radial alpha feather baked into the asset — dissolves into the bg -->
        <picture>
          <source media="(max-width:767px)" srcset="/assets/moonkey/hero-scene-soft-mobile.webp" type="image/webp" />
          <source media="(min-width:768px)" srcset="/assets/moonkey/hero-scene-soft.webp, /assets/moonkey/hero-scene-soft@2x.webp 1.5x" type="image/webp" />
          <img src="/assets/moonkey/hero-scene-soft.webp" alt="Escena MOONKEY — mono contemplando la luna en una jungla cinematográfica" class="relative w-full h-full object-cover" style="z-index:1" loading="eager" width="1080" height="1080" />
        </picture>
        <!-- particles — desktop only, respects prefers-reduced-motion via CSS -->
        <div class="mk-particles absolute inset-0 pointer-events-none hidden lg:block" aria-hidden="true">
          <span class="mk-particle" style="width:4px;height:4px;top:11%;left:17%;animation-delay:0s"></span>
          <span class="mk-particle" style="width:3px;height:3px;top:23%;right:7%;animation-delay:1.6s"></span>
          <span class="mk-particle" style="width:3px;height:3px;top:60%;right:2%;animation-delay:3.2s"></span>
          <span class="mk-particle" style="width:4px;height:4px;top:70%;left:4%;animation-delay:0.8s"></span>
          <span class="mk-particle" style="width:2px;height:2px;top:40%;left:-1%;animation-delay:2.4s"></span>
        </div>
      </div>

    </div>
  </section>

  <!-- Language bar — utilitarian, low prominence -->
  <div class="pt-4">
    <LanguageBar />
  </div>

  <!-- Product system strip — three keys, light premium -->
  <div class="pt-6 pb-2">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">

      <!-- KEY 1 — available -->
      <a href="/modulos" class="group block bg-white rounded-2xl border border-slate-200 p-5 transition-all duration-300 hover:border-emerald-300 hover:shadow-sm card-hover" data-reveal data-delay="0">
        <div class="flex items-center justify-between mb-3">
          <span class="font-mono text-[10px] tracking-widest uppercase font-semibold text-emerald-600">KEY 1 · N1</span>
          <span id="hero-l1-progress" class="font-mono text-[10px] text-slate-400">0/8</span>
        </div>
        <p class="text-sm font-semibold text-slate-900 mb-1 group-hover:text-emerald-700 transition-colors">Foundations</p>
        <p class="font-mono text-[11px] text-slate-500 mb-4">Terminal · Claude · GitHub · Prompts</p>
        <div class="h-1 rounded-full bg-slate-100 overflow-hidden">
          <div id="hero-l1-bar" class="h-full rounded-full bg-emerald-500" style="width:0%;transition:width 0.6s ease"></div>
        </div>
      </a>

      <!-- KEY 2 — locked -->
      <div id="hero-n2-col" class="bg-white rounded-2xl border border-slate-200 p-5 transition-opacity" style="opacity:0.72" data-reveal data-delay="120">
        <div class="flex items-center justify-between mb-3">
          <span class="font-mono text-[10px] tracking-widest uppercase font-semibold text-violet-500">KEY 2 · N2</span>
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <p class="text-sm font-semibold text-slate-700 mb-1">Builder</p>
        <p class="font-mono text-[11px] text-slate-500">Arquitectura · Debug · Deploy · MCPs</p>
      </div>

      <!-- KEY 3 — locked -->
      <div class="bg-white rounded-2xl border border-slate-200 p-5" style="opacity:0.72" data-reveal data-delay="240">
        <div class="flex items-center justify-between mb-3">
          <span class="font-mono text-[10px] tracking-widest uppercase font-semibold text-amber-500">KEY 3 · N3</span>
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <p class="text-sm font-semibold text-slate-700 mb-1">Mastery</p>
        <p class="font-mono text-[11px] text-slate-500">Contexto · SOPs · Workflows · Sistema</p>
      </div>

    </div>
  </div>

  <!-- El ecosistema -->
  <section class="py-24 border-b border-slate-200">
    <span class="label block mb-3" data-reveal>EL ECOSISTEMA</span>
    <p class="text-slate-500 text-sm leading-relaxed max-w-xl mb-10" data-reveal data-delay="80">
      Tres capas. Una entidad que diseña, un laboratorio que forma, una metodología que estructura el camino.
    </p>
    <div class="relative">
      {ecosistema.map((e, i) => (
        <div class={`relative pl-8 ${i < ecosistema.length - 1 ? 'pb-9 border-l-2 border-slate-200' : 'border-l-2 border-transparent'}`} data-reveal data-delay={i * 180}>
          <span class={`absolute -left-[7px] top-1 w-3 h-3 rounded-full ${e.dot} ring-4 ring-[#f8fafc]`}></span>
          <p class={`font-mono text-[10px] tracking-widest uppercase mb-1.5 ${e.lbl}`}>{e.layer}</p>
          <h3 class="text-xl font-bold text-slate-900 mb-1.5">{e.name}</h3>
          <p class="text-slate-500 text-sm leading-relaxed max-w-md">{e.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- No somos una escuela -->
  <section class="py-24 border-b border-slate-200">
    <span class="label block mb-8" data-reveal>NO SOMOS UNA ESCUELA</span>
    <div class="space-y-4 max-w-2xl">
      <p class="text-2xl sm:text-3xl font-bold text-slate-300 leading-snug tracking-tight" data-reveal data-delay="100">
        La mayoría de cursos enseñan herramientas.
      </p>
      <p class="text-2xl sm:text-3xl font-bold text-slate-900 leading-snug tracking-tight" data-reveal data-delay="240">
        MOONKEY LAB enseña a construir sistemas.
      </p>
    </div>
    <div class="mt-12 pt-8 border-t border-slate-200 max-w-2xl" data-reveal data-delay="380">
      <p class="text-base text-slate-500 leading-relaxed mb-1.5">El objetivo no es consumir contenido.</p>
      <p class="text-base text-slate-900 font-semibold leading-relaxed">El objetivo es desarrollar criterio operativo.</p>
    </div>
  </section>

  <!-- Para quién es -->
  <section class="py-24 border-b border-slate-200">
    <span class="label block mb-3" data-reveal>¿PARA QUIÉN ES?</span>
    <p class="text-slate-500 text-sm leading-relaxed max-w-xl mb-8" data-reveal data-delay="80">
      Para quien quiere dejar de usar IA por impulso y empezar a operarla con criterio.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {audiencia.map((a, i) => (
        <div class="bg-white border border-slate-200 rounded-2xl p-6 hover:border-slate-300 transition-colors card-hover" data-reveal data-delay={i * 110}>
          <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase mb-3">{a.tag}</p>
          <h3 class="text-base font-bold text-slate-900 mb-1.5">{a.title}</h3>
          <p class="text-slate-500 text-sm leading-relaxed">{a.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Progreso global -->
  <section class="py-20 border-b border-slate-200" data-reveal>
    <div class="flex items-center justify-between mb-4">
      <span class="label">TU PROGRESO</span>
      <span class="font-mono text-xs text-slate-500"><span id="progress-count">0</span>/3 niveles completados</span>
    </div>
    <div class="flex gap-3 mb-1.5">
      <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
        <div id="dot-l1" class="h-full w-1/3 bg-slate-200 rounded-full transition-colors duration-500"></div>
      </div>
      <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
        <div id="dot-l2" class="h-full w-full bg-slate-200 rounded-full transition-colors duration-500"></div>
      </div>
      <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
        <div id="dot-l3" class="h-full w-full bg-slate-200 rounded-full transition-colors duration-500"></div>
      </div>
    </div>
    <div class="flex gap-3 mb-4">
      <span class="flex-1 font-mono text-[10px] text-slate-500 text-center">Key 1</span>
      <span class="flex-1 font-mono text-[10px] text-slate-500 text-center">Key 2</span>
      <span class="flex-1 font-mono text-[10px] text-slate-500 text-center">Key 3</span>
    </div>
    <a href="/cuenta" class="font-mono text-xs text-slate-500 hover:text-emerald-600 transition-colors">Sincronizar progreso en la nube →</a>
  </section>

  <!-- Operator Path dark block -->
  <section class="py-20 border-b border-slate-200">
    <div class="bg-slate-900 rounded-2xl overflow-hidden" data-reveal="scale">
      <div class="px-7 sm:px-9 py-8">
        <span class="font-mono text-[10px] tracking-widest text-emerald-400 uppercase block mb-3">OPERATOR PATH — METODOLOGÍA MOONKEY XN</span>
        <h2 class="text-xl font-bold text-white mb-2 leading-snug">De aprendiz a operador.</h2>
        <p class="text-slate-400 text-sm leading-relaxed mb-7 max-w-lg">Tres Keys. Cada una desbloquea la siguiente. Un sistema que no desaparece cuando cierras el chat.</p>
        <div class="grid sm:grid-cols-3 gap-px bg-white/[0.06] rounded-xl overflow-hidden mb-5">
          <div class="bg-slate-800/70 px-5 py-5" data-reveal data-delay="120">
            <span class="font-mono text-[10px] text-emerald-400 tracking-widest uppercase block mb-2">KEY 1</span>
            <p class="text-white text-sm font-semibold mb-1.5">Operator Foundations</p>
            <p class="text-slate-400 text-xs leading-relaxed">Terminal, GitHub, CLAUDE.md, prompts y primera automatización.</p>
          </div>
          <div class="bg-slate-800/70 px-5 py-5 border-t sm:border-t-0 sm:border-l border-white/[0.06]" data-reveal data-delay="240">
            <span class="font-mono text-[10px] text-violet-400 tracking-widest uppercase block mb-2">KEY 2</span>
            <p class="text-white text-sm font-semibold mb-1.5">Advanced Operator</p>
            <p class="text-slate-400 text-xs leading-relaxed">Arquitectura, debugging, refactors, MCPs y documentación operativa.</p>
          </div>
          <div class="bg-slate-800/70 px-5 py-5 border-t sm:border-t-0 sm:border-l border-white/[0.06]" data-reveal data-delay="360">
            <span class="font-mono text-[10px] text-amber-400 tracking-widest uppercase block mb-2">KEY 3</span>
            <p class="text-white text-sm font-semibold mb-1.5">Migration Master</p>
            <p class="text-slate-400 text-xs leading-relaxed">Contexto migrado, sistema de prompts propio y workflows documentados.</p>
          </div>
        </div>
        <p class="text-slate-500 text-xs font-mono">Moonkey — operador que ha completado las 3 Keys. Moon + Monkey + Key.</p>
      </div>
    </div>
  </section>

  <!-- La evolución -->
  <section class="py-24 border-b border-slate-200">
    <span class="label block mb-2" data-reveal>LA EVOLUCIÓN</span>
    <p class="font-mono text-xs text-slate-500 mb-10" data-reveal data-delay="80">De aprendiz a ecosistema. El camino no termina en el tercer nivel.</p>
    <div class="relative">
      <!-- Gradient connector line — desktop only -->
      <div class="hidden sm:block absolute left-[44px] right-[44px] pointer-events-none" style="top:22px;height:1px;background:linear-gradient(to right,rgba(148,163,184,0.3),rgba(139,92,246,0.4) 30%,rgba(16,185,129,0.4) 55%,rgba(245,158,11,0.3) 75%,rgba(6,78,59,0.2) 100%)"></div>
      <div class="grid grid-cols-5 gap-2 sm:gap-4">

        <!-- 01 Monkey -->
        <div class="flex flex-col items-center text-center" data-reveal data-delay="0">
          <div class="relative z-10 w-10 h-10 sm:w-11 sm:h-11 rounded-full flex items-center justify-center mb-3 shrink-0" style="background:#1e293b;border:2px solid rgba(148,163,184,0.35)">
            <svg width="15" height="15" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
              <defs><mask id="ev-mk"><rect width="20" height="20" fill="white"/><circle cx="13" cy="6" r="6" fill="black"/></mask></defs>
              <circle cx="9" cy="8" r="7" fill="#94a3b8" mask="url(#ev-mk)"/>
            </svg>
          </div>
          <p class="font-mono text-[8px] font-bold text-slate-400 uppercase mb-0.5">01</p>
          <p class="font-mono text-[10px] sm:text-xs font-bold text-slate-700 mb-0.5">Monkey</p>
          <p class="font-mono text-[8px] text-slate-500 leading-tight hidden sm:block">en formación</p>
          <span class="font-mono text-[8px] mt-1" style="color:#34d399">KEY 1</span>
        </div>

        <!-- 02 Gorilla -->
        <div class="flex flex-col items-center text-center" data-reveal data-delay="110">
          <div class="relative z-10 w-10 h-10 sm:w-11 sm:h-11 rounded-full flex items-center justify-center mb-3 shrink-0" style="background:#1e1b4b;border:2px solid rgba(139,92,246,0.45)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <p class="font-mono text-[8px] font-bold text-violet-400 uppercase mb-0.5">02</p>
          <p class="font-mono text-[10px] sm:text-xs font-bold text-violet-700 mb-0.5">Gorilla</p>
          <p class="font-mono text-[8px] text-slate-500 leading-tight hidden sm:block">ejecuta con fuerza</p>
          <span class="font-mono text-[8px] mt-1" style="color:#a78bfa">KEY 2</span>
        </div>

        <!-- 03 Eagle -->
        <div class="flex flex-col items-center text-center" data-reveal data-delay="220">
          <div class="relative z-10 w-10 h-10 sm:w-11 sm:h-11 rounded-full flex items-center justify-center mb-3 shrink-0" style="background:#022c22;border:2px solid rgba(52,211,153,0.45)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <p class="font-mono text-[8px] font-bold text-emerald-500 uppercase mb-0.5">03</p>
          <p class="font-mono text-[10px] sm:text-xs font-bold text-emerald-700 mb-0.5">Eagle</p>
          <p class="font-mono text-[8px] text-slate-500 leading-tight hidden sm:block">vuela solo</p>
          <span class="font-mono text-[8px] mt-1" style="color:#34d399">KEY 3</span>
        </div>

        <!-- 04 Lion -->
        <div class="flex flex-col items-center text-center" style="opacity:0.58" data-reveal data-delay="330">
          <div class="relative z-10 w-10 h-10 sm:w-11 sm:h-11 rounded-full flex items-center justify-center mb-3 shrink-0" style="background:#1c0a03;border:2px dashed rgba(251,191,36,0.3)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="22"/><line x1="4.93" y1="4.93" x2="6.34" y2="6.34"/><line x1="17.66" y1="17.66" x2="19.07" y2="19.07"/><line x1="2" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="22" y2="12"/><line x1="4.93" y1="19.07" x2="6.34" y2="17.66"/><line x1="17.66" y1="6.34" x2="19.07" y2="4.93"/></svg>
          </div>
          <p class="font-mono text-[8px] font-bold text-amber-400 uppercase mb-0.5">04</p>
          <p class="font-mono text-[10px] sm:text-xs font-bold text-amber-700 mb-0.5">Lion</p>
          <p class="font-mono text-[8px] text-slate-500 leading-tight hidden sm:block">lidera</p>
