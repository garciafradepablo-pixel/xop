---
import Layout from '../components/Layout.astro';
import LanguageBar from '../components/LanguageBar.astro';

const level1Outcomes = [
  'Terminal, VS Code y Claude Code operativos',
  'Primer repositorio en GitHub con historial limpio',
  'CLAUDE.md propio configurado y funcionando',
  'Prompts operativos que producen trabajo usable',
  'Primera automatización mapeada y documentada',
  'Proyecto publicado con URL real',
];

const level2Outcomes = [
  'Arquitectura de proyectos profesional',
  'Control de contexto y tokens optimizado',
  'Git workflow con commits y ramas',
  'Debugging sistemático sin depender ciegamente de IA',
  'Refactors seguros con validación por fases',
  'SOPs de deploy y documentación operativa',
];

const level3Outcomes = [
  'CLAUDE.md centralizado con contexto migrado',
  'Carpeta /prompts con prompts operativos propios',
  'Workflows documentados y listos para ejecutar',
  'Backlog de automatizaciones priorizado',
  'README operativo completo',
  'Sistema de trabajo con Claude Code desde cero',
];

const servicios = [
  { label: 'Escuela interna de IA para equipos',          color: 'text-emerald-600' },
  { label: 'Sistema de prompts y SOPs operativos',        color: 'text-sky-600'     },
  { label: 'Migración ChatGPT → Claude',                  color: 'text-violet-600'  },
  { label: 'Automatización de workflows de trabajo',      color: 'text-amber-600'   },
  { label: 'Documentación operativa de procesos',         color: 'text-rose-600'    },
  { label: 'Portal interno de formación personalizado',   color: 'text-teal-600'    },
];

// El ecosistema — tres capas: entidad, laboratorio, metodología
const ecosistema = [
  { layer: 'Entidad',      name: 'XNLAB Studio',  desc: 'Diseñamos sistemas, operadores y laboratorios de IA.', dot: 'bg-slate-900',  lbl: 'text-slate-400'  },
  { layer: 'Laboratorio',  name: 'MOONKEY LAB',   desc: 'El entorno de formación para operadores de IA.',       dot: 'bg-emerald-500', lbl: 'text-emerald-500' },
  { layer: 'Metodología',  name: 'Operator Path', desc: 'El método para pasar de usuario a constructor.',        dot: 'bg-slate-400',  lbl: 'text-slate-400'  },
];

// ¿Para quién es?
const audiencia = [
  { tag: '01', title: 'Operadores IA',              desc: 'Ya usas IA a diario y quieres convertir ese uso en sistemas que no dependan de recordar el prompt correcto.' },
  { tag: '02', title: 'Freelancers',                desc: 'Buscas entregar más rápido y con más criterio, automatizando lo repetitivo sin perder el control.' },
  { tag: '03', title: 'Fundadores',                 desc: 'Necesitas que tu equipo opere IA con método, no con improvisación dispersa entre chats.' },
  { tag: '04', title: 'Constructores de sistemas',  desc: 'Piensas en procesos, no en respuestas sueltas. Quieres infraestructura operativa propia.' },
];
---

<Layout title="Inicio" description="MOONKEY LAB by XNLAB Studio — Aprende a operar IA de forma sistemática. Sin código. Sin teoría infinita.">

  <!-- Hero — Atmospheric Portal -->
  <section class="relative overflow-hidden min-h-[90vh]" style="margin-left:calc(-50vw + 50%);width:100vw;background:linear-gradient(165deg,#030b05 0%,#060e08 38%,#080f09 62%,#0a1a0c 100%)">

    <!-- Atmosphere: depth layers -->
    <div class="absolute inset-0 pointer-events-none select-none">
      <div class="absolute inset-0" style="background:radial-gradient(ellipse at 68% 35%,rgba(16,185,129,0.13) 0%,transparent 52%),radial-gradient(ellipse at 12% 68%,rgba(6,78,59,0.18) 0%,transparent 48%),radial-gradient(ellipse at 88% 8%,rgba(4,120,87,0.08) 0%,transparent 38%),radial-gradient(ellipse at 42% 92%,rgba(2,44,34,0.22) 0%,transparent 42%)"></div>
      <svg class="absolute inset-0 w-full h-full opacity-[0.04]" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
        <filter id="atm-noise" x="0%" y="0%" width="100%" height="100%">
          <feTurbulence type="fractalNoise" baseFrequency="0.68" numOctaves="4" stitchTiles="stitch"/>
          <feColorMatrix type="saturate" values="0"/>
        </filter>
        <rect width="100%" height="100%" filter="url(#atm-noise)"/>
      </svg>
      <div class="absolute inset-0" style="background:radial-gradient(ellipse at 50% 45%,transparent 30%,rgba(0,0,0,0.48) 100%)"></div>
    </div>

    <!-- Moon: 550px, absolute right, partially outside viewport -->
    <div class="absolute pointer-events-none select-none" style="width:550px;height:550px;top:50%;right:-110px;transform:translateY(-50%);z-index:1">
      <div class="absolute pointer-events-none" style="inset:-60px;background:radial-gradient(ellipse at 50% 50%,rgba(16,185,129,0.12) 0%,transparent 65%);border-radius:50%"></div>
      <div class="absolute inset-0 rounded-full overflow-hidden" style="background:radial-gradient(ellipse at 30% 20%,#0a3d2e 0%,#0d1b2a 48%,#020c05 100%);box-shadow:0 0 0 1px rgba(52,211,153,0.07),0 0 120px rgba(16,185,129,0.32),0 0 240px rgba(16,185,129,0.13),0 28px 56px rgba(0,0,0,0.72)">
        <div class="absolute inset-0" style="background:radial-gradient(ellipse at 36% 17%,rgba(52,211,153,0.32) 0%,transparent 44%)"></div>
        <div class="absolute inset-0" style="background:radial-gradient(ellipse at 55% 85%,rgba(1,18,8,0.75) 0%,transparent 50%)"></div>
        <div class="absolute inset-4 rounded-full" style="border:1px solid rgba(52,211,153,0.11)"></div>
        <div class="absolute inset-[50px] rounded-full" style="border:1px solid rgba(52,211,153,0.07)"></div>
        <div class="absolute inset-[100px] rounded-full" style="border:1px solid rgba(52,211,153,0.04)"></div>
        <div class="absolute inset-0 flex items-center justify-center" style="padding-bottom:24%">
          <svg width="240" height="240" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <mask id="moon-atm">
                <rect width="100" height="100" fill="white"/>
                <circle cx="65" cy="23" r="40" fill="black"/>
              </mask>
              <radialGradient id="moon-fill" cx="28%" cy="28%" r="70%">
                <stop offset="0%" stop-color="#86efac"/>
                <stop offset="55%" stop-color="#34d399"/>
                <stop offset="100%" stop-color="#047857"/>
              </radialGradient>
            </defs>
            <circle cx="35" cy="46" r="42" fill="rgba(52,211,153,0.05)"/>
            <circle cx="35" cy="46" r="35" fill="url(#moon-fill)" mask="url(#moon-atm)" opacity="0.96"/>
            <circle cx="35" cy="46" r="35" fill="none" stroke="rgba(167,243,208,0.55)" stroke-width="1.5" mask="url(#moon-atm)"/>
          </svg>
        </div>
        <div class="absolute bottom-0 left-0 right-0 flex justify-center">
          <svg width="260" height="175" viewBox="0 0 160 115" xmlns="http://www.w3.org/2000/svg" style="opacity:0.78">
            <ellipse cx="80" cy="106" rx="48" ry="11" fill="rgba(0,0,0,0.75)"/>
            <ellipse cx="80" cy="78" rx="19" ry="22" fill="rgba(0,0,0,0.86)"/>
            <path d="M63 73 Q50 86 54 100" stroke="rgba(0,0,0,0.86)" stroke-width="10" fill="none" stroke-linecap="round"/>
            <path d="M97 73 Q110 86 106 100" stroke="rgba(0,0,0,0.86)" stroke-width="10" fill="none" stroke-linecap="round"/>
            <circle cx="80" cy="50" r="17" fill="rgba(0,0,0,0.88)"/>
            <circle cx="62" cy="47" r="7" fill="rgba(0,0,0,0.88)"/>
            <circle cx="98" cy="47" r="7" fill="rgba(0,0,0,0.88)"/>
          </svg>
        </div>
        <div class="absolute top-[11%] left-[21%] w-0.5 h-0.5 rounded-full" style="background:rgba(52,211,153,0.95)"></div>
        <div class="absolute top-[22%] right-[15%] w-1 h-1 rounded-full" style="background:rgba(52,211,153,0.65)"></div>
        <div class="absolute top-[37%] right-[9%] w-0.5 h-0.5 rounded-full" style="background:rgba(134,239,172,0.6)"></div>
        <div class="absolute top-[54%] left-[8%] w-1 h-1 rounded-full" style="background:rgba(52,211,153,0.42)"></div>
        <div class="absolute top-[29%] left-[13%] w-0.5 h-0.5 rounded-full" style="background:rgba(167,243,208,0.5)"></div>
        <div class="absolute top-[46%] left-[32%] w-0.5 h-0.5 rounded-full" style="background:rgba(52,211,153,0.35)"></div>
      </div>
    </div>

    <!-- Mid fog -->
    <svg class="absolute pointer-events-none select-none" style="top:25%;left:0;width:100%;height:320px;z-index:1;opacity:0.32" viewBox="0 0 1440 320" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <radialGradient id="fog-mid" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#10b981" stop-opacity="0.18"/>
          <stop offset="100%" stop-color="#10b981" stop-opacity="0"/>
        </radialGradient>
      </defs>
      <ellipse cx="720" cy="160" rx="640" ry="160" fill="url(#fog-mid)"/>
    </svg>

    <!-- Left foreground vegetation -->
    <svg class="absolute bottom-0 left-0 pointer-events-none select-none" style="width:300px;height:440px;z-index:3" viewBox="0 0 300 440" xmlns="http://www.w3.org/2000/svg">
      <path d="M-20 440 Q35 330 90 285 Q120 262 155 242" stroke="rgba(16,185,129,0.5)" stroke-width="2.5" fill="none"/>
      <path d="M-20 440 Q15 365 45 305 Q65 272 108 244" stroke="rgba(6,78,59,0.65)" stroke-width="3" fill="none"/>
      <path d="M5 440 Q55 390 108 345 Q138 312 158 272" stroke="rgba(4,120,87,0.45)" stroke-width="2" fill="none"/>
      <path d="M15 440 C-28 378 -48 338 25 295 C65 272 98 288 88 328" fill="rgba(2,44,34,0.78)" stroke="rgba(16,185,129,0.28)" stroke-width="1"/>
      <path d="M-8 440 C-62 388 -82 346 -8 304 C34 280 74 298 58 338" fill="rgba(3,55,40,0.68)" stroke="rgba(16,185,129,0.22)" stroke-width="1"/>
      <path d="M42 440 Q22 394 55 338" stroke="rgba(16,185,129,0.42)" stroke-width="1.5" fill="none"/>
      <path d="M65 440 Q50 378 75 325" stroke="rgba(16,185,129,0.32)" stroke-width="1" fill="none"/>
      <path d="M88 440 Q78 404 95 358" stroke="rgba(6,78,59,0.48)" stroke-width="1.5" fill="none"/>
      <path d="M-42 412 Q25 362 88 374 Q128 380 118 412" fill="rgba(1,30,15,0.78)" stroke="rgba(52,211,153,0.18)" stroke-width="0.5"/>
      <path d="M-42 440 Q8 408 62 415 Q108 420 138 440 L-42 440Z" fill="rgba(1,10,5,0.96)"/>
    </svg>

    <!-- Right foreground vegetation -->
    <svg class="absolute bottom-0 right-0 pointer-events-none select-none" style="width:280px;height:400px;z-index:3" viewBox="0 0 280 400" xmlns="http://www.w3.org/2000/svg">
      <path d="M300 400 Q248 315 205 272 Q178 250 155 235" stroke="rgba(16,185,129,0.48)" stroke-width="2.5" fill="none"/>
      <path d="M300 400 Q268 348 236 305 Q215 278 178 258" stroke="rgba(6,78,59,0.62)" stroke-width="3" fill="none"/>
      <path d="M280 400 Q258 365 232 322 Q210 290 192 265" stroke="rgba(4,120,87,0.42)" stroke-width="2" fill="none"/>
      <path d="M268 400 C322 348 338 305 270 270 C228 248 196 265 212 308" fill="rgba(2,44,34,0.72)" stroke="rgba(16,185,129,0.26)" stroke-width="1"/>
      <path d="M290 400 C348 358 362 315 295 282 C252 260 220 278 236 320" fill="rgba(3,55,40,0.62)" stroke="rgba(16,185,129,0.2)" stroke-width="1"/>
      <path d="M235 400 Q255 358 228 310" stroke="rgba(16,185,129,0.38)" stroke-width="1.5" fill="none"/>
      <path d="M215 400 Q228 360 212 318" stroke="rgba(16,185,129,0.3)" stroke-width="1" fill="none"/>
      <path d="M194 400 Q205 372 188 332" stroke="rgba(6,78,59,0.45)" stroke-width="1.5" fill="none"/>
      <path d="M320 378 Q255 340 198 356 Q162 364 172 392" fill="rgba(1,30,15,0.75)" stroke="rgba(52,211,153,0.16)" stroke-width="0.5"/>
      <path d="M320 400 Q275 378 228 385 Q182 392 158 400 L320 400Z" fill="rgba(1,10,5,0.96)"/>
    </svg>

    <!-- Content -->
    <div class="relative z-10 px-6 sm:px-10 lg:px-20 pt-20 pb-28 max-w-screen-xl mx-auto">
      <div class="max-w-2xl">
        <p class="font-mono text-[10px] tracking-[0.3em] uppercase mb-5" style="color:rgba(52,211,153,0.6)">THE MONKEY LAB</p>
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold leading-[1.06] tracking-tight mb-6" style="color:#f0fdf4">
          De prompt<br/>a operador.<br/>
          <span style="color:#34d399">En tres niveles.</span>
        </h1>
        <p class="text-base leading-relaxed max-w-lg mb-8" style="color:#94a3b8">
          Sistema de formación para operadores IA. Tres niveles progresivos, módulos prácticos, entregables reales desde el primer día.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/monkeys" class="inline-flex items-center gap-2 font-mono text-sm font-semibold px-6 py-3 rounded-xl transition-colors" style="background:#34d399;color:#022c22">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Entrar al Lab
          </a>
          <a href="/modulos" class="inline-flex items-center gap-2 font-mono text-sm px-6 py-3 rounded-xl transition-colors" style="color:#94a3b8;border:1px solid rgba(255,255,255,0.11)">
            Empezar Nivel 1 →
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom fog -->
    <svg class="absolute bottom-0 left-0 right-0 w-full pointer-events-none select-none" style="height:240px;z-index:2" viewBox="0 0 1440 240" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="fog-bottom" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#030b05" stop-opacity="0"/>
          <stop offset="100%" stop-color="#030b05" stop-opacity="0.94"/>
        </linearGradient>
      </defs>
      <rect width="1440" height="240" fill="url(#fog-bottom)"/>
    </svg>

    <!-- Gradient bleed: hero dark → page light -->
    <div class="absolute bottom-0 left-0 right-0 pointer-events-none" style="height:5rem;background:linear-gradient(to bottom,transparent,#f8fafc);z-index:5"></div>
  </section>

  <!-- Language bar — below hero -->
  <div class="pt-5 pb-4" style="border-top:1px solid rgba(0,0,0,0.07)">
    <LanguageBar />
  </div>

  <!-- Product system strip — below hero -->
  <div class="py-6">
    <div class="rounded-2xl overflow-hidden" style="background:rgba(10,20,13,0.7);border:1px solid rgba(52,211,153,0.08)">
      <div class="grid grid-cols-1 sm:grid-cols-3">
        <a href="/modulos" class="block px-5 py-4 hover:bg-white/[0.03] transition-colors group border-b sm:border-b-0 sm:border-r" style="border-color:rgba(255,255,255,0.05)">
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-[9px] tracking-widest uppercase font-bold" style="color:#34d399">KEY 1 · N1</span>
            <span id="hero-l1-progress" class="font-mono text-[9px]" style="color:#475569">0/8</span>
          </div>
          <p class="font-mono text-sm font-semibold mb-1 group-hover:text-emerald-300 transition-colors" style="color:#f0fdf4">Foundations</p>
          <p class="font-mono text-[10px] mb-3" style="color:#475569">Terminal · Claude · GitHub · Prompts</p>
          <div class="h-0.5 rounded-full" style="background:rgba(255,255,255,0.07)">
            <div id="hero-l1-bar" class="h-full rounded-full" style="background:#34d399;width:0%;transition:width 0.6s ease"></div>
          </div>
        </a>
        <div id="hero-n2-col" class="px-5 py-4 border-b sm:border-b-0 sm:border-r transition-opacity" style="border-color:rgba(255,255,255,0.05);opacity:0.38">
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-[9px] tracking-widest uppercase font-bold" style="color:#a78bfa">KEY 2 · N2</span>
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <p class="font-mono text-sm font-semibold mb-1" style="color:#64748b">Builder</p>
          <p class="font-mono text-[10px]" style="color:#334155">Arquitectura · Debug · Deploy · MCPs</p>
        </div>
        <div class="px-5 py-4" style="opacity:0.2">
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-[9px] tracking-widest uppercase font-bold" style="color:#fbbf24">KEY 3 · N3</span>
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <p class="font-mono text-sm font-semibold mb-1" style="color:#475569">Mastery</p>
          <p class="font-mono text-[10px]" style="color:#1e293b">Contexto · SOPs · Workflows · Sistema</p>
        </div>
      </div>
    </div>
  </div>

  <!-- El ecosistema -->
  <section class="py-16 border-b border-slate-200">
    <span class="label block mb-3">EL ECOSISTEMA</span>
    <p class="text-slate-500 text-sm leading-relaxed max-w-xl mb-10">
      Tres capas. Una entidad que diseña, un laboratorio que forma, una metodología que estructura el camino.
    </p>
    <div class="relative">
      {ecosistema.map((e, i) => (
        <div class={`relative pl-8 ${i < ecosistema.length - 1 ? 'pb-9 border-l-2 border-slate-200' : 'border-l-2 border-transparent'}`}>
          <span class={`absolute -left-[7px] top-1 w-3 h-3 rounded-full ${e.dot} ring-4 ring-[#f8fafc]`}></span>
          <p class={`font-mono text-[10px] tracking-widest uppercase mb-1.5 ${e.lbl}`}>{e.layer}</p>
          <h3 class="text-xl font-bold text-slate-900 mb-1.5">{e.name}</h3>
          <p class="text-slate-500 text-sm leading-relaxed max-w-md">{e.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- No somos una escuela -->
  <section class="py-20 border-b border-slate-200">
    <span class="label block mb-8">NO SOMOS UNA ESCUELA</span>
    <div class="space-y-4 max-w-2xl">
      <p class="text-2xl sm:text-3xl font-bold text-slate-300 leading-snug tracking-tight">
        La mayoría de cursos enseñan herramientas.
      </p>
      <p class="text-2xl sm:text-3xl font-bold text-slate-900 leading-snug tracking-tight">
        MOONKEY LAB enseña a construir sistemas.
      </p>
    </div>
    <div class="mt-12 pt-8 border-t border-slate-200 max-w-2xl">
      <p class="text-base text-slate-500 leading-relaxed mb-1.5">El objetivo no es consumir contenido.</p>
      <p class="text-base text-slate-900 font-semibold leading-relaxed">El objetivo es desarrollar criterio operativo.</p>
    </div>
  </section>

  <!-- Para quién es -->
  <section class="py-16 border-b border-slate-200">
    <span class="label block mb-3">¿PARA QUIÉN ES?</span>
    <p class="text-slate-500 text-sm leading-relaxed max-w-xl mb-8">
      Para quien quiere dejar de usar IA por impulso y empezar a operarla con criterio.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {audiencia.map(a => (
        <div class="bg-white border border-slate-200 rounded-2xl p-6 hover:border-slate-300 transition-colors">
          <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase mb-3">{a.tag}</p>
          <h3 class="text-base font-bold text-slate-900 mb-1.5">{a.title}</h3>
          <p class="text-slate-500 text-sm leading-relaxed">{a.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Progreso global -->
  <section class="py-10 border-b border-slate-200">
    <div class="flex items-center justify-between mb-4">
      <span class="label">TU PROGRESO</span>
      <span class="font-mono text-xs text-slate-500"><span id="progress-count">0</span>/3 niveles completados</span>
    </div>
    <div class="flex gap-3 mb-1.5">
      <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
        <div id="dot-l1" class="h-full w-1/3 bg-slate-200 rounded-full transition-colors duration-500"></div>
      </div>
      <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
        <div id="dot-l2" class="h-full w-full bg-slate-200 rounded-full transition-colors duration-500"></div>
      </div>
      <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
        <div id="dot-l3" class="h-full w-full bg-slate-200 rounded-full transition-colors duration-500"></div>
      </div>
    </div>
    <div class="flex gap-3 mb-4">
      <span class="flex-1 font-mono text-[10px] text-slate-400 text-center">Key 1</span>
      <span class="flex-1 font-mono text-[10px] text-slate-400 text-center">Key 2</span>
      <span class="flex-1 font-mono text-[10px] text-slate-400 text-center">Key 3</span>
    </div>
    <a href="/cuenta" class="font-mono text-xs text-slate-400 hover:text-emerald-600 transition-colors">Sincronizar progreso en la nube →</a>
  </section>

  <!-- Operator Path dark block -->
  <section class="py-10 border-b border-slate-200">
    <div class="bg-slate-900 rounded-2xl overflow-hidden">
      <div class="px-7 sm:px-9 py-8">
        <span class="font-mono text-[10px] tracking-widest text-emerald-400 uppercase block mb-3">OPERATOR PATH — METODOLOGÍA MOONKEY XN</span>
        <h2 class="text-xl font-bold text-white mb-2 leading-snug">De aprendiz a operador.</h2>
        <p class="text-slate-400 text-sm leading-relaxed mb-7 max-w-lg">Tres Keys. Cada una desbloquea la siguiente. Un sistema que no desaparece cuando cierras el chat.</p>
        <div class="grid sm:grid-cols-3 gap-px bg-white/[0.06] rounded-xl overflow-hidden mb-5">
          <div class="bg-slate-800/70 px-5 py-5">
            <span class="font-mono text-[10px] text-emerald-400 tracking-widest uppercase block mb-2">KEY 1</span>
