---
import Layout from '../components/Layout.astro';
import LanguageBar from '../components/LanguageBar.astro';

const level1Outcomes = [
  'Terminal, VS Code y Claude Code operativos',
  'Primer repositorio en GitHub con historial limpio',
  'CLAUDE.md propio configurado y funcionando',
  'Prompts operativos que producen trabajo usable',
  'Primera automatización mapeada y documentada',
  'Proyecto publicado con URL real',
];

const level2Outcomes = [
  'Arquitectura de proyectos profesional',
  'Control de contexto y tokens optimizado',
  'Git workflow con commits y ramas',
  'Debugging sistemático sin depender ciegamente de IA',
  'Refactors seguros con validación por fases',
  'SOPs de deploy y documentación operativa',
];

const level3Outcomes = [
  'CLAUDE.md centralizado con contexto migrado',
  'Carpeta /prompts con prompts operativos propios',
  'Workflows documentados y listos para ejecutar',
  'Backlog de automatizaciones priorizado',
  'README operativo completo',
  'Sistema de trabajo con Claude Code desde cero',
];

const servicios = [
  { label: 'Escuela interna de IA para equipos',          color: 'text-emerald-600' },
  { label: 'Sistema de prompts y SOPs operativos',        color: 'text-sky-600'     },
  { label: 'Migración ChatGPT → Claude',                  color: 'text-violet-600'  },
  { label: 'Automatización de workflows de trabajo',      color: 'text-amber-600'   },
  { label: 'Documentación operativa de procesos',         color: 'text-rose-600'    },
  { label: 'Portal interno de formación personalizado',   color: 'text-teal-600'    },
];

// El ecosistema — tres capas: entidad, laboratorio, metodología
const ecosistema = [
  { layer: 'Entidad',      name: 'XNLAB Studio',  desc: 'Diseñamos sistemas, operadores y laboratorios de IA.', dot: 'bg-slate-900',  lbl: 'text-slate-400'  },
  { layer: 'Laboratorio',  name: 'MOONKEY LAB',   desc: 'El entorno de formación para operadores de IA.',       dot: 'bg-emerald-500', lbl: 'text-emerald-500' },
  { layer: 'Metodología',  name: 'Operator Path', desc: 'El método para pasar de usuario a constructor.',        dot: 'bg-slate-400',  lbl: 'text-slate-400'  },
];

// ¿Para quién es?
const audiencia = [
  { tag: '01', title: 'Operadores IA',              desc: 'Ya usas IA a diario y quieres convertir ese uso en sistemas que no dependan de recordar el prompt correcto.' },
  { tag: '02', title: 'Freelancers',                desc: 'Buscas entregar más rápido y con más criterio, automatizando lo repetitivo sin perder el control.' },
  { tag: '03', title: 'Fundadores',                 desc: 'Necesitas que tu equipo opere IA con método, no con improvisación dispersa entre chats.' },
  { tag: '04', title: 'Constructores de sistemas',  desc: 'Piensas en procesos, no en respuestas sueltas. Quieres infraestructura operativa propia.' },
];
---

<Layout title="Inicio" description="MOONKEY LAB by XNLAB Studio — Aprende a operar IA de forma sistemática. Sin código. Sin teoría infinita.">

  <!-- Hero -->
  <section class="pb-16 border-b border-slate-200 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none select-none" style="background:radial-gradient(ellipse at 72% 45%,rgba(16,185,129,0.07) 0%,transparent 62%)"></div>
    <div class="relative flex flex-col lg:flex-row lg:items-center gap-10 lg:gap-14">

      <!-- Left: copy -->
      <div class="flex-1 min-w-0">
        <p class="font-mono text-[10px] tracking-[0.25em] text-slate-400 uppercase mb-5">THE MONKEY LAB</p>
        <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 leading-[1.08] tracking-tight mb-5">
          Bienvenido al Lab.<br/>
          <span class="text-emerald-600">Monkeys en formación.</span>
        </h1>
        <p class="text-slate-600 text-base leading-relaxed max-w-lg mb-3">
          MOONKEY LAB forma operadores que aprenden a construir con IA de forma sistemática. Los llamamos Monkeys: aprendices ágiles, curiosos y constructores de sistemas reales.
        </p>
        <p class="text-slate-900 text-lg font-bold leading-snug mb-7">
          No completas módulos.<br/>
          <span class="text-emerald-600">Evolucionas dentro de la jungla.</span>
        </p>
        <div class="bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3 inline-flex flex-wrap items-center gap-2.5 mb-7">
          <span class="font-mono text-xs text-slate-400">ETIMOLOGÍA</span>
          <span class="w-px h-4 bg-slate-300 shrink-0"></span>
          <span class="text-sm text-slate-600 font-medium">Moon</span>
          <span class="text-slate-300 text-xs">+</span>
          <span class="text-sm text-slate-600 font-medium">Monkey</span>
          <span class="text-slate-300 text-xs">+</span>
          <span class="text-sm text-emerald-600 font-bold">Key</span>
          <span class="w-px h-4 bg-slate-300 shrink-0"></span>
          <span class="text-xs text-slate-400 font-mono">visión · agilidad · acceso</span>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/monkeys" class="inline-flex items-center gap-2 font-mono text-sm font-medium text-white bg-emerald-500 px-6 py-3 rounded-xl hover:bg-emerald-600 transition-colors shadow-sm">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Entrar al Lab
          </a>
          <a href="/monkeys" class="inline-flex items-center gap-2 font-mono text-sm text-slate-600 border border-slate-300 px-6 py-3 rounded-xl hover:bg-slate-50 transition-colors">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
            Explorar Monkeys
          </a>
        </div>
      </div>

      <!-- Right: jungle visual -->
      <div class="lg:w-[440px] shrink-0 flex justify-center pt-8 lg:pt-0">
        <div class="relative w-[300px] h-[300px] sm:w-[360px] sm:h-[360px]">

          <!-- Leaf decorations outside orb -->
          <div class="absolute -left-10 top-[28%] pointer-events-none select-none" style="transform:rotate(-22deg);opacity:0.4">
            <svg width="38" height="66" viewBox="0 0 38 66" xmlns="http://www.w3.org/2000/svg">
              <path d="M19 64 Q3 48 8 26 Q12 8 19 2 Q26 8 30 26 Q35 48 19 64Z" fill="#064e3b"/>
              <line x1="19" y1="64" x2="19" y2="8" stroke="#34d399" stroke-width="1" opacity="0.45"/>
            </svg>
          </div>
          <div class="absolute -right-8 top-[22%] pointer-events-none select-none" style="transform:rotate(18deg);opacity:0.35">
            <svg width="32" height="56" viewBox="0 0 32 56" xmlns="http://www.w3.org/2000/svg">
              <path d="M16 54 Q2 40 6 22 Q10 6 16 2 Q22 6 26 22 Q30 40 16 54Z" fill="#064e3b"/>
              <line x1="16" y1="54" x2="16" y2="6" stroke="#34d399" stroke-width="1" opacity="0.4"/>
            </svg>
          </div>
          <div class="absolute -left-6 bottom-[20%] pointer-events-none select-none" style="transform:rotate(12deg);opacity:0.28">
            <svg width="26" height="46" viewBox="0 0 26 46" xmlns="http://www.w3.org/2000/svg">
              <path d="M13 44 Q2 33 5 19 Q8 6 13 2 Q18 6 21 19 Q24 33 13 44Z" fill="#065f46"/>
            </svg>
          </div>

          <!-- Main orb -->
          <div class="absolute inset-0 rounded-full overflow-hidden" style="background:radial-gradient(ellipse at 32% 22%,#065f46 0%,#0f172a 52%,#022c22 100%);box-shadow:0 0 60px rgba(16,185,129,0.18),0 20px 60px rgba(0,0,0,0.4)">
            <!-- Sky glow -->
            <div class="absolute inset-0" style="background:radial-gradient(ellipse at 38% 20%,rgba(52,211,153,0.26) 0%,transparent 52%)"></div>
            <!-- Orbital rings -->
            <div class="absolute inset-4 rounded-full" style="border:1px solid rgba(52,211,153,0.14)"></div>
            <div class="absolute inset-[38px] rounded-full" style="border:1px solid rgba(52,211,153,0.09)"></div>
            <!-- Moon crescent -->
            <div class="absolute inset-0 flex items-center" style="justify-content:center;padding-bottom:28%">
              <svg width="130" height="130" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <mask id="moon-h2">
                    <rect width="100" height="100" fill="white"/>
                    <circle cx="62" cy="26" r="36" fill="black"/>
                  </mask>
                </defs>
                <circle cx="36" cy="44" r="32" fill="rgba(52,211,153,0.12)"/>
                <circle cx="38" cy="42" r="33" fill="#34d399" mask="url(#moon-h2)" opacity="0.95"/>
                <circle cx="38" cy="42" r="33" fill="none" stroke="rgba(167,243,208,0.45)" stroke-width="1.5" mask="url(#moon-h2)"/>
              </svg>
            </div>
            <!-- Monkey silhouette -->
            <div class="absolute bottom-0 left-0 right-0 flex justify-center">
              <svg width="160" height="115" viewBox="0 0 160 115" xmlns="http://www.w3.org/2000/svg">
                <ellipse cx="80" cy="106" rx="50" ry="14" fill="rgba(0,0,0,0.55)"/>
                <ellipse cx="80" cy="78" rx="19" ry="23" fill="rgba(0,0,0,0.6)"/>
                <path d="M63 73 Q50 86 54 100" stroke="rgba(0,0,0,0.6)" stroke-width="10" fill="none" stroke-linecap="round"/>
                <path d="M97 73 Q110 86 106 100" stroke="rgba(0,0,0,0.6)" stroke-width="10" fill="none" stroke-linecap="round"/>
                <circle cx="80" cy="50" r="17" fill="rgba(0,0,0,0.62)"/>
                <circle cx="62" cy="47" r="7" fill="rgba(0,0,0,0.62)"/>
                <circle cx="98" cy="47" r="7" fill="rgba(0,0,0,0.62)"/>
                <ellipse cx="80" cy="53" rx="11" ry="8" fill="rgba(0,0,0,0.2)"/>
                <path d="M99 84 Q120 70 116 52 Q113 40 124 35" stroke="rgba(0,0,0,0.45)" stroke-width="5" fill="none" stroke-linecap="round"/>
              </svg>
            </div>
            <!-- Particles -->
            <div class="absolute top-[14%] left-[20%] w-1 h-1 rounded-full" style="background:rgba(52,211,153,0.85)"></div>
            <div class="absolute top-[26%] right-[17%] w-1.5 h-1.5 rounded-full" style="background:rgba(52,211,153,0.6)"></div>
            <div class="absolute top-[42%] right-[11%] w-1 h-1 rounded-full" style="background:rgba(134,239,172,0.5)"></div>
            <div class="absolute top-[55%] left-[10%] w-1 h-1 rounded-full" style="background:rgba(52,211,153,0.45)"></div>
          </div>

          <!-- Floating card: JUNGLA ACTIVA -->
          <div class="absolute -bottom-7 -right-2 sm:-right-7 bg-white shadow-xl rounded-2xl px-4 py-3.5 border border-slate-100" style="min-width:172px">
            <p class="font-mono text-[9px] tracking-widest text-emerald-600 uppercase mb-1">JUNGLA ACTIVA</p>
            <div class="flex items-baseline gap-1.5 mb-1">
              <span class="text-xl font-bold text-slate-900 font-mono leading-none">2,847</span>
              <span class="text-xs font-semibold text-slate-500">Monkeys</span>
            </div>
            <div class="flex items-center gap-1.5 mb-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
              <p class="font-mono text-[9px] text-slate-400">Aprendiendo ahora</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="flex -space-x-1.5">
                <div class="w-5 h-5 rounded-full border-2 border-white flex items-center justify-center text-[7px] font-bold text-white" style="background:#34d399">M</div>
                <div class="w-5 h-5 rounded-full border-2 border-white flex items-center justify-center text-[7px] font-bold text-white" style="background:#a78bfa">A</div>
                <div class="w-5 h-5 rounded-full border-2 border-white flex items-center justify-center text-[7px] font-bold text-white" style="background:#38bdf8">P</div>
                <div class="w-5 h-5 rounded-full border-2 border-white flex items-center justify-center text-[7px] font-bold text-white" style="background:#fb923c">S</div>
                <div class="w-5 h-5 rounded-full border-2 border-white flex items-center justify-center text-[7px] font-bold text-white" style="background:#f43f5e">L</div>
              </div>
              <span class="font-mono text-[9px] text-slate-400">+142</span>
            </div>
          </div>

          <!-- Hexagonal badge top-right -->
          <div class="absolute -top-4 -right-4 sm:-right-8 flex items-center justify-center" style="width:54px;height:54px">
            <svg width="54" height="54" viewBox="0 0 54 54" xmlns="http://www.w3.org/2000/svg" style="position:absolute;inset:0">
              <path d="M27 2L51 15.5L51 38.5L27 52L3 38.5L3 15.5Z" fill="#10b981"/>
              <path d="M27 6L48 18L48 36L27 48L6 36L6 18Z" fill="none" stroke="rgba(255,255,255,0.18)" stroke-width="1"/>
            </svg>
            <svg width="20" height="20" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" style="position:relative;z-index:1">
              <defs><mask id="mk-hx"><rect width="20" height="20" fill="white"/><circle cx="13" cy="6" r="6" fill="black"/></mask></defs>
              <circle cx="9" cy="8" r="7" fill="white" mask="url(#mk-hx)" opacity="0.95"/>
            </svg>
          </div>

        </div>
      </div>

    </div>
    <!-- Language bar -->
    <div class="border-t border-slate-100 pt-6 mt-12">
      <LanguageBar />
    </div>
  </section>

  <!-- Benefits band -->
  <div class="bg-white border border-slate-100 rounded-2xl shadow-sm px-6 sm:px-10 py-7 my-10">
    <div class="grid grid-cols-2 lg:grid-cols-4 divide-y-2 lg:divide-y-0 lg:divide-x-2 divide-slate-50">
      <div class="flex items-start gap-3.5 pb-5 lg:pb-0 lg:pr-8">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center shrink-0">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5-10-5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
          </svg>
        </div>
        <div>
          <p class="font-semibold text-slate-900 text-sm mb-1">Aprende</p>
          <p class="text-xs text-slate-500 leading-relaxed">Conceptos claros. Fundamentos sólidos.</p>
        </div>
      </div>
      <div class="flex items-start gap-3.5 pt-5 lg:pt-0 lg:px-8">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center shrink-0">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
          </svg>
        </div>
        <div>
          <p class="font-semibold text-slate-900 text-sm mb-1">Construyes</p>
          <p class="text-xs text-slate-500 leading-relaxed">Sistemas reales. Proyectos con IA.</p>
        </div>
      </div>
      <div class="flex items-start gap-3.5 pb-5 lg:pb-0 lg:px-8">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center shrink-0">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <div>
          <p class="font-semibold text-slate-900 text-sm mb-1">Compartes</p>
          <p class="text-xs text-slate-500 leading-relaxed">La jungla crece contigo.</p>
        </div>
      </div>
      <div class="flex items-start gap-3.5 pt-5 lg:pt-0 lg:pl-8">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center shrink-0">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>
          </svg>
        </div>
        <div>
          <p class="font-semibold text-slate-900 text-sm mb-1">Evolucionas</p>
          <p class="text-xs text-slate-500 leading-relaxed">De aprendiz a operador. De operador a líder.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- El ecosistema -->
  <section class="py-16 border-b border-slate-200">
    <span class="label block mb-3">EL ECOSISTEMA</span>
    <p class="text-slate-500 text-sm leading-relaxed max-w-xl mb-10">
      Tres capas. Una entidad que diseña, un laboratorio que forma, una metodología que estructura el camino.
    </p>
    <div class="relative">
      {ecosistema.map((e, i) => (
        <div class={`relative pl-8 ${i < ecosistema.length - 1 ? 'pb-9 border-l-2 border-slate-200' : 'border-l-2 border-transparent'}`}>
          <span class={`absolute -left-[7px] top-1 w-3 h-3 rounded-full ${e.dot} ring-4 ring-[#f8fafc]`}></span>
          <p class={`font-mono text-[10px] tracking-widest uppercase mb-1.5 ${e.lbl}`}>{e.layer}</p>
          <h3 class="text-xl font-bold text-slate-900 mb-1.5">{e.name}</h3>
          <p class="text-slate-500 text-sm leading-relaxed max-w-md">{e.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- No somos una escuela -->
  <section class="py-20 border-b border-slate-200">
    <span class="label block mb-8">NO SOMOS UNA ESCUELA</span>
    <div class="space-y-4 max-w-2xl">
      <p class="text-2xl sm:text-3xl font-bold text-slate-300 leading-snug tracking-tight">
        La mayoría de cursos enseñan herramientas.
      </p>
      <p class="text-2xl sm:text-3xl font-bold text-slate-900 leading-snug tracking-tight">
        MOONKEY LAB enseña a construir sistemas.
      </p>
    </div>
    <div class="mt-12 pt-8 border-t border-slate-200 max-w-2xl">
      <p class="text-base text-slate-500 leading-relaxed mb-1.5">El objetivo no es consumir contenido.</p>
      <p class="text-base text-slate-900 font-semibold leading-relaxed">El objetivo es desarrollar criterio operativo.</p>
    </div>
  </section>

  <!-- Para quién es -->
  <section class="py-16 border-b border-slate-200">
    <span class="label block mb-3">¿PARA QUIÉN ES?</span>
    <p class="text-slate-500 text-sm leading-relaxed max-w-xl mb-8">
      Para quien quiere dejar de usar IA por impulso y empezar a operarla con criterio.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {audiencia.map(a => (
        <div class="bg-white border border-slate-200 rounded-2xl p-6 hover:border-slate-300 transition-colors">
          <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase mb-3">{a.tag}</p>
          <h3 class="text-base font-bold text-slate-900 mb-1.5">{a.title}</h3>
          <p class="text-slate-500 text-sm leading-relaxed">{a.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Progreso global -->
  <section class="py-10 border-b border-slate-200">
    <div class="flex items-center justify-between mb-4">
      <span class="label">TU PROGRESO</span>
      <span class="font-mono text-xs text-slate-500"><span id="progress-count">0</span>/3 niveles completados</span>
    </div>
    <div class="flex gap-3 mb-1.5">
      <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
        <div id="dot-l1" class="h-full w-1/3 bg-slate-200 rounded-full transition-colors duration-500"></div>
      </div>
      <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
        <div id="dot-l2" class="h-full w-full bg-slate-200 rounded-full transition-colors duration-500"></div>
      </div>
      <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
        <div id="dot-l3" class="h-full w-full bg-slate-200 rounded-full transition-colors duration-500"></div>
      </div>
    </div>
    <div class="flex gap-3 mb-4">
      <span class="flex-1 font-mono text-[10px] text-slate-400 text-center">Key 1</span>
      <span class="flex-1 font-mono text-[10px] text-slate-400 text-center">Key 2</span>
      <span class="flex-1 font-mono text-[10px] text-slate-400 text-center">Key 3</span>
    </div>
    <a href="/cuenta" class="font-mono text-xs text-slate-400 hover:text-emerald-600 transition-colors">Sincronizar progreso en la nube →</a>
  </section>

  <!-- Operator Path dark block -->
  <section class="py-10 border-b border-slate-200">
    <div class="bg-slate-900 rounded-2xl overflow-hidden">
      <div class="px-7 sm:px-9 py-8">
        <span class="font-mono text-[10px] tracking-widest text-emerald-400 uppercase block mb-3">OPERATOR PATH — METODOLOGÍA MOONKEY XN</span>
        <h2 class="text-xl font-bold text-white mb-2 leading-snug">De aprendiz a operador.</h2>
        <p class="text-slate-400 text-sm leading-relaxed mb-7 max-w-lg">Tres Keys. Cada una desbloquea la siguiente. Un sistema que no desaparece cuando cierras el chat.</p>
        <div class="grid sm:grid-cols-3 gap-px bg-white/[0.06] rounded-xl overflow-hidden mb-5">
          <div class="bg-slate-800/70 px-5 py-5">
            <span class="font-mono text-[10px] text-emerald-400 tracking-widest uppercase block mb-2">KEY 1</span>
            <p class="text-white text-sm font-semibold mb-1.5">Operator Foundations</p>
            <p class="text-slate-400 text-xs leading-relaxed">Terminal, GitHub, CLAUDE.md, prompts y primera automatización.</p>
          </div>
          <div class="bg-slate-800/70 px-5 py-5 border-t sm:border-t-0 sm:border-l border-white/[0.06]">
