---
import Layout from '../components/Layout.astro';
import LanguageBar from '../components/LanguageBar.astro';

const level1Outcomes = [
  'Terminal, VS Code y Claude Code operativos',
  'Primer repositorio en GitHub con historial limpio',
  'CLAUDE.md propio configurado y funcionando',
  'Prompts operativos que producen trabajo usable',
  'Primera automatización mapeada y documentada',
  'Proyecto publicado con URL real',
];

const level2Outcomes = [
  'Arquitectura de proyectos profesional',
  'Control de contexto y tokens optimizado',
  'Git workflow con commits y ramas',
  'Debugging sistemático sin depender ciegamente de IA',
  'Refactors seguros con validación por fases',
  'SOPs de deploy y documentación operativa',
];

const level3Outcomes = [
  'CLAUDE.md centralizado con contexto migrado',
  'Carpeta /prompts con prompts operativos propios',
  'Workflows documentados y listos para ejecutar',
  'Backlog de automatizaciones priorizado',
  'README operativo completo',
  'Sistema de trabajo con Claude Code desde cero',
];

const servicios = [
  { label: 'Escuela interna de IA para equipos',          color: 'text-emerald-600' },
  { label: 'Sistema de prompts y SOPs operativos',        color: 'text-sky-600'     },
  { label: 'Migración ChatGPT → Claude',                  color: 'text-violet-600'  },
  { label: 'Automatización de workflows de trabajo',      color: 'text-amber-600'   },
  { label: 'Documentación operativa de procesos',         color: 'text-rose-600'    },
  { label: 'Portal interno de formación personalizado',   color: 'text-teal-600'    },
];
---

<Layout title="Inicio" description="Escuela modular para aprender a operar IA, automatizaciones y sistemas creativos.">

  <!-- Hero -->
  <section class="pb-16 border-b border-slate-200">
    <span class="label block mb-6">MOONKEY XN SCHOOL · MMXXVI</span>
    <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 leading-tight tracking-tight mb-5">
      Aprende a operar IA.<br/>
      <span class="text-emerald-600">Nivel a nivel.</span>
    </h1>
    <p class="text-slate-600 text-base leading-relaxed max-w-xl mb-3">
      Escuela modular para aprender a operar IA, automatizaciones y sistemas creativos. Sin teoría infinita. Sin cursos interminables. Tres niveles desbloqueables con ejercicios reales, entregables concretos y progresión clara.
    </p>
    <p class="text-slate-400 text-sm mb-10 font-mono">
      No necesitas saber programar. Necesitas querer construir cosas.
    </p>
    <div class="flex flex-wrap gap-3 mb-8">
      <a href="/modulos" class="inline-block font-mono text-sm font-medium text-white bg-emerald-500 px-6 py-3 rounded-xl hover:bg-emerald-600 transition-colors shadow-sm">
        Empezar Nivel 1 →
      </a>
      <a href="/prueba-operador" class="inline-block font-mono text-sm text-slate-600 border border-slate-300 px-6 py-3 rounded-xl hover:bg-slate-50 transition-colors">
        Ver prueba de operador
      </a>
    </div>
    <!-- Universal callout + language bar -->
    <div class="border-t border-slate-100 pt-6 space-y-3">
      <p class="text-slate-400 text-xs leading-relaxed max-w-lg">
        <span class="text-slate-600 font-medium">A universal school for AI operators.</span> Diseñada para que cualquier persona, desde cualquier país, pueda aprender a convertir IA, prompts, automatizaciones y documentación en sistemas reales de trabajo.
      </p>
      <LanguageBar />
    </div>
  </section>

  <!-- Progreso global -->
  <section class="py-10 border-b border-slate-200">
    <div class="flex items-center justify-between mb-4">
      <span class="label">TU PROGRESO</span>
      <span class="font-mono text-xs text-slate-500"><span id="progress-count">0</span>/3 niveles completados</span>
    </div>
    <div class="flex gap-3">
      <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
        <div id="dot-l1" class="h-full w-1/3 bg-slate-200 rounded-full transition-colors duration-500"></div>
      </div>
      <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
        <div id="dot-l2" class="h-full w-full bg-slate-200 rounded-full transition-colors duration-500"></div>
      </div>
      <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
        <div id="dot-l3" class="h-full w-full bg-slate-200 rounded-full transition-colors duration-500"></div>
      </div>
    </div>
  </section>

  <!-- Escuela completada (hidden by default) -->
  <div id="school-complete-banner" class="hidden mt-8 bg-emerald-50 border-2 border-emerald-300 rounded-2xl px-8 py-7 text-center">
    <span class="label block mb-2">ESCUELA COMPLETADA</span>
    <h2 class="text-xl font-bold text-slate-900 mb-2">MOONKEY XN SCHOOL completada</h2>
    <p class="text-slate-600 text-sm max-w-md mx-auto">Has completado los tres niveles. Ya operas sistemas IA con criterio y autonomía. Lo que viene ahora lo decides tú.</p>
  </div>

  <!-- Nivel 1 -->
  <section class="pt-12">
    <div class="bg-white border-2 border-emerald-200 rounded-2xl p-7 shadow-sm hover:shadow-md transition-shadow mb-6">
      <div class="flex items-center justify-between mb-5">
        <span class="bg-emerald-100 text-emerald-700 font-mono text-xs font-bold px-2.5 py-1 rounded-lg">NIVEL 1</span>
        <div class="flex items-center gap-2">
          <span id="l1-completed-badge" class="hidden bg-emerald-500 text-white font-mono text-xs px-2.5 py-0.5 rounded-lg">✓ Completado</span>
          <span id="l1-status" class="font-mono text-xs text-emerald-600 font-semibold">Disponible</span>
        </div>
      </div>
      <h2 class="text-xl font-bold text-slate-900 mb-1">Operator Foundations</h2>
      <p class="text-slate-500 text-sm leading-relaxed mb-5">
        La base para operar Claude Code, GitHub, automatizaciones y sistemas IA. 8 módulos prácticos con ejercicios reales y entregables concretos.
      </p>
      <ul class="space-y-2 mb-6">
        {level1Outcomes.map(o => (
          <li class="flex items-center gap-2.5 text-xs text-slate-500">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
            {o}
          </li>
        ))}
      </ul>
      <a href="/modulos" class="block w-full text-center font-mono text-sm font-medium text-white bg-emerald-500 px-5 py-3 rounded-xl hover:bg-emerald-600 transition-colors">
        Empezar Nivel 1 →
      </a>
    </div>

    <!-- Nivel 2 -->
    <div class="relative bg-white border-2 border-violet-200 rounded-2xl p-7 shadow-sm mb-6 overflow-hidden">
      <div id="l2-lock" class="absolute inset-0 bg-white/[0.88] backdrop-blur-[3px] rounded-2xl flex flex-col items-center justify-center z-10 gap-3">
        <span class="font-mono text-xs text-slate-400 tracking-widest uppercase">Bloqueado</span>
        <p class="text-slate-600 text-sm text-center max-w-[200px]">Completa Nivel 1 para desbloquear este contenido</p>
        <a href="/modulos" class="font-mono text-xs text-violet-600 border border-violet-200 px-3 py-1.5 rounded-lg hover:bg-violet-50 transition-colors">
          Ir a Nivel 1 →
        </a>
      </div>
      <div class="flex items-center justify-between mb-5">
        <span class="bg-violet-100 text-violet-700 font-mono text-xs font-bold px-2.5 py-1 rounded-lg">NIVEL 2</span>
        <div class="flex items-center gap-2">
          <span id="l2-completed-badge" class="hidden bg-violet-500 text-white font-mono text-xs px-2.5 py-0.5 rounded-lg">✓ Completado</span>
          <span id="l2-status" class="font-mono text-xs text-slate-400">Bloqueado</span>
        </div>
      </div>
      <h2 class="text-xl font-bold text-slate-500 mb-1">Advanced Operator Playbook</h2>
      <p class="text-slate-400 text-sm leading-relaxed mb-5">
        Claude Code como sistema profesional. Arquitectura, debugging, refactors, automatizaciones, MCPs, deploy y documentación operativa avanzada.
      </p>
      <ul class="space-y-2 mb-6">
        {level2Outcomes.map(o => (
          <li class="flex items-center gap-2.5 text-xs text-slate-400">
            <span class="w-1.5 h-1.5 rounded-full bg-violet-300 shrink-0"></span>
            {o}
          </li>
        ))}
      </ul>
      <div id="l2-cta-locked" class="block w-full text-center font-mono text-sm font-medium text-slate-400 bg-slate-100 px-5 py-3 rounded-xl cursor-not-allowed">
        Bloqueado — completa Nivel 1
      </div>
      <a id="l2-cta-unlocked" href="/advanced" class="hidden block w-full text-center font-mono text-sm font-medium text-white bg-violet-500 px-5 py-3 rounded-xl hover:bg-violet-600 transition-colors">
        Empezar Nivel 2 →
      </a>
    </div>

    <!-- Nivel 3 -->
    <div class="relative bg-white border-2 border-amber-200 rounded-2xl p-7 shadow-sm mb-6 overflow-hidden">
      <div id="l3-lock" class="absolute inset-0 bg-white/[0.88] backdrop-blur-[3px] rounded-2xl flex flex-col items-center justify-center z-10 gap-3">
        <span class="font-mono text-xs text-slate-400 tracking-widest uppercase">Bloqueado</span>
        <p class="text-slate-600 text-sm text-center max-w-[200px]">Completa Nivel 2 para desbloquear este contenido</p>
        <a href="/advanced" class="font-mono text-xs text-amber-600 border border-amber-200 px-3 py-1.5 rounded-lg hover:bg-amber-50 transition-colors">
          Ir a Nivel 2 →
        </a>
      </div>
      <div class="flex items-center justify-between mb-5">
        <span class="bg-amber-100 text-amber-700 font-mono text-xs font-bold px-2.5 py-1 rounded-lg">NIVEL 3</span>
        <div class="flex items-center gap-2">
          <span id="l3-completed-badge" class="hidden bg-amber-500 text-white font-mono text-xs px-2.5 py-0.5 rounded-lg">✓ Completado</span>
          <span id="l3-status" class="font-mono text-xs text-slate-400">Bloqueado</span>
        </div>
      </div>
      <h2 class="text-xl font-bold text-slate-500 mb-1">ChatGPT → Claude Migration System</h2>
      <p class="text-slate-400 text-sm leading-relaxed mb-5">
        Convierte conversaciones, prompts, decisiones y workflows dispersos en un sistema operativo propio para trabajar con Claude Code.
      </p>
      <ul class="space-y-2 mb-6">
        {level3Outcomes.map(o => (
          <li class="flex items-center gap-2.5 text-xs text-slate-400">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-300 shrink-0"></span>
            {o}
          </li>
        ))}
      </ul>
      <div id="l3-cta-locked" class="block w-full text-center font-mono text-sm font-medium text-slate-400 bg-slate-100 px-5 py-3 rounded-xl cursor-not-allowed">
        Bloqueado — completa Nivel 2
      </div>
      <a id="l3-cta-unlocked" href="/migrador" class="hidden block w-full text-center font-mono text-sm font-medium text-white bg-amber-500 px-5 py-3 rounded-xl hover:bg-amber-600 transition-colors">
        Empezar Nivel 3 →
      </a>
    </div>
  </section>

  <!-- De escuela a sistema -->
  <section class="py-16 border-t border-slate-200">
    <span class="label block mb-3">DE ESCUELA A SISTEMA</span>
    <p class="text-slate-500 text-sm leading-relaxed max-w-xl mb-10">
      MOONKEY XN SCHOOL no es solo una formación. Es el punto de entrada a una metodología de trabajo. Tres caminos, un mismo destino: operar IA con criterio.
    </p>
    <div class="grid sm:grid-cols-3 gap-5 mb-10">
      {[
        {
          who: 'El que aprende solo',
          desc: 'Entra, sigue la escuela, desbloquea las 3 Keys y sale con un sistema de trabajo real. Sin depender de nadie.',
          tag: 'Monkeys',
          href: '/monkeys',
          bg: 'bg-emerald-50',
          border: 'border-emerald-200',
          text: 'text-emerald-700',
          lbl: 'text-emerald-500',
        },
        {
          who: 'El que quiere escalar',
          desc: 'Accede a niveles avanzados, soporte de implementación y recursos adicionales cuando estén disponibles.',
          tag: 'Planes',
          href: '/planes',
          bg: 'bg-violet-50',
          border: 'border-violet-200',
          text: 'text-violet-700',
          lbl: 'text-violet-500',
        },
        {
          who: 'El que necesita ayuda',
          desc: 'Dudas técnicas, acceso piloto, implementación para equipos. Contacto directo, sin formularios.',
          tag: 'Soporte',
          href: '/soporte',
          bg: 'bg-amber-50',
          border: 'border-amber-200',
          text: 'text-amber-700',
          lbl: 'text-amber-500',
        },
      ].map(c => (
        <a href={c.href} class={`${c.bg} border ${c.border} rounded-2xl p-6 flex flex-col gap-3 hover:shadow-sm transition-shadow`}>
          <span class={`font-mono text-xs font-bold ${c.lbl}`}>{c.tag}</span>
          <h3 class={`font-semibold text-sm ${c.text}`}>{c.who}</h3>
          <p class="text-slate-500 text-xs leading-relaxed flex-1">{c.desc}</p>
          <span class={`font-mono text-xs font-medium ${c.text}`}>Ver más →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Qué puedes hacer -->
  <section class="py-16 border-t border-slate-200">
    <span class="label block mb-10">¿QUÉ QUIERES HACER?</span>
    <div class="grid sm:grid-cols-3 gap-4">
      {[
        {
          path: 'Quiero aprender',
          desc: 'Empieza por el Nivel 1. Sin prerequisitos. Sin código previo.',
          cta: 'Nivel 1 →',
          href: '/modulos',
          bg: 'bg-emerald-50',
          border: 'border-emerald-200',
          text: 'text-emerald-700',
          ctaClass: 'text-emerald-600 hover:text-emerald-800',
        },
        {
          path: 'Quiero trabajar contigo',
          desc: 'Hay una prueba de 60 minutos para detectar operadores. Una tarea real, un entregable concreto.',
          cta: 'Ver prueba →',
          href: '/prueba-operador',
          bg: 'bg-sky-50',
          border: 'border-sky-200',
          text: 'text-sky-700',
          ctaClass: 'text-sky-600 hover:text-sky-800',
        },
        {
          path: 'Ver planes de acceso',
          desc: 'Acceso libre en fase piloto. Niveles avanzados y soporte dedicado próximamente.',
          cta: 'Ver planes →',
          href: '/planes',
          bg: 'bg-violet-50',
          border: 'border-violet-200',
          text: 'text-violet-700',
          ctaClass: 'text-violet-600 hover:text-violet-800',
        },
      ].map(p => (
        <div class={`${p.bg} border ${p.border} rounded-2xl p-6 flex flex-col gap-3`}>
          <h3 class={`font-semibold text-sm ${p.text}`}>{p.path}</h3>
          <p class="text-slate-500 text-xs leading-relaxed flex-1">{p.desc}</p>
          <a href={p.href} class={`font-mono text-xs font-medium ${p.ctaClass} transition-colors`}>{p.cta}</a>
        </div>
      ))}
    </div>
  </section>

  <!-- Sección comercial -->
  <section id="servicios" class="py-16 border-t border-slate-200">
    <div class="bg-slate-900 rounded-2xl px-8 sm:px-10 py-10">
      <span class="font-mono text-xs tracking-widest uppercase text-emerald-400 block mb-4">SERVICIOS</span>
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3 leading-snug">
        También podemos construir<br/>esto para tu equipo.
      </h2>
      <p class="text-slate-400 text-sm leading-relaxed mb-8 max-w-lg">
        Lo que enseña esta escuela también lo construimos como sistema interno para organizaciones. Desde un portal de formación hasta un sistema completo de prompts, SOPs y automatizaciones.
      </p>
      <div class="grid sm:grid-cols-2 gap-2 mb-8">
        {servicios.map(s => (
          <div class="flex items-center gap-3">
            <span class={`font-mono text-xs font-bold shrink-0 ${s.color}`}>—</span>
            <span class="text-slate-300 text-sm">{s.label}</span>
          </div>
        ))}
      </div>
      <a href="/onboarding" class="inline-block font-mono text-sm font-medium text-slate-900 bg-emerald-400 px-6 py-3 rounded-xl hover:bg-emerald-300 transition-colors">
        Ver proceso de colaboración →
      </a>
    </div>
  </section>

  <!-- Ecosistema impulsor -->
  <section class="py-14 border-t border-slate-200">
    <span class="label block mb-2">ECOSISTEMA IMPULSOR</span>
    <p class="text-slate-500 text-sm leading-relaxed max-w-xl mb-8">
      MOONKEY XN SCHOOL nace conectada a una red de laboratorios, agencias y sistemas en construcción.
    </p>
    <div class="grid sm:grid-cols-3 gap-4">
      {[
        { name: '01 Agency', desc: 'Creative systems & AI implementation' },
        { name: 'XNLab', desc: 'Digital atmosphere, product labs & creative infrastructure' },
        { name: 'Connect', desc: 'Relationship intelligence & opportunity systems' },
      ].map(p => (
        <div class="bg-white border border-slate-200 rounded-xl px-5 py-5 shadow-sm">
          <p class="font-mono text-xs font-bold text-slate-700 mb-1.5">{p.name}</p>
          <p class="text-slate-400 text-xs leading-relaxed">{p.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Reiniciar progreso -->
  <section class="py-8 border-t border-slate-200 flex items-center justify-between">
    <span class="text-slate-300 text-xs font-mono">MOONKEY XN SCHOOL · MMXXVI</span>
    <button
      id="reset-progress-btn"
      class="font-mono text-xs text-slate-300 hover:text-rose-400 transition-colors cursor-pointer"
    >
      Reiniciar progreso
    </button>
  </section>

</Layout>

<script is:inline>
  (function () {
    var l1 = localStorage.getItem('moonkey_level_1_completed') === 'true';
    var l2 = localStorage.getItem('moonkey_level_2_completed') === 'true';
    var l3 = localStorage.getItem('moonkey_level_3_completed') === 'true';
    var count = (l1 ? 1 : 0) + (l2 ? 1 : 0) + (l3 ? 1 : 0);

    var progEl = document.getElementById('progress-count');
    if (progEl) progEl.textContent = count;

    if (l1) {
      var d1 = document.getElementById('dot-l1');
      if (d1) { d1.classList.remove('bg-slate-200'); d1.classList.add('bg-emerald-500'); }
    }
    if (l2) {
      var d2 = document.getElementById('dot-l2');
      if (d2) { d2.classList.remove('bg-slate-200'); d2.classList.add('bg-violet-500'); }
    }
    if (l3) {
      var d3 = document.getElementById('dot-l3');
      if (d3) { d3.classList.remove('bg-slate-200'); d3.classList.add('bg-amber-500'); }
    }

    function hideLock(id) {
      var el = document.getElementById(id);
      if (el) el.style.display = 'none';
    }
    function showBadge(id, statusId, text, cls) {
      var badge = document.getElementById(id);
      if (badge) badge.classList.remove('hidden');
      var status = document.getElementById(statusId);
      if (status) { status.textContent = text; if (cls) status.className = cls; }
    }

    // L1
    if (l1) {
      showBadge('l1-completed-badge', 'l1-status', 'Completado', 'font-mono text-xs text-emerald-600 font-semibold');
    }

    // L2
    if (l1 && !l2) {
      hideLock('l2-lock');
      var s2 = document.getElementById('l2-status');
      if (s2) { s2.textContent = 'Disponible'; s2.className = 'font-mono text-xs text-violet-600 font-semibold'; }
      var l2locked = document.getElementById('l2-cta-locked');
      var l2unlocked = document.getElementById('l2-cta-unlocked');
      if (l2locked) l2locked.classList.add('hidden');
      if (l2unlocked) l2unlocked.classList.remove('hidden');
    }
    if (l2) {
      hideLock('l2-lock');
      showBadge('l2-completed-badge', 'l2-status', 'Completado', 'font-mono text-xs text-violet-600 font-semibold');
      var l2locked2 = document.getElementById('l2-cta-locked');
      var l2unlocked2 = document.getElementById('l2-cta-unlocked');
      if (l2locked2) l2locked2.classList.add('hidden');
      if (l2unlocked2) l2unlocked2.classList.remove('hidden');
    }

    // L3
    if (l2 && !l3) {
      hideLock('l3-lock');
      var s3 = document.getElementById('l3-status');
      if (s3) { s3.textContent = 'Disponible'; s3.className = 'font-mono text-xs text-amber-600 font-semibold'; }
      var l3locked = document.getElementById('l3-cta-locked');
      var l3unlocked = document.getElementById('l3-cta-unlocked');
      if (l3locked) l3locked.classList.add('hidden');
      if (l3unlocked) l3unlocked.classList.remove('hidden');
    }
    if (l3) {
      hideLock('l3-lock');
      showBadge('l3-completed-badge', 'l3-status', 'Completado', 'font-mono text-xs text-amber-600 font-semibold');
      var l3locked2 = document.getElementById('l3-cta-locked');
      var l3unlocked2 = document.getElementById('l3-cta-unlocked');
      if (l3locked2) l3locked2.classList.add('hidden');
      if (l3unlocked2) l3unlocked2.classList.remove('hidden');
    }

    // School complete
    if (l1 && l2 && l3) {
      var banner = document.getElementById('school-complete-banner');
      if (banner) banner.classList.remove('hidden');
    }

    // Reset
    var resetBtn = document.getElementById('reset-progress-btn');
    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        if (confirm('¿Reiniciar todo el progreso de MOONKEY XN SCHOOL?')) {
          localStorage.removeItem('moonkey_level_1_completed');
          localStorage.removeItem('moonkey_level_2_completed');
          localStorage.removeItem('moonkey_level_3_completed');
          window.location.reload();
        }
      });
    }
  })();
</script>
