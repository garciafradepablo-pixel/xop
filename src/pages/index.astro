            <span class={`font-mono text-xs font-bold shrink-0 ${s.color}`}>—</span>
            <span class="text-slate-300 text-sm">{s.label}</span>
          </div>
        ))}
      </div>
      <div class="flex flex-wrap gap-3 items-center">
        <a href={localizedPath('/onboarding', locale)} class="inline-block font-mono text-sm font-medium text-slate-900 bg-emerald-400 px-6 py-3 rounded-xl hover:bg-emerald-300 transition-colors">
          {t('services.cta.1')}
        </a>
        <a href={localizedPath('/planes', locale)} class="inline-block font-mono text-sm text-slate-400 border border-slate-600 px-5 py-3 rounded-xl hover:border-slate-400 transition-colors">
          {t('services.cta.2')}
        </a>
      </div>
    </div>
  </section>

  <!-- Reiniciar progreso -->
  <section class="py-8 border-t border-slate-200 flex items-center justify-between">
    <span class="text-slate-300 text-xs font-mono">MOONKEY LAB · MMXXVI</span>
    <button
      id="reset-progress-btn"
      data-confirm={c.resetConfirm}
      class="font-mono text-xs text-slate-300 hover:text-rose-400 transition-colors cursor-pointer"
    >
      {c.resetLabel}
    </button>
  </section>

</Layout>

<style>
  .mk-particle {
    position: absolute;
    border-radius: 50%;
    background: rgba(52, 211, 153, 0.4);
  }
  @media (prefers-reduced-motion: no-preference) {
    .mk-particle {
      animation: mk-float 5.5s ease-in-out infinite alternate;
    }
  }
  @keyframes mk-float {
    from { transform: translateY(0px); opacity: 0.3; }
    to   { transform: translateY(-8px); opacity: 0.5; }
  }
</style>

<script is:inline>
  (function () {
    var l1 = localStorage.getItem('moonkey_level_1_completed') === 'true';
    var l2 = localStorage.getItem('moonkey_level_2_completed') === 'true';
    var l3 = localStorage.getItem('moonkey_level_3_completed') === 'true';
    var count = (l1 ? 1 : 0) + (l2 ? 1 : 0) + (l3 ? 1 : 0);

    var l1c = 0; for (var j = 0; j <= 7; j++) { if (localStorage.getItem('moonkey_level_1_module_' + j) === 'true') l1c++; }
    var l2c = 0; for (var j = 1; j <= 10; j++) { if (localStorage.getItem('moonkey_level_2_module_' + j) === 'true') l2c++; }
    var l3c = 0; for (var j = 1; j <= 8; j++) { if (localStorage.getItem('moonkey_level_3_section_' + j) === 'true') l3c++; }
    var el1p = document.getElementById('l1-progress'); if (el1p) el1p.textContent = l1c + '/8';
    var el2p = document.getElementById('l2-progress'); if (el2p) el2p.textContent = l2c + '/10';
    var el3p = document.getElementById('l3-progress'); if (el3p) el3p.textContent = l3c + '/8';

    var progEl = document.getElementById('progress-count');
    if (progEl) progEl.textContent = count;

    if (l1) {
      var d1 = document.getElementById('dot-l1');
      if (d1) { d1.classList.remove('bg-slate-200'); d1.classList.add('bg-emerald-500'); }
    }
    if (l2) {
      var d2 = document.getElementById('dot-l2');
      if (d2) { d2.classList.remove('bg-slate-200'); d2.classList.add('bg-violet-500'); }
    }
    if (l3) {
      var d3 = document.getElementById('dot-l3');
      if (d3) { d3.classList.remove('bg-slate-200'); d3.classList.add('bg-amber-500'); }
    }

    function hideLock(id) {
      var el = document.getElementById(id);
      if (el) el.style.display = 'none';
    }
    function showBadge(id, statusId, text, cls) {
      var badge = document.getElementById(id);
      if (badge) badge.classList.remove('hidden');
      var status = document.getElementById(statusId);
      if (status) { status.textContent = text; if (cls) status.className = cls; }
    }

    // L1
    if (l1) {
      showBadge('l1-completed-badge', 'l1-status', 'Completado', 'font-mono text-xs text-emerald-600 font-semibold');
    }

    // L2
    if (l1 && !l2) {
      hideLock('l2-lock');
      var s2 = document.getElementById('l2-status');
      if (s2) { s2.textContent = 'Disponible'; s2.className = 'font-mono text-xs text-violet-600 font-semibold'; }
      var l2locked = document.getElementById('l2-cta-locked');
      var l2unlocked = document.getElementById('l2-cta-unlocked');
      if (l2locked) l2locked.classList.add('hidden');
      if (l2unlocked) l2unlocked.classList.remove('hidden');
    }
    if (l2) {
      hideLock('l2-lock');
      showBadge('l2-completed-badge', 'l2-status', 'Completado', 'font-mono text-xs text-violet-600 font-semibold');
      var l2locked2 = document.getElementById('l2-cta-locked');
      var l2unlocked2 = document.getElementById('l2-cta-unlocked');
      if (l2locked2) l2locked2.classList.add('hidden');
      if (l2unlocked2) l2unlocked2.classList.remove('hidden');
    }

    // L3
    if (l2 && !l3) {
      hideLock('l3-lock');
      var s3 = document.getElementById('l3-status');
      if (s3) { s3.textContent = 'Disponible'; s3.className = 'font-mono text-xs text-amber-600 font-semibold'; }
      var l3locked = document.getElementById('l3-cta-locked');
      var l3unlocked = document.getElementById('l3-cta-unlocked');
      if (l3locked) l3locked.classList.add('hidden');
      if (l3unlocked) l3unlocked.classList.remove('hidden');
    }
    if (l3) {
      hideLock('l3-lock');
      showBadge('l3-completed-badge', 'l3-status', 'Completado', 'font-mono text-xs text-amber-600 font-semibold');
      var l3locked2 = document.getElementById('l3-cta-locked');
      var l3unlocked2 = document.getElementById('l3-cta-unlocked');
      if (l3locked2) l3locked2.classList.add('hidden');
      if (l3unlocked2) l3unlocked2.classList.remove('hidden');
    }

    // School complete
    if (l1 && l2 && l3) {
      var banner = document.getElementById('school-complete-banner');
      if (banner) banner.classList.remove('hidden');
    }

    // Reset
    var resetBtn = document.getElementById('reset-progress-btn');
    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        if (confirm(resetBtn.dataset.confirm || '¿Reiniciar todo el progreso de MOONKEY LAB?')) {
          var keys = [
            'moonkey_level_1_completed', 'moonkey_level_2_completed', 'moonkey_level_3_completed',
            'moonkey_level_1_proof_repo', 'moonkey_level_1_proof_url', 'moonkey_synced_uid'
          ];
          for (var i = 0; i <= 7; i++) keys.push('moonkey_level_1_module_' + i);
          for (var i = 1; i <= 10; i++) keys.push('moonkey_level_2_module_' + i);
          for (var i = 1; i <= 8; i++) keys.push('moonkey_level_3_section_' + i);
          keys.forEach(function(k) { localStorage.removeItem(k); });
          // If logged in, also clear the cloud row so the next sync can't resurrect it.
          var reload = function () { window.location.reload(); };
          if (window.__moonkeyResetCloud) { window.__moonkeyResetCloud().then(reload, reload); }
          else { reload(); }
        }
      });
    }

    // Hero product strip — live from localStorage
    var hL1p = document.getElementById('hero-l1-progress');
    if (hL1p) hL1p.textContent = l1c + '/8';
    var hL1bar = document.getElementById('hero-l1-bar');
    if (hL1bar) hL1bar.style.width = Math.round(l1c / 8 * 100) + '%';
    if (l1) {
      var hN2 = document.getElementById('hero-n2-col');
      if (hN2) hN2.style.opacity = '0.82';
    }
  })();
</script>

<script>
  // Reset-cloud bridge for the "Reiniciar progreso" button. Installed SYNCHRONOUSLY
  // (no race against a pending getSession — the old version set this inside a .then(),
  // so a fast click could reset local but skip the cloud). Supabase is imported LAZILY,
  // only when the user actually resets — so the homepage critical path ships no auth SDK
  // (~54KB gzip) for the ~100% of visitors who never click reset.
  (window as any).__moonkeyResetCloud = async function () {
    try {
      const [{ supabase }, { resetCloudProgress }] = await Promise.all([
        import('../lib/supabase'),
        import('../lib/progress'),
      ]);
      if (!supabase) return;
      const { data } = await supabase.auth.getSession();
      const uid = data?.session?.user?.id;
      if (uid) await resetCloudProgress(supabase, uid);
    } catch (e) { /* local reset already happened; cloud best-effort */ }
  };
</script>

<script is:inline>
  /* Scroll reveal — IntersectionObserver fires is-visible on [data-reveal] elements */
  (function () {
    if (typeof IntersectionObserver === 'undefined') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('[data-reveal]').forEach(function (el) {
        el.classList.add('is-visible');
      });
      return;
    }

    function reveal(el) {
      if (el.classList.contains('is-visible')) return;
      var delay = parseInt(el.dataset.delay || '0', 10);
      if (delay > 0) {
        setTimeout(function () { el.classList.add('is-visible'); }, delay);
      } else {
        el.classList.add('is-visible');
      }
    }

    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        reveal(e.target);
        obs.unobserve(e.target);
      });
    }, { threshold: 0.06, rootMargin: '0px 0px -44px 0px' });

    document.querySelectorAll('[data-reveal]').forEach(function (el) {
      obs.observe(el);
    });

    /* Fallback: catch any [data-reveal] already in viewport on load (above fold)
       or revealed by programmatic scroll before IO fires */
    function sweepVisible() {
      document.querySelectorAll('[data-reveal]:not(.is-visible)').forEach(function (el) {
        var r = el.getBoundingClientRect();
        if (r.top < window.innerHeight - 44 && r.bottom > 0) {
          obs.unobserve(el);
          reveal(el);
        }
      });
    }
    window.addEventListener('scroll', sweepVisible, { passive: true });
    setTimeout(sweepVisible, 120);
  })();
</script>

<script is:inline>
  /* Hero cursor glow — follows the pointer, fades out when it leaves the hero */
  (function () {
    if (window.matchMedia('(pointer: coarse)').matches) return;
    var hero = document.getElementById('mk-hero');
    var glow = document.getElementById('mk-hero-glow');
    if (!hero || !glow) return;
    var raf = 0, x = 0, y = 0;
    hero.addEventListener('pointermove', function (e) {
      var r = hero.getBoundingClientRect();
      x = e.clientX - r.left; y = e.clientY - r.top;
      glow.style.opacity = '1';
      if (!raf) raf = requestAnimationFrame(function () {
        raf = 0;
        glow.style.left = x + 'px';
        glow.style.top = y + 'px';
      });
    }, { passive: true });
    hero.addEventListener('pointerleave', function () { glow.style.opacity = '0'; });
  })();
</script>
