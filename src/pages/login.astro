---
import Layout from '../components/Layout.astro';

const configured = !!(
  import.meta.env.PUBLIC_SUPABASE_URL &&
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);
---

<Layout
  title="Acceso"
  description="Accede a MOONKEY LAB para sincronizar tu progreso en la nube."
>
  <section class="pb-10 border-b border-slate-200">
    <span class="label block mb-3">ACCESO</span>
    <h1 class="text-2xl font-bold text-slate-900 mb-3">Entra a tu cuenta.</h1>
    <p class="text-slate-500 text-sm leading-relaxed max-w-md">
      El progreso local siempre funciona sin cuenta. El registro te permite sincronizarlo entre dispositivos y acceder a funciones piloto.
    </p>
    <p class="text-xs text-slate-400 font-mono mt-2">Sistema operado por XNLAB Studio.</p>
  </section>

  {!configured && (
    <section class="py-12">
      <div class="bg-amber-50 border border-amber-200 rounded-2xl p-8 max-w-md">
        <span class="font-mono text-[10px] tracking-widest text-amber-700 uppercase block mb-3">REGISTRO EN NUBE</span>
        <h2 class="text-lg font-bold text-slate-900 mb-3">Configuración pendiente.</h2>
        <p class="text-slate-600 text-sm leading-relaxed mb-4">
          El sistema de registro aún no está activado. El progreso local sigue funcionando en este dispositivo sin necesidad de cuenta.
        </p>
        <div class="border-l-4 border-amber-300 pl-4">
          <p class="text-slate-500 text-xs leading-relaxed font-mono">
            Cuando se active, podrás registrarte con tu email y sincronizar el progreso entre dispositivos.
          </p>
        </div>
      </div>

      <div class="mt-8 bg-emerald-50 border border-emerald-200 rounded-2xl p-6 max-w-md">
        <p class="font-mono text-[10px] tracking-widest text-emerald-700 uppercase mb-3">TU PROGRESO LOCAL</p>
        <p class="text-slate-600 text-sm leading-relaxed mb-4">
          Todo lo que marcas como completado se guarda en este navegador. Puedes seguir usando MOONKEY LAB sin cuenta.
        </p>
        <a href="/modulos" class="inline-block font-mono text-sm font-medium text-white bg-emerald-500 px-5 py-2.5 rounded-xl hover:bg-emerald-600 transition-colors">
          Ir al Nivel 1 →
        </a>
      </div>
    </section>
  )}

  {configured && (
    <section class="py-12">
      <div class="max-w-md">
        <div id="login-form-wrapper" class="bg-white border border-slate-200 rounded-2xl p-8 shadow-sm">
          <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase mb-6">MAGIC LINK — sin contraseña</p>
          <form id="login-form" novalidate>
            <label for="email-input" class="block text-sm font-medium text-slate-700 mb-2">
              Tu email
            </label>
            <input
              id="email-input"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder="tu@email.com"
              class="w-full font-mono text-sm border border-slate-300 rounded-xl px-4 py-3 mb-4 focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:border-transparent"
            />
            <p id="error-msg" class="hidden text-xs text-rose-600 font-mono mb-3 border border-rose-200 bg-rose-50 rounded-lg px-3 py-2"></p>
            <button
              type="submit"
              id="submit-btn"
              class="w-full font-mono text-sm font-medium text-white bg-emerald-500 px-5 py-3 rounded-xl hover:bg-emerald-600 transition-colors disabled:opacity-50"
            >
              Enviar enlace de acceso →
            </button>
          </form>
          <p class="text-center text-[11px] text-slate-400 font-mono mt-4">Sin contraseña. Recibirás un enlace por email.</p>
        </div>

        <div id="success-msg" class="hidden bg-emerald-50 border border-emerald-200 rounded-2xl p-8">
          <p class="font-mono text-[10px] tracking-widest text-emerald-700 uppercase mb-3">ENLACE ENVIADO</p>
          <h2 class="text-lg font-bold text-slate-900 mb-2">Revisa tu bandeja de entrada.</h2>
          <p class="text-slate-600 text-sm leading-relaxed">
            Te hemos enviado un enlace de acceso. Haz clic en él para entrar. Válido durante 1 hora.
          </p>
        </div>
      </div>
    </section>
  )}
</Layout>

<!-- Script unconditional so Astro/Vite bundles it correctly.
     Runtime guard handles the unconfigured case. -->
<script>
  import { supabase } from '../lib/supabase';

  (async () => {
    // If Supabase not configured or form not in DOM (pending-state shown), do nothing.
    const form = document.getElementById('login-form');
    if (!supabase || !form) return;

    const errorMsg = document.getElementById('error-msg');
    const successMsg = document.getElementById('success-msg');
    const formWrapper = document.getElementById('login-form-wrapper');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const input = (form as HTMLFormElement).querySelector('[name="email"]') as HTMLInputElement;
      const email = input?.value?.trim();
      if (!email) return;

      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Enviando…'; }
      if (errorMsg) errorMsg.classList.add('hidden');

      const { error } = await supabase.auth.signInWithOtp({
        email,
        options: { emailRedirectTo: `${location.origin}/cuenta/` },
      });

      if (error) {
        if (errorMsg) {
          errorMsg.textContent = error.message;
          errorMsg.classList.remove('hidden');
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Enviar enlace de acceso →';
        }
        console.error('[login] signInWithOtp error:', error.message);
      } else {
        formWrapper?.classList.add('hidden');
        successMsg?.classList.remove('hidden');
      }
    });
  })();
</script>
