---
import Layout from '../components/Layout.astro';
import { resolveLocale, localizedPath, useTranslations } from '../i18n/utils';

const configured = !!(
  import.meta.env.PUBLIC_SUPABASE_URL &&
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const t = useTranslations(locale);
---

<Layout
  title={t('login.meta.title')}
  description={t('login.meta.desc')}
>
  <div class="max-w-md mx-auto">

    <!-- Hero -->
    <section class="pt-4 pb-8 text-center">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl mb-5" style="background:linear-gradient(160deg,#0b1220,#0f172a);box-shadow:0 8px 24px -10px rgba(16,185,129,0.4)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </div>
      <span class="label block mb-3">{t('login.label')}</span>
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight mb-3">{t('login.h1')}</h1>
      <p class="text-slate-500 text-sm leading-relaxed mx-auto max-w-sm">
        {t('login.intro')}
      </p>
    </section>

    {!configured && (
      <section class="space-y-5">
        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-7">
          <div class="flex items-center gap-2.5 mb-3">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#b45309" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span class="font-mono text-[10px] tracking-widest text-amber-700 uppercase">{t('login.pending.label')}</span>
          </div>
          <h2 class="text-lg font-bold text-slate-900 mb-2.5">{t('login.pending.title')}</h2>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">{t('login.pending.desc')}</p>
          <div class="border-l-4 border-amber-300 pl-4">
            <p class="text-slate-500 text-xs leading-relaxed font-mono">{t('login.pending.note')}</p>
          </div>
        </div>

        <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-7">
          <p class="font-mono text-[10px] tracking-widest text-emerald-700 uppercase mb-3">{t('login.local.label')}</p>
          <p class="text-slate-600 text-sm leading-relaxed mb-5">{t('login.local.desc')}</p>
          <a href={localizedPath('/modulos', locale)} class="inline-flex items-center gap-2 font-mono text-sm font-medium text-white bg-emerald-500 px-5 py-2.5 rounded-xl hover:bg-emerald-600 transition-colors">
            {t('login.local.cta')}
          </a>
        </div>
      </section>
    )}

    {configured && (
      <section>
        <div id="login-form-wrapper" class="bg-white border border-slate-200 rounded-2xl p-8 shadow-sm">
          <div class="flex items-center gap-2 mb-6">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
            <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase">{t('login.form.label')}</p>
          </div>
          <form id="login-form" novalidate>
            <label for="email-input" class="block text-sm font-medium text-slate-700 mb-2">
              {t('login.form.email.label')}
            </label>
            <input
              id="email-input"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder={t('login.form.email.placeholder')}
              class="w-full font-mono text-sm border border-slate-300 rounded-xl px-4 py-3 mb-4 focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:border-transparent transition-shadow"
            />
            <p id="error-msg" class="hidden text-xs text-rose-600 font-mono mb-3 border border-rose-200 bg-rose-50 rounded-lg px-3 py-2"></p>
            <button
              type="submit"
              id="submit-btn"
              class="w-full font-mono text-sm font-medium text-white bg-emerald-500 px-5 py-3 rounded-xl hover:bg-emerald-600 transition-colors disabled:opacity-50"
              data-idle={t('login.form.submit')}
              data-busy={t('login.form.submitting')}
            >
              {t('login.form.submit')}
            </button>
          </form>
          <p class="text-center text-[11px] text-slate-400 font-mono mt-4">{t('login.form.hint')}</p>
        </div>

        <div id="success-msg" class="hidden bg-emerald-50 border border-emerald-200 rounded-2xl p-8 text-center">
          <div class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-emerald-500 mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          </div>
          <p class="font-mono text-[10px] tracking-widest text-emerald-700 uppercase mb-3">{t('login.form.success.label')}</p>
          <h2 class="text-lg font-bold text-slate-900 mb-2">{t('login.form.success.title')}</h2>
          <p class="text-slate-600 text-sm leading-relaxed">{t('login.form.success.desc')}</p>
        </div>
      </section>
    )}

    <p class="text-center text-[11px] text-slate-400 font-mono mt-8">{t('login.operatedby')}</p>
  </div>
</Layout>

<!-- Script unconditional so Astro/Vite bundles it correctly.
     Runtime guard handles the unconfigured case. -->
<script>
  import { supabase } from '../lib/supabase';

  (async () => {
    // If Supabase not configured or form not in DOM (pending-state shown), do nothing.
    const form = document.getElementById('login-form');
    if (!supabase || !form) return;

    const errorMsg = document.getElementById('error-msg');
    const successMsg = document.getElementById('success-msg');
    const formWrapper = document.getElementById('login-form-wrapper');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const input = (form as HTMLFormElement).querySelector('[name="email"]') as HTMLInputElement;
      const email = input?.value?.trim();
      if (!email) return;

      const idleText = submitBtn?.dataset.idle ?? submitBtn?.textContent ?? '';
      const busyText = submitBtn?.dataset.busy ?? '…';
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = busyText; }
      if (errorMsg) errorMsg.classList.add('hidden');

      // Keep the magic-link redirect in the visitor's language.
      const seg = location.pathname.split('/').filter(Boolean)[0];
      const prefix = ['en', 'th', 'fr', 'it', 'ch'].includes(seg) ? `/${seg}` : '';
      const cuentaUrl = `${location.origin}${prefix}/cuenta/`;

      // Carry referral attribution at sign-up time (user_metadata), so a referred
      // user is credited even if they never reach /cuenta. Supabase only applies this
      // data on first account creation (ignored for existing users), so it can't
      // overwrite an established attribution.
      let referredBy = '';
      try { referredBy = (localStorage.getItem('moonkey_ref') || '').toUpperCase(); } catch (e) {}

      const { error } = await supabase.auth.signInWithOtp({
        email,
        options: {
          emailRedirectTo: cuentaUrl,
          ...(referredBy ? { data: { referred_by: referredBy, referred_at: new Date().toISOString() } } : {}),
        },
      });

      if (error) {
        if (errorMsg) {
          errorMsg.textContent = error.message;
          errorMsg.classList.remove('hidden');
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = idleText;
        }
        console.error('[login] signInWithOtp error:', error.message);
      } else {
        formWrapper?.classList.add('hidden');
        successMsg?.classList.remove('hidden');
      }
    });
  })();
</script>
