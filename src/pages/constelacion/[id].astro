---
import Layout from '../../components/Layout.astro';
import { resolveLocale, localizedPath } from '../../i18n/utils';
import { constellations, THEME, localizeConstellation, localizePower } from '../../data/galaxy';
import { lessonCount } from '../../data/galaxy.curriculum';
import { getLocalizedLesson } from '../../data/galaxy.curriculum.i18n';

export function getStaticPaths() {
  return constellations.map((c) => ({ params: { id: c.id }, props: { c } }));
}

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const c = localizeConstellation(Astro.props.c, locale);
const th = THEME[c.theme];
const idx = constellations.findIndex((x) => x.id === c.id);
const next = localizeConstellation(constellations[(idx + 1) % constellations.length], locale);
const live = c.modules.filter((m) => m.status === 'live').length;
const withLesson = lessonCount(c.id);

// ── Page chrome strings (lesson bodies are ES canonical; labels localize) ──
const CX: Record<string, Record<string, string>> = {
  es: { back: 'La galaxia', constellation: 'CONSTELACIÓN', core: 'NÚCLEO', orbit1: 'ÓRBITA I', orbit2: 'ÓRBITA II', powers: 'Alimenta', modules: 'módulos', live: 'en vivo', forming: 'en formación', modulesTitle: 'MÓDULOS DE LA CONSTELACIÓN', lessonBadge: 'lección', objetivo: 'OBJETIVO', porque: 'POR QUÉ IMPORTA', leccion: 'LA LECCIÓN', ejercicio: 'EJERCICIO', entregable: 'ENTREGABLE', insight: 'INSIGHT CLAVE', errores: 'ERRORES A EVITAR', expandHint: 'Abre cada módulo para la clase completa', next: 'Siguiente constelación', open: 'Abrir lección →' },
  en: { back: 'The galaxy', constellation: 'CONSTELLATION', core: 'CORE', orbit1: 'ORBIT I', orbit2: 'ORBIT II', powers: 'Powers', modules: 'modules', live: 'live', forming: 'forming', modulesTitle: 'CONSTELLATION MODULES', lessonBadge: 'lesson', objetivo: 'OBJECTIVE', porque: 'WHY IT MATTERS', leccion: 'THE LESSON', ejercicio: 'EXERCISE', entregable: 'DELIVERABLE', insight: 'KEY INSIGHT', errores: 'MISTAKES TO AVOID', expandHint: 'Open each module for the full class', next: 'Next constellation', open: 'Open lesson →' },
  th: { back: 'กาแล็กซี', constellation: 'กลุ่มดาว', core: 'แกนกลาง', orbit1: 'วงโคจร I', orbit2: 'วงโคจร II', powers: 'ขับเคลื่อน', modules: 'โมดูล', live: 'พร้อมใช้', forming: 'กำลังจัดทำ', modulesTitle: 'โมดูลของกลุ่มดาว', lessonBadge: 'บทเรียน', objetivo: 'วัตถุประสงค์', porque: 'ทำไมจึงสำคัญ', leccion: 'บทเรียน', ejercicio: 'แบบฝึกหัด', entregable: 'สิ่งที่ส่งมอบ', insight: 'ข้อคิดสำคัญ', errores: 'ข้อผิดพลาดที่ควรเลี่ยง', expandHint: 'เปิดแต่ละโมดูลเพื่อดูบทเรียนเต็ม', next: 'กลุ่มดาวถัดไป', open: 'เปิดบทเรียน →' },
  fr: { back: 'La galaxie', constellation: 'CONSTELLATION', core: 'NOYAU', orbit1: 'ORBITE I', orbit2: 'ORBITE II', powers: 'Alimente', modules: 'modules', live: 'en ligne', forming: 'en préparation', modulesTitle: 'MODULES DE LA CONSTELLATION', lessonBadge: 'leçon', objetivo: 'OBJECTIF', porque: 'POURQUOI C\'EST IMPORTANT', leccion: 'LA LEÇON', ejercicio: 'EXERCICE', entregable: 'LIVRABLE', insight: 'CLÉ ESSENTIELLE', errores: 'ERREURS À ÉVITER', expandHint: 'Ouvre chaque module pour le cours complet', next: 'Constellation suivante', open: 'Ouvrir la leçon →' },
  it: { back: 'La galassia', constellation: 'COSTELLAZIONE', core: 'NUCLEO', orbit1: 'ORBITA I', orbit2: 'ORBITA II', powers: 'Alimenta', modules: 'moduli', live: 'attivi', forming: 'in preparazione', modulesTitle: 'MODULI DELLA COSTELLAZIONE', lessonBadge: 'lezione', objetivo: 'OBIETTIVO', porque: 'PERCHÉ CONTA', leccion: 'LA LEZIONE', ejercicio: 'ESERCIZIO', entregable: 'CONSEGNA', insight: 'INTUIZIONE CHIAVE', errores: 'ERRORI DA EVITARE', expandHint: 'Apri ogni modulo per la lezione completa', next: 'Costellazione successiva', open: 'Apri la lezione →' },
  ch: { back: 'Die Galaxie', constellation: 'KONSTELLATION', core: 'KERN', orbit1: 'ORBIT I', orbit2: 'ORBIT II', powers: 'Versorgt', modules: 'Module', live: 'live', forming: 'in Arbeit', modulesTitle: 'MODULE DER KONSTELLATION', lessonBadge: 'Lektion', objetivo: 'ZIEL', porque: 'WARUM ES ZÄHLT', leccion: 'DIE LEKTION', ejercicio: 'ÜBUNG', entregable: 'ERGEBNIS', insight: 'KERNEINSICHT', errores: 'ZU VERMEIDENDE FEHLER', expandHint: 'Öffne jedes Modul für die ganze Lektion', next: 'Nächste Konstellation', open: 'Lektion öffnen →' },
};
const X = CX[locale] ?? CX.es;
const orbitLabel = c.orbit === 0 ? X.core : c.orbit === 1 ? X.orbit1 : X.orbit2;
const lessonsWord: string = ({ es: 'lecciones', en: 'lessons', th: 'บทเรียน', fr: 'leçons', it: 'lezioni', ch: 'Lektionen' } as Record<string, string>)[locale] ?? 'lecciones';
---

<Layout title={c.name} description={c.mission}>

  <!-- Back to galaxy -->
  <a href={localizedPath('/galaxia', locale)} class="inline-flex items-center gap-2 font-mono text-xs text-slate-400 hover:text-slate-700 transition-colors mb-8">
    <span aria-hidden="true">←</span> {X.back}
  </a>

  <!-- Hero -->
  <section class="pb-10 border-b border-slate-200 hero-enter">
    <div class="flex items-center gap-3 mb-4">
      <span class="w-3 h-3 rounded-full" style={`background:${th.dot};box-shadow:0 0 16px ${th.glow}`}></span>
      <span class="font-mono text-[10px] tracking-widest uppercase text-slate-400">{orbitLabel} · {X.constellation}</span>
    </div>
    <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 leading-tight mb-2">{c.name}</h1>
    <p class={`font-mono text-sm ${th.text} mb-5`}>{c.tagline}</p>
    <p class="text-slate-600 text-base leading-relaxed max-w-2xl mb-6">{c.mission}</p>

    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
      <div class="flex flex-wrap gap-1.5">
        <span class="font-mono text-[10px] tracking-widest uppercase text-slate-400 mr-1 self-center">{X.powers}</span>
        {c.powers.map((p) => (
          <span class={`font-mono text-[10px] px-2 py-0.5 rounded-full border ${th.chip}`}>{localizePower(p, locale)}</span>
        ))}
      </div>
      <span class="font-mono text-[11px] text-slate-400">
        {c.modules.length} {X.modules}{withLesson > 0 ? ` · ${withLesson} ${lessonsWord}` : live > 0 ? ` · ${live} ${X.live}` : ` · ${X.forming}`}
      </span>
    </div>
  </section>

  <!-- Modules -->
  <section class="py-10">
    <div class="flex items-baseline justify-between mb-6 gap-4 flex-wrap">
      <span class="label">{X.modulesTitle}</span>
      {withLesson > 0 && <span class="font-mono text-[11px] text-slate-400">{X.expandHint}</span>}
    </div>
    <div class="space-y-3">
      {c.modules.map((m, i) => {
        const lesson = getLocalizedLesson(c.id, m.code, locale);
        const isLive = m.status === 'live';

        if (lesson) {
          // Full master lesson — expandable
          return (
            <details class={`group bg-white border ${th.border} rounded-2xl shadow-sm overflow-hidden`} data-reveal data-delay={i * 40}>
              <summary class="flex items-start gap-4 p-5 cursor-pointer list-none select-none hover:bg-slate-50/60 transition-colors">
                <span class={`font-mono text-xs font-bold shrink-0 mt-0.5 ${th.text}`}>{m.code}</span>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap mb-1">
                    <h3 class="font-semibold text-sm text-slate-900">{m.title}</h3>
                    <span class={`font-mono text-[9px] tracking-widest uppercase px-2 py-0.5 rounded-full border ${th.chip}`}>{X.lessonBadge}</span>
                  </div>
                  <p class="text-xs leading-relaxed text-slate-500">{lesson.objetivo}</p>
                </div>
                <span class={`font-mono text-xs shrink-0 mt-0.5 ${th.text} transition-transform group-open:rotate-90`} aria-hidden="true">→</span>
              </summary>

              <div class="accordion-body px-5 pb-6 pt-1 sm:pl-12">
                <p class="text-slate-600 text-sm leading-relaxed mb-5 italic">{lesson.porque}</p>

                <p class={`font-mono text-[10px] tracking-widest uppercase ${th.text} mb-2`}>{X.leccion}</p>
                <div class="space-y-3 mb-6">
                  {lesson.leccion.map((para) => (
                    <p class="text-slate-700 text-sm leading-relaxed">{para}</p>
                  ))}
                </div>

                <div class="grid sm:grid-cols-2 gap-3 mb-5">
                  <div class={`rounded-xl p-4 ${th.bgSoft} border ${th.border}`}>
                    <p class={`font-mono text-[10px] tracking-widest uppercase ${th.text} mb-1.5`}>{X.ejercicio}</p>
                    <p class="text-slate-700 text-xs leading-relaxed">{lesson.ejercicio}</p>
                  </div>
                  <div class="rounded-xl p-4 bg-slate-900">
                    <p class="font-mono text-[10px] tracking-widest uppercase text-emerald-400 mb-1.5">{X.entregable}</p>
                    <p class="text-slate-200 text-xs leading-relaxed font-mono">{lesson.entregable}</p>
                  </div>
                </div>

                <div class={`border-l-4 ${th.border} pl-4 mb-5`}>
                  <p class={`font-mono text-[10px] tracking-widest uppercase ${th.text} mb-1`}>{X.insight}</p>
                  <p class="text-slate-700 text-sm leading-relaxed">{lesson.insight}</p>
                </div>

                {lesson.errores?.length > 0 && (
                  <div>
                    <p class="font-mono text-[10px] tracking-widest uppercase text-rose-400 mb-2">{X.errores}</p>
                    <ul class="space-y-1.5">
                      {lesson.errores.map((e) => (
                        <li class="flex items-start gap-2 text-xs text-slate-500 leading-relaxed">
                          <span class="text-rose-300 font-mono shrink-0 mt-0.5">×</span>{e}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {isLive && m.href && (
                  <a href={localizedPath(m.href, locale)} class={`inline-block mt-5 font-mono text-xs font-medium ${th.text} border ${th.border} px-4 py-2 rounded-lg hover:bg-slate-50 transition-colors`}>
                    {X.open}
                  </a>
                )}
              </div>
            </details>
          );
        }

        // No lesson yet — compact card (live links to its page; forming is dashed)
        const inner = (
          <div class={`flex items-start gap-4 rounded-2xl p-5 border transition-all ${
            isLive ? `bg-white ${th.border} card-hover shadow-sm` : 'bg-slate-50/60 border-slate-200 border-dashed'
          }`} data-reveal data-delay={i * 40}>
            <span class={`font-mono text-xs font-bold shrink-0 mt-0.5 ${isLive ? th.text : 'text-slate-300'}`}>{m.code}</span>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap mb-1">
                <h3 class={`font-semibold text-sm ${isLive ? 'text-slate-900' : 'text-slate-500'}`}>{m.title}</h3>
                {isLive
                  ? <span class={`font-mono text-[9px] tracking-widest uppercase px-2 py-0.5 rounded-full border ${th.chip}`}>{X.live}</span>
                  : <span class="font-mono text-[9px] tracking-widest uppercase px-2 py-0.5 rounded-full border border-slate-200 text-slate-400">{X.forming}</span>
                }
              </div>
              <p class={`text-xs leading-relaxed ${isLive ? 'text-slate-500' : 'text-slate-400'}`}>{m.blurb}</p>
            </div>
            {isLive && <span class={`font-mono text-xs shrink-0 mt-0.5 ${th.text}`} aria-hidden="true">→</span>}
          </div>
        );
        return isLive && m.href
          ? <a href={localizedPath(m.href, locale)} class="block group">{inner}</a>
          : <div>{inner}</div>;
      })}
    </div>
  </section>

  <!-- Next constellation -->
  <section class="py-8 border-t border-slate-200">
    <a href={localizedPath(`/constelacion/${next.id}`, locale)} class="group flex items-center justify-between gap-4 rounded-2xl bg-white border border-slate-200 p-5 hover:shadow-sm transition-shadow">
      <div>
        <p class="font-mono text-[10px] tracking-widest uppercase text-slate-400 mb-1">{X.next}</p>
        <p class="font-display text-lg font-bold text-slate-900">{next.name}</p>
        <p class={`font-mono text-xs ${THEME[next.theme].text}`}>{next.tagline}</p>
      </div>
      <span class="font-mono text-slate-300 group-hover:text-slate-600 transition-colors" aria-hidden="true">→</span>
    </a>
  </section>
</Layout>
