---
import Layout from '../components/Layout.astro';
import { terminos } from '../data/glosario';

// Rotating accent palette; indexed modulo length so it never runs short
// regardless of how many terms exist.
const accentPalette = [
  'text-emerald-700', 'text-sky-700', 'text-violet-700', 'text-amber-700', 'text-rose-700',
  'text-teal-700', 'text-orange-700', 'text-indigo-700',
];
---

<Layout title="Glosario" description={`Los ${terminos.length} términos esenciales para cualquier operador IA.`}>

  <div class="pb-12 border-b border-slate-200">
    <span class="label block mb-6">MÓDULO 03</span>
    <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 leading-tight mb-4">Glosario</h1>
    <p class="text-slate-600 text-base leading-relaxed max-w-lg">
      Los {terminos.length} términos que cualquier operador IA necesita entender antes de empezar. Definiciones directas, sin academicismos.
    </p>
  </div>

  <div class="py-12">
    <dl class="space-y-0">
      {terminos.map((t, i) => (
        <div class="flex gap-0 border-b border-slate-100 py-5">
          <div class="w-8 shrink-0 pt-0.5">
            <span class="text-slate-300 font-mono text-xs">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <div class="flex-1 min-w-0">
            <dt class={`font-mono text-sm font-bold mb-1.5 ${accentPalette[i % accentPalette.length]}`}>{t.term}</dt>
            <dd class="text-slate-500 text-sm leading-relaxed">{t.def}</dd>
          </div>
        </div>
      ))}
    </dl>
  </div>

</Layout>
